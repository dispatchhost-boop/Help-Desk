                                                <script>
                                                    (function () {
                                                        const dropdownToggle = document.getElementById('orderDropdownToggle');
                                                        const dropdownMenu = document.getElementById('orderDropdownMenu');
                                                        const dropdownSelected = document.getElementById('orderDropdownSelected');
                                                        const dropdown = document.getElementById('orderDropdown');
                                                        const resetBtn = document.getElementById('orderDropdownResetBtn');

                                                        // Helper to close dropdown if clicked outside
                                                        function closeDropdown(e) {
                                                            if (!dropdown.contains(e.target)) {
                                                                dropdownMenu.style.display = 'none';
                                                            }
                                                        }

                                                        // Toggle dropdown menu
                                                        dropdownToggle.addEventListener('click', function (e) {
                                                            e.stopPropagation();
                                                            dropdownMenu.style.display = dropdownMenu.style.display === 'block' ? 'none' : 'block';
                                                        });

                                                        // Dropdown item click
                                                        dropdownMenu.querySelectorAll('.dropdown-item').forEach(function (item) {
                                                            item.addEventListener('click', function () {
                                                                dropdownSelected.textContent = item.querySelector('span').textContent;
                                                                dropdownSelected.setAttribute('data-value', item.getAttribute('data-value'));
                                                                dropdownMenu.style.display = 'none';
                                                            });
                                                        });

                                                        // Reset button
                                                        resetBtn.addEventListener('click', function () {
                                                            dropdownSelected.textContent = 'Total Orders';
                                                            dropdownSelected.setAttribute('data-value', 'Total Orders');
                                                        });

                                                        // Close dropdown on outside click
                                                        document.addEventListener('click', closeDropdown);
                                                    })();
                                                </script>

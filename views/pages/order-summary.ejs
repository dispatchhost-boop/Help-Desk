<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const res = await axios.get('/api/dashboard');
    const data = res.data;

    // === BUSINESS INSIGHTS ===
    const insight = data.businessInsightObj;
    document.querySelectorAll('.dashboard-card .card-metric').forEach(cardMetric => {
      const label = cardMetric.querySelector('.metric-label')?.textContent.trim();
      const valueEl = cardMetric.querySelector('.metric-value');
      const changeEl = cardMetric.querySelector('.metric-change');

      if (!label || !valueEl || !changeEl) return;

      if (label.includes('Average Daily Orders')) {
        valueEl.textContent = insight.currentAvgOrders.toFixed(2);
        changeEl.textContent = `${insight.orderChangePct >= 0 ? '▲' : '▼'} ${Math.abs(insight.orderChangePct).toFixed(2)} %`;
      }

      if (label.includes('Average Order Value')) {
        valueEl.textContent = '₹' + insight.currentAvgValue.toFixed(2);
        changeEl.textContent = `${insight.valueChangePct >= 0 ? '▲' : '▼'} ${Math.abs(insight.valueChangePct).toFixed(2)} %`;
      }
    });

    // === TODAY'S ORDERS & VALUE ===
    const { todayOrders, weekOrders, monthOrders, quarterOrders } = data.orderJsonResponse;
    const { todayValue, weekValue, monthValue, quarterValue } = data.valueJsonResponse;

    const todayOrdersCard = document.querySelectorAll('.dashboard-card')[1];
    todayOrdersCard.querySelector('.metric-value').textContent = todayOrders.count;
    todayOrdersCard.querySelector('.metric-change').textContent = `${todayOrders.change >= 0 ? '▲' : '▼'} ${Math.abs(todayOrders.percentage || 0)} %`;

    const statItems = todayOrdersCard.querySelectorAll('.stat-item');
    statItems[0].querySelector('.stat-value').textContent = weekOrders.count;
    statItems[0].querySelector('.stat-change').textContent = `${weekOrders.change >= 0 ? '▲' : '▼'} ${Math.abs(weekOrders.percentage || 0)} %`;
    statItems[1].querySelector('.stat-value').textContent = monthOrders.count;
    statItems[1].querySelector('.stat-change').textContent = `${monthOrders.change >= 0 ? '▲' : '▼'} ${Math.abs(monthOrders.percentage || 0)} %`;
    statItems[2].querySelector('.stat-value').textContent = quarterOrders.count;
    statItems[2].querySelector('.stat-change').textContent = `${quarterOrders.change >= 0 ? '▲' : '▼'} ${Math.abs(quarterOrders.percentage || 0)} %`;

    const todayValueCard = document.querySelectorAll('.dashboard-card')[2];
    todayValueCard.querySelector('.metric-value').textContent = '₹' + todayValue.value.toFixed(2);

    const valStats = todayValueCard.querySelectorAll('.stat-item');
    valStats[0].querySelector('.stat-value').textContent = '₹' + weekValue.value.toFixed(2);
    valStats[0].querySelector('.stat-change').textContent = `${weekValue.change >= 0 ? '▲' : '▼'} ${Math.abs(weekValue.percentage || 0)} %`;
    valStats[1].querySelector('.stat-value').textContent = '₹' + monthValue.value.toFixed(2);
    valStats[1].querySelector('.stat-change').textContent = `${monthValue.change >= 0 ? '▲' : '▼'} ${Math.abs(monthValue.percentage || 0)} %`;
    valStats[2].querySelector('.stat-value').textContent = '₹' + quarterValue.value.toFixed(2);
    valStats[2].querySelector('.stat-change').textContent = `${quarterValue.change >= 0 ? '▲' : '▼'} ${Math.abs(quarterValue.percentage || 0)} %`;

    // === PAYMENT MODE SPLIT ===
    const codSpan = document.querySelector('.dashboard-card:nth-of-type(4) .chart-legend .legend-item:nth-child(1) span');
    const prepaidSpan = document.querySelector('.dashboard-card:nth-of-type(4) .chart-legend .legend-item:nth-child(2) span');

    let codCount = 0, prepaidCount = 0;
    data.orderSplitByPaymentMode.forEach(pm => {
      if (pm.payment_mode === 'cod') codCount = pm.total;
      if (pm.payment_mode === 'prepaid') prepaidCount = pm.total;
    });
    codSpan.textContent = `COD (${codCount})`;
    prepaidSpan.textContent = `Prepaid (${prepaidCount})`;

    // === SHIPPING MODE SPLIT ===
    const airSpan = document.querySelector('.dashboard-card:nth-of-type(5) .chart-legend .legend-item:nth-child(1) span');
    const surfaceSpan = document.querySelector('.dashboard-card:nth-of-type(5) .chart-legend .legend-item:nth-child(2) span');
    let air = 0, surface = 0;
    data.shipmentSplitByShippingMode.forEach(sm => {
      if (sm.shipping_mode === 'Air') air = sm.total;
      if (sm.shipping_mode === 'Surface') surface = sm.total;
    });
    airSpan.textContent = `Air (${air})`;
    surfaceSpan.textContent = `Surface (${surface})`;

    // === SHIPMENT COURIER SPLIT ===
    const courierCard = document.querySelector('.dashboard-card:nth-of-type(6)');
    if (data.shipmentSplitByCourier.length > 0) {
      courierCard.querySelector('.card-empty').innerHTML = data.shipmentSplitByCourier.map(c =>
        `<div class="legend-item"><div class="legend-color" style="background-color: #60a5fa;"></div><span>${c.courier_name} (${c.total})</span></div>`
      ).join('');
    }

    // === SHIPMENT SPLIT BY WEIGHT ===
    const weightMap = {
      "0-0.5kg": 0, "0.5-1kg": 1, "1-2kg": 2, "2-5kg": 3, "5-10kg": 4, ">10kg": 5
    };
    const weightCard = document.querySelector('.dashboard-card:nth-of-type(7) .chart-legend-grid');
    data.ShipmentSplitByWeight.forEach(w => {
      const idx = weightMap[w.weight_bucket] ?? -1;
      if (idx >= 0) {
        const el = weightCard.children[idx].querySelector('span');
        el.textContent = `${w.weight_bucket} (${w.total})`;
      }
    });
 const topStatesCard = document.querySelector('.dashboard-card:nth-of-type(8)');
    
    // === TOP STATES SPLIT ===
    if (data.OrderSplitAcrossTopStates.length > 0) {
      topStatesCard.querySelector('.card-empty').innerHTML = data.OrderSplitAcrossTopStates.map(st =>
        `<div class="legend-item"><div class="legend-color" style="background-color: #60a5fa;"></div><span>${st.state} (${st.total_orders})</span></div>`
      ).join('');
    }

// === DELIVERY PERFORMANCE ===
const delivery = data.DeliveryPerformance[0] || {};
const deliveryCard = document.querySelector('.dashboard-card:has(.card-header span:contains("Delivery Performance")) .chart-legend');

if (deliveryCard) {
  const legends = deliveryCard.querySelectorAll('.legend-item');

  legends.forEach(legend => {
    const label = legend.querySelector('span')?.textContent.toLowerCase();

    if (label.includes('on-time')) {
      legend.querySelector('span').textContent = `On-time Deliveries (${delivery.on_time || 0})`;
    } else if (label.includes('delay')) {
      legend.querySelector('span').textContent = `Delayed Deliveries (${delivery.delay || 0})`;
    } else if (label.includes('rto')) {
      legend.querySelector('span').textContent = `RTO (${delivery.rto || 0})`;
    }
  });
}

  } catch (err) {
    console.error('Error fetching dashboard data:', err);
  }
});
</script>

</body>
</html>
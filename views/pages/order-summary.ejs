<!DOCTYPE html>
<html lang="hi">

<head>
    <%- include('../partials/head') %>

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
        <!-- Styling -->
        <style>
            #reportrange {
                background-color: #c7dcfb;
                cursor: pointer;
                padding: 8px 12px;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 500;
                color: #5c6c7d;
                display: inline-flex;
                align-items: center;
                gap: 10px;
                box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
                border: 1px solid #ccc;
            }

            #reportrange:hover {
                background: rgba(128, 128, 128, 0.088);
            }

            .dropdown:hover .dropdown-menu {
                display: block;
            }

            .dropdown-menu .dropdown-item {
                padding: 8px 12px;
                cursor: pointer;
            }

            .dropdown-menu .dropdown-item:hover {
                background: #f3f4f6;
            }
        </style>
        <style>
            /* Common Dashboard Styles */
            .dashboard-container {
                padding: 1rem;
                max-width: 1400px;
                margin: 0 auto;
            }

            @media (min-width: 600px) {
                .dashboard-container {
                    padding: 2rem;
                }
            }

            .dashboard-header h2 {
                font-size: 2rem;
                font-weight: 700;
                color: #22223b;
                margin-bottom: 0.5rem;
            }

            .breadcrumb {
                display: flex;
                flex-wrap: wrap;
                list-style: none;
                padding: 0;
                margin: 0.5rem 0 1.5rem 0;
                font-size: 0.95rem;
            }

            .breadcrumb-item {
                display: flex;
                align-items: center;
                color: #6b7280;
            }

            .breadcrumb-item.active {
                color: #22223b;
                font-weight: 600;
            }

            .breadcrumb-item:not(:last-child)::after {
                content: '/';
                margin: 0 0.5rem;
                color: #bdbdbd;
            }

            .dashboard-tabs {
                margin-bottom: 1.5rem;
                width: fit-content;
            }

            .tab-menu {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                background-color: #d3d3d3;
                border-radius: 8px;
            }

            .tab-item {
                padding: 0.5rem 1.25rem;
                font-weight: 500;
                color: #3E1A51;
                background: transparent;
                border: none;
                border-radius: 0.5rem 0.5rem 0 0;
                cursor: pointer;
                transition: background 0.2s;
                white-space: nowrap;
            }

            .tab-item.active {
                background: #fff;
                border-bottom: 2px solid #007eff;
                color: #000;
                list-style: none;
            }

            .tab-content1 {
                display: none;
            }

            .tab-content1.active {
                display: block;
            }

            .dashboard-controls {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 1.5rem;
                gap: 1rem;
            }

            .controls-left {
                display: flex;
                gap: 0.75rem;
                align-items: center;
            }

            .dropdown-toggle {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0.4rem 1rem;
                cursor: pointer;
            }

            .dropdown-label {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                color: #4b5563;
                font-size: 1rem;
            }

            .reset-btn {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                background: #fff;
                border: 1.5px solid #d1d5db;
                border-radius: 0.5rem;
                padding: 0.45rem 1.1rem;
                font-weight: 600;
                color: #3E1A51;
                cursor: pointer;
                transition: background 0.2s, border 0.2s;
            }

            .reset-btn:hover {
                background: #f3e8ff;
                border-color: #d28dff;
            }

            .last-updated {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.95rem;
                color: #6b7280;
            }

            .dashboard-cards {
                display: grid;
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            @media (min-width: 700px) {
                .dashboard-cards {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @media (min-width: 1100px) {
                .dashboard-cards {
                    grid-template-columns: repeat(3, 1fr);
                }
            }

            .dashboard-card {
                background: #fff;
                border-radius: 1rem;
                padding: 1.5rem 1.2rem;
                box-shadow: 0 0.25rem 1rem rgba(195, 180, 209, 0.18);
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            .card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding-bottom: 1rem;
                border-bottom: 1px solid #e5e7eb;
                margin-bottom: 0.5rem;
            }

            .card-header span:first-child {
                font-weight: 600;
                color: #3E1A51;
                font-size: 12px;
            }

            .card-header span:last-child {
                font-size: 0.95rem;
                color: #52525b;
            }

            .card-metric {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                margin-bottom: 1rem;
                gap: 1rem;
            }

            .metric-left {
                display: flex;
                align-items: flex-end;
                gap: 0.7rem;
            }

            .metric-icon {
                padding: 0.7rem 1rem;
                border-radius: 0.5rem;
                background: #e8edff;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .metric-value {
                font-size: 1.5rem;
                font-weight: 700;
                color: #22223b;
                margin-bottom: 0.15rem;
            }

            .metric-label {
                font-size: 12px;
                color: #374151;
                margin-bottom: 0;
            }

            .metric-right {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                gap: 0.1rem;
            }

            .metric-change {
                font-size: 0.95rem;
                font-weight: 600;
                color: #6b7280;
            }

            .metric-compare {
                font-size: 0.85rem;
                color: #9ca3af;
            }

            .divider {
                margin: 1rem 0;
                border-top: 1px dashed #d1d5db;
            }

            .card-stats {
                display: flex;
                flex-direction: column;
                gap: 1.1rem;
            }

            .stat-item {
                display: flex;
                justify-content: space-between;
                font-size: 12px;
                gap: 1rem;
            }

            .stat-value {
                min-width: 60px;
                font-weight: 600;
                color: #3E1A51;
                text-align: right;
            }

            .stat-change {
                min-width: 60px;
                font-size: 0.85rem;
                font-weight: 600;
                color: #6b7280;
                text-align: right;
            }

            .card-chart {
                min-height: 180px;
                height: 220px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }

            .chart-icon {
                font-size: 2.5rem;
                margin-bottom: 1rem;
            }

            .chart-legend,
            .chart-legend-vertical,
            .chart-legend-grid {
                width: 100%;
                padding: 12px;
            }

            .chart-legend {
                display: flex;
                justify-content: space-between;
                gap: 1rem;
            }

            .chart-legend-vertical {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
            }

            .chart-legend-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 0.5rem;
                font-size: 12px;
            }

            .legend-item {
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .legend-color {
                width: 14px;
                height: 14px;
                border-radius: 50%;
            }

            .card-empty {
                min-height: 120px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .card-empty p {
                font-size: 1rem;
                font-weight: 600;
                color: #717171;
            }

            .card-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 0.7rem;
            }

            @media (max-width: 600px) {
                .card-grid {
                    grid-template-columns: 1fr;
                }
            }

            .grid-item {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                padding: 1rem;
                border: 1px solid #e5e7eb;
                border-radius: 0.5rem;
                background: #faf9fb;
                min-width: 0;
            }

            .grid-icon {
                color: #3E1A51;
                font-size: 1.3rem;
                margin-bottom: 0.7rem;
            }

            .grid-value {
                font-size: 1.2rem;
                font-weight: 700;
                color: #22223b;
                margin-bottom: 0.2rem;
            }

            .grid-label {
                font-size: 12px;
                color: #6b7280;
                margin-bottom: 0;
            }

            .invisible {
                visibility: hidden;
            }

            @media (max-width: 900px) {
                .dashboard-cards {
                    grid-template-columns: 1fr 1fr;
                }
            }

            @media (max-width: 700px) {
                .dashboard-cards {
                    grid-template-columns: 1fr;
                }
            }

            @media (max-width: 500px) {
                .dashboard-container {
                    padding: 0.5rem;
                }

                .dashboard-card {
                    padding: 1rem 0.5rem;
                }

                .card-header {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 0.3rem;
                }
            }

            /* Orders Tab Specific Styles */
            .date-range {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                background-color: #f1f5f9;
                border: 1px solid #ccc;
                min-width: 220px;
                border-radius: 6px;
                padding: 8px 12px;
            }

            .date-range div {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .text-secondary {
                color: #6b7280;
            }

            .text-primary {
                color: #3E1A51;
                cursor: pointer;
            }

            /* Order Summary Card Styles */
            .summary-card {
                border-radius: 16px;
                background: #fff;
                padding: 24px;
                box-shadow: 0 4px 16px rgba(195, 180, 209, 0.18);
                margin-top: 24px;
            }

            .summary-card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding-bottom: 16px;
            }

            .summary-card-title {
                font-size: 16px;
                font-weight: 600;
                color: #000;
            }

            .summary-card-subtitle {
                font-size: 14px;
                color: #52525B;
            }

            .summary-card-content {
                display: flex;
                flex-direction: column;
                gap: 16px;
            }

            .summary-card-row {
                display: flex;
                gap: 24px;
            }

            .summary-card-item {
                flex: 1;
                border: 1px solid #F3F3F4;
                padding: 16px;
                border-radius: 8px;
                background: #fff;
            }

            .summary-card-item-content {
                display: flex;
                align-items: flex-start;
                gap: 12px;
            }

            .summary-card-icon {
                min-width: 56px;
                min-height: 57px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .summary-card-metric {
                display: flex;
                align-items: flex-end;
                margin-top: 5px;
                gap: 8px;
            }

            .summary-card-value {
                font-size: 20px;
                font-weight: 700;
                color: #000;
            }

            .summary-card-percentage {
                font-size: 14px;
            }

            .summary-card-label {
                margin-top: 4px;
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .summary-card-label-text {
                font-weight: 600;
                color: #000;
                max-width: 130px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .summary-card-info {
                cursor: pointer;
            }

            /* Chart Card Styles */
            .chart-card {
                border-radius: 16px;
                background: #fff;
                padding: 24px;
                box-shadow: 0 4px 16px rgba(195, 180, 209, 0.18);
                flex: 1 1 30%;
                min-width: 300px;
            }

            .chart-card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding-bottom: 16px;
            }

            .chart-card-title {
                font-size: 16px;
                font-weight: 600;
                color: #000;
            }

            .chart-card-subtitle {
                font-size: 14px;
                color: #52525B;
            }

            .chart-card-content {
                margin-top: 12px;
            }

            .chart-radio-group {
                display: flex;
                flex-direction: column;
                gap: 12px;
                margin-top: 12px;
            }

            .chart-radio-label {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 15px;
            }

            .chart-radio-input {
                accent-color: #7c3aed;
            }

            /* Table Card Styles */
            .table-card {
                border-radius: 16px;
                background: #fff;
                padding: 24px 0 0 0;
                box-shadow: 0 4px 16px rgba(195, 180, 209, 0.18);
                flex: 1 1 35%;
                min-width: 340px;
                overflow: hidden;
                height: 100%;
            }

            .table-card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding-bottom: 16px;
                padding-left: 24px;
                padding-right: 24px;
                margin-bottom: 4px;
            }

            .table-card-title {
                font-size: 16px;
                font-weight: 600;
                color: #000;
            }

            .table-card-subtitle {
                font-size: 14px;
                color: #52525B;
            }

            .table-card-button {
                display: flex;
                align-items: center;
                height: 32px;
                gap: 6px;
                background: #F3F3F4;
                color: #1C1C1C;
                border: 1px solid #F3F3F4;
                border-radius: 4px;
                box-shadow: 0 2px 4px 0 rgba(133, 146, 163, 0.15);
                font-size: 12px;
                cursor: pointer;
                padding: 0 12px;
            }

            .table-container {
                width: 100%;
            }

            .data-table {
                border-radius: 10px;
                border: 1px solid #c8c8c8;
                box-shadow: 0 2px 6px 0 rgba(67, 89, 113, 0.12);
                overflow: auto;
                width: 100%;
                border-collapse: collapse;
            }

            .data-table thead {
                background: #fff;
                color: #5a5a5a;
                font-size: 12px;
                text-transform: uppercase;
                box-shadow: 0 .0125rem #ccc;
            }

            .data-table th {
                padding: 10px;
                font-weight: 500;
            }

            .data-table td {
                padding: 10px;
            }

            .no-data-container {
                text-align: center;
                height: 200px;
                position: relative;
            }

            .no-data-content {
                width: 100%;
                height: 80%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                position: absolute;
                left: 50%;
                top: 50%;
                transform: translate(-50%, -50%);
            }

            .no-data-text {
                font-size: 18px;
                margin-top: 16px;
            }

            /* Shipments Tab Specific Styles */
            .shipments-controls-left {
                display: flex;
                align-items: center;
                gap: 24px;
            }

            .shipments-filters {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .shipments-dropdown {
                position: relative;
            }

            .shipments-dropdown-toggle {
                cursor: pointer;
            }

            .shipments-dropdown-label {
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .shipments-dropdown-input {
                border: none;
                background: transparent;
                outline: none;
                width: 80px;
                cursor: pointer;
            }

            .shipments-dropdown-menu {
                display: none;
                position: absolute;
                background: #fff;
                border: 1px solid #d1d5db;
                border-radius: 6px;
                min-width: 140px;
                z-index: 10;
            }

            .shipments-dropdown-item {
                padding: 0.5rem 1rem;
                cursor: pointer;
            }

            .shipments-dropdown-item:hover {
                background-color: #f3f4f6;
            }

            .shipments-reset-btn {
                display: none;
                align-items: center;
                gap: 6px;
                background: #f87171;
                color: #fff;
                padding: 6px 14px;
                border: none;
                border-radius: 6px;
                cursor: pointer;
            }

            .shipments-last-updated {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-left: auto;
            }

            /* RTO Tab Specific Styles */
            .rto-summary-card {
                border-radius: 16px;
                background: #fff;
                padding: 24px;
                box-shadow: 0 4px 16px rgba(195, 180, 209, 0.18);
                margin-top: 24px;
            }

            .rto-summary-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding-bottom: 16px;
            }

            .rto-summary-title {
                font-size: 16px;
                font-weight: 600;
                color: #000;
            }

            .rto-summary-subtitle {
                font-size: 14px;
                color: #52525B;
            }

            .rto-summary-content {
                display: flex;
                flex-direction: column;
                gap: 16px;
            }

            .rto-summary-row {
                display: flex;
                gap: 24px;
            }

            .rto-summary-item {
                flex: 1;
                border: 1px solid #F3F3F4;
                padding: 16px;
                border-radius: 8px;
                background: #fff;
            }

            .rto-summary-item-content {
                display: flex;
                align-items: flex-start;
                gap: 12px;
            }

            .rto-summary-icon {
                min-width: 56px;
                min-height: 57px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .rto-summary-metric {
                display: flex;
                align-items: flex-end;
                margin-top: 5px;
                gap: 8px;
            }

            .rto-summary-value {
                font-size: 20px;
                font-weight: 700;
                color: #000;
            }

            .rto-summary-percentage {
                font-size: 14px;
            }

            .rto-summary-label {
                margin-top: 4px;
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .rto-summary-label-text {
                font-weight: 600;
                color: #000;
                max-width: 130px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .rto-summary-info {
                cursor: pointer;
            }

            /* NDR Tab Specific Styles */
            .ndr-controls-left {
                display: flex;
                align-items: center;
                gap: 24px;
            }

            .ndr-filters {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .ndr-dropdown {
                position: relative;
            }

            .ndr-dropdown-toggle {
                cursor: pointer;
            }

            .ndr-dropdown-label {
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .ndr-dropdown-input {
                border: none;
                background: transparent;
                outline: none;
                width: 80px;
                cursor: pointer;
            }

            .ndr-dropdown-menu {
                display: none;
                position: absolute;
                background: #fff;
                border: 1px solid #d1d5db;
                border-radius: 6px;
                min-width: 140px;
                z-index: 10;
            }

            .ndr-dropdown-item {
                padding: 0.5rem 1rem;
                cursor: pointer;
            }

            .ndr-dropdown-item:hover {
                background-color: #f3f4f6;
            }

            .ndr-reset-btn {
                display: none;
                align-items: center;
                gap: 6px;
                background: #f87171;
                color: #fff;
                padding: 6px 14px;
                border: none;
                border-radius: 6px;
                cursor: pointer;
            }

            .ndr-last-updated {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-left: auto;
            }
        </style>
</head>

<body data-theme="light" class="font-nunito">
    <div id="wrapper" class="theme-cyan">
        <%- include('../partials/header') %>
            <%- include('../partials/left-sidebar') %>
                <%- include('../partials/right-iconbar') %>
                    <div id="main-content">
                        <div class="container-fluid">
                            <div class="dashboard-container">
                                <div class="dashboard-header">
                                    <h2>Dashboard</h2>
                                    <ul class="breadcrumb">
                                        <li class="breadcrumb-item">
                                            <a href="/"><i class="fa fa-dashboard"></i></a>
                                        </li>
                                        <li class="breadcrumb-item active">Dashboard</li>
                                    </ul>
                                </div>
                                <div class="dashboard-tabs">
                                    <ul class="tab-menu" id="tabMenu">
                                        <li class="tab-item active" data-tab="overview"><span>Overview</span></li>

                                        <li class="tab-item" data-tab="shipments"><span>Shipments</span></li>
                                        <li class="tab-item" data-tab="rto"><span>RTO</span></li>
                                        <li class="tab-item" data-tab="ndr"><span>NDR</span></li>
                                        <li class="tab-item" data-tab="cod"><span>COD</span></li>
                                    </ul>
                                </div>
                                <!-- Tab Contents -->
                                <div id="tabContents">
                                    <!-- Overview Tab -->
                                    <div class="tab-content1 active mb-4" id="tab-overview">
                                        <div class="dashboard-controls">
                                            <div class="controls-left">
                                                <div class="dropdown" id="orderDropdown" style="position: relative;">
                                                    <div class="dropdown-toggle" id="orderDropdownToggle"
                                                        style="cursor: pointer; display: flex; align-items: center;">
                                                        <div class="dropdown-label">
                                                            <i class="fas fa-list-ul"></i>
                                                            <span id="orderDropdownSelected">Total Orders</span>

                                                        </div>
                                                    </div>
                                                    <div class="dropdown-menu" id="orderDropdownMenu"
                                                        style="display: none; position: absolute; top: 100%; left: 0; z-index: 10; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; min-width: 180px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
                                                        <div class="dropdown-item" data-value="Shipped"
                                                            style="display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; cursor: pointer;">
                                                            <i class="fas fa-truck"></i>
                                                            <span>Shipped</span>
                                                        </div>
                                                        <div class="dropdown-item" data-value="Total Orders"

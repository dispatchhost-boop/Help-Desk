    <!-- SCRIPTS (Always at the bottom before </body>) -->
    <script src="/js/main.js"></script>

    <script>
        // LR Details Form Script
        document.addEventListener('DOMContentLoaded', function () {
            const manualRadio = document.getElementById('manual');
            const automaticRadio = document.getElementById('automatic');
            const lrInputWrapper = document.getElementById('lrInputWrapper');
            const lrInput = document.getElementById('lrNumberInput');
            const lrError = document.getElementById('lrError');
            const infoText = document.getElementById('infoText');
            const form = document.getElementById('lrForm');

            function updateView() {
                if (automaticRadio.checked) {
                    lrInputWrapper.style.display = 'none';
                    infoText.style.display = 'block';
                    lrInput.value = '';
                    lrError.style.display = 'none';
                } else {
                    lrInputWrapper.style.display = 'block';
                    infoText.style.display = 'none';
                }
            }

            manualRadio.addEventListener('change', updateView);
            automaticRadio.addEventListener('change', updateView);

            updateView(); // Initial setup

            form.addEventListener('submit', function (e) {
                e.preventDefault(); // Prevent default form submission
                lrError.style.display = 'none';

                if (manualRadio.checked) {
                    if (lrInput.value.trim() === '') {
                        lrError.style.display = 'block';
                        lrInput.focus();
                    } else {
                        alert('Form submitted with LR: ' + lrInput.value);
                        form.reset();
                        updateView();
                    }
                } else {
                    alert('Form submitted in Automatic mode');
                    form.reset();
                    updateView();
                }
            });
        });

        // Payment Mode Script
        document.addEventListener('DOMContentLoaded', function () {
            const prepaidRadio = document.getElementById('prepaid');
            const codRadio = document.getElementById('cod');
            const codAmountContainer = document.getElementById('cod-amount-container');
            const transporterRow = document.getElementById('transporter-id-row');

            function updateView() {
                if (codRadio.checked) {
                    codAmountContainer.style.display = 'flex';
                    transporterRow.style.display = 'none';
                } else {
                    codAmountContainer.style.display = 'none';
                    transporterRow.style.display = 'flex';
                }
            }

            prepaidRadio.addEventListener('change', updateView);
            codRadio.addEventListener('change', updateView);

            // Initialize
            updateView();
        });

        // Insurance Card Script
        document.addEventListener('DOMContentLoaded', () => {
            const card = document.getElementById('insuranceCard');
            const heading = document.getElementById('insuranceHeading');
            const ownersRisk = document.getElementById('owners-risk');
            const carriersRisk = document.getElementById('carriers-risk');

            ownersRisk.addEventListener('change', () => {
                if (ownersRisk.checked) {
                    heading.textContent = 'Insure your shipment';
                    card.style.backgroundColor = '#fff';
                    card.style.border = 'none';
                }
            });

            carriersRisk.addEventListener('change', () => {
                if (carriersRisk.checked) {
                    heading.textContent = 'Your shipment is insured!';
                    card.style.backgroundColor = '#e6f4ff';
                    card.style.border = 'none';
                }
            });
        });

        // Pickup Location Dropdown Script
        document.addEventListener('DOMContentLoaded', function () {
            const trigger = document.getElementById('pickupDropdownTrigger');
            const dropdown = document.getElementById('pickupDropdown');
            const searchInput = document.getElementById('pickupSearch');
            const pickupItems = document.querySelectorAll('.pickup-item');

            // Toggle dropdown
            trigger.addEventListener('click', () => {
                dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
            });

            // Close dropdown outside
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.address-input')) {
                    dropdown.style.display = 'none';
                }
            });

            // Filter search
            searchInput.addEventListener('input', () => {
                const query = searchInput.value.toLowerCase();
                pickupItems.forEach(item => {
                    if (!item.id.includes('addMoreBtn')) {
                        const text = item.textContent.toLowerCase();
                        item.style.display = text.includes(query) ? 'block' : 'none';
                    }
                });
            });

            // Select address
            pickupItems.forEach(item => {
                if (!item.id.includes('addMoreBtn')) {
                    item.addEventListener('click', () => {
                        // Remove previous selection
                        pickupItems.forEach(i => {
                            i.classList.remove('selected');
                            i.querySelector('.check-icon')?.style.setProperty('display', 'none');
                        });

                        // Current selection
                        item.classList.add('selected');
                        item.querySelector('.check-icon')?.style.setProperty('display', 'block');

                        // Get data
                        const title = item.dataset.title || '';
                        const address = item.dataset.address || '';
                        const phone = item.dataset.phone || '';
                        trigger.innerHTML = `
                            <div>
                                <strong>${title}</strong><br>
                                <small class="text-muted">${address}</small><br>
                                <small class="text-muted">${phone}</small>
                            </div>
                        `;
                        trigger.style.border = 'none';
                        dropdown.style.display = 'none';
                    });
                }
            });

            // Add More Click
            document.getElementById('addMoreBtn').addEventListener('click', () => {
                alert("You clicked + Add More");
            });
        });

        // Drop Location Dropdown Script
        document.addEventListener('DOMContentLoaded', function () {
            const dropTrigger = document.getElementById('dropDropdownTrigger');
            const dropDropdown = document.getElementById('dropDropdown');
            const dropSearch = document.getElementById('dropSearch');
            const dropItems = document.querySelectorAll('.drop-item');

            dropTrigger.addEventListener('click', () => {
                dropDropdown.style.display = dropDropdown.style.display === 'none' ? 'block' : 'none';
            });

            document.addEventListener('click', (e) => {
                if (!e.target.closest('.address-line')) {
                    dropDropdown.style.display = 'none';
                }
            });

            dropSearch.addEventListener('input', () => {
                const val = dropSearch.value.toLowerCase();
                dropItems.forEach(item => {
                    if (!item.id.includes('AddMore')) {
                        const text = item.textContent.toLowerCase();
                        item.style.display = text.includes(val) ? 'block' : 'none';
                    }
                });
            });

            dropItems.forEach(item => {
                if (!item.id.includes('AddMore')) {
                    item.addEventListener('click', () => {
                        dropItems.forEach(i => {
                            i.classList.remove('selected');
                            i.querySelector('.check-icon')?.style.setProperty('display', 'none');
                        });

                        item.classList.add('selected');
                        item.querySelector('.check-icon')?.style.setProperty('display', 'block');

                        // Show selected
                        const title = item.dataset.title;
                        const address = item.dataset.address;
                        const company = item.dataset.company;
                        const phone = item.dataset.phone;

                        dropTrigger.innerHTML = `
                            <div>
                                <strong>${title}</strong><br>
                                <small class="text-muted">${address}</small><br>
                                <small class="text-muted">${company}</small><br>
                                <small class="text-muted">${phone}</small>
                            </div>
                        `;
                        dropTrigger.style.border = 'none';
                        dropDropdown.style.display = 'none';
                    });
                }
            });

            document.getElementById('dropAddMoreBtn').addEventListener('click', () => {
                alert("You clicked Add More for Drop");
            });
        });

        // Basic functionality
        document.addEventListener('DOMContentLoaded', function () {
            // Update total amount when invoice amount changes
            const invoiceAmount = document.getElementById('invoice-amount');
            const totalAmount = document.getElementById('total-amount');

            invoiceAmount.addEventListener('input', function () {
                const amount = parseFloat(this.value) || 0;
                totalAmount.textContent = '₹' + amount.toFixed(2);
            });

            // Update box count
            const boxCount = document.getElementById('box-count');
            const remainingBoxes = document.getElementById('remaining-boxes');
            const totalBoxes = document.getElementById('total-boxes');

            boxCount.addEventListener('input', function () {
                const count = parseInt(this.value) || 0;
                remainingBoxes.textContent = count + ' boxes left';
                totalBoxes.textContent = count;
            });

            // File upload display
            const invoiceFile = document.getElementById('invoice-file');
            const invoiceFileName = document.getElementById('invoice-file-name');

            invoiceFile.addEventListener('change', function () {
                if (this.files.length > 0) {
                    invoiceFileName.textContent = 'Selected: ' + this.files[0].name;
                    invoiceFileName.style.display = 'block';
                } else {
                    invoiceFileName.style.display = 'none';
                }
            });

            const secondaryFile = document.getElementById('secondary-file');
            const secondaryFileName = document.getElementById('secondary-file-name');

            secondaryFile.addEventListener('change', function () {
                if (this.files.length > 0) {
                    secondaryFileName.textContent = 'Selected: ' + this.files[0].name;
                    secondaryFileName.style.display = 'block';
                } else {
                    secondaryFileName.style.display = 'none';
                }
            });

            // Add box button
            const addBoxBtn = document.getElementById('add-box-btn');
            addBoxBtn.addEventListener('click', function () {
                alert('Add box functionality would go here');
            });

            // Shipping mode selection
            const shippingOption = document.getElementById('shipping-option');
            shippingOption.addEventListener('click', function () {
                this.classList.add('selected');
            });

            // E-Way Bill checkbox
            const ewayLater = document.getElementById('eway-later');
            const ewayBill = document.getElementById('eway-bill');

            ewayLater.addEventListener('change', function () {
                ewayBill.disabled = this.checked;
                if (this.checked) {
                    ewayBill.value = '';
                }
            });
        });
    </script>
</body>

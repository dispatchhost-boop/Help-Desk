async function automaticNewLr(rate, cgst, sgst, igst, specificOrder) {
  console.log("data coming from automaticNewLr", rate, cgst, sgst, igst, specificOrder);

  const serviceType = rate.service_type;
  const TaggedApi = rate.TaggedApi;

  // Determine API keys and customer codes based on service type
  let customerCode = customerCodeLtl;
  let dtdcApiKey = apiKeyLtl;
  
  let serviceTypeId = "surface";

  if (rate.service_type === "Standard") {
    serviceTypeId = rate.forwarderServiceType;
    customerCode = customerCodeStd;
    dtdcApiKey = apiKeyStd;
  }

  console.log("serviceTypeId", serviceTypeId);
  console.log("customerCode", customerCode);
  console.log("dtdcApiKey", dtdcApiKey);

  const options = {
    codAmount: rate.codAmount || specificOrder.Amount || specificOrder.Check_Amount || specificOrder.Invoice_amount || 0,
    allocation: rate.forwarderServiceType || '',
    customerCode: customerCode,
    pickHubCode: rate.pickHubCode || '',
    piecesDetails: rate.piecesDetails || [],
    sellerDetails: rate.sellerDetails || {},
    Po_Products: rate.Po_Products || [],
    courierId: rate.courierId || '',
    token: dtdcApiKey || rate.apiToken || '',
    length: rate.length || 1,
    breadth: rate.breadth || 1,
    height: rate.height || 1
  };

  const payload = generateAWBPayload(rate.TaggedApi, specificOrder, options,customerCode,serviceTypeId);
  console.log("Generated AWB payload:", payload);
  let lr = null;

  try {
    switch (TaggedApi) {
      case "DTDC":
        lr = await handleDtdcAWB(serviceType, specificOrder, payload, dtdcApiKey, rate);
        break;
      case "Delhivery":
        lr = await handleDelhiveryAWB(serviceType, specificOrder, payload);
        break;
      case "expressbees":
        lr = await handleExpressbeesAWB(payload);
        break;
      default:
        console.warn("Unsupported forwarder:", TaggedApi);
    }
  } catch (err) {
    console.error("AWB API Call Failed:", err);
  }

  return lr;
}



async function handleDtdcAWB(serviceType, specificOrder, payload, dtdcApiKey, rate) {
  if (serviceType === "LTL") {
    const serviceabilityCheckResponse = await axios.get("/dtdc/pincode-check", {
      params: {
        origin: specificOrder.origin_pincode,
        destination: specificOrder.destination_pincode
      }
    });

    if (!serviceabilityCheckResponse.data.serviceable) {
      await swal({
        title: "Error!",
        text: serviceabilityCheckResponse.data.message,
        icon: "error",
        button: " OK",
      }).then(() => {
        window.location.href = "/unprocessed-orders";
      });
      return null;
    }

    await swal({
      title: "Success!",
      text: "Both origin and destination pincodes are serviceable.",
      icon: "success",
      button: "OK",
    });
  } else if (serviceType === "Standard") {
    console.log("Handling DTDC Standard service type – skipping pincode check.");
  }

  const response = await axios.post(
    'https://dtdcapi.shipsy.io/api/customer/integration/consignment/softdata',
    payload,
    {
      headers: {
        'Content-Type': 'application/json',
        'api-key': dtdcApiKey,
      }
    }
  );

  console.log(serviceType === "Standard" ? "DTDC Standard Response:" : "DTDC Response:", response.data);
  console.log(serviceType === "LTL" ? "DTDC Standard Response Data:" : "DTDC Response Data:", response.data?.data);
  const referenceNumber = response.data?.data?.[0]?.reference_number;

  if (referenceNumber && clientpaymentMode !== 'postpaid') {
    try {
      const updateWalletResponse = await axios.post('/update-wallet', {
        clientId: specificOrder.client_id,
        totalRate: Number(rate.rate),
        po_no: specificOrder.po_no,
        order_id: specificOrder.order_id,
        lr_no: referenceNumber,
        description: "DTDC",
      });
      console.log("Wallet Update Response:", updateWalletResponse.data);
    } catch (error) {
      console.error("Error updating wallet:", error);
    }
  }

  return referenceNumber || null;
}

async function handleDelhiveryAWB(serviceType, specificOrder, payload, rate) {
  if (serviceType === "LTL") {
    const originCheck = await axios.get("/delivery_ltl/pincode-check", {
      params: { pincode: specificOrder.origin_pincode }
    });
    const destCheck = await axios.get("/delivery_ltl/pincode-check", {
      params: { pincode: specificOrder.destination_pincode }
    });

    if (!originCheck.data.serviceable || !destCheck.data.serviceable) {
      await swal({
        title: "Error!",
        text: !originCheck.data.serviceable ? originCheck.data.message : destCheck.data.message,
        icon: "error",
        button: "OK",
      }).then(() => {
        window.location.href = "/unprocessed-orders";
      });
      return null;
    }

    await Swal.fire({
      title: "Success!",
      text: "Both pincodes are serviceable. Processing LR.",
      icon: "success",
      confirmButtonText: "Continue"
    });

    await Swal.fire({
      title: 'Processing...',
      text: 'Please wait while we process the Delhivery data.',
      allowOutsideClick: false,
      showConfirmButton: false,
      didOpen: async () => {
        Swal.showLoading();
        try {
          await processDelhivery(specificOrder.client_id);
          await fetchManifestWithDelay();
          Swal.close();
        } catch (error) {
          console.error('Error during Delhivery process:', error);
          Swal.fire({
            title: 'Error!',
            text: 'Something went wrong while processing Delhivery data.',
            icon: 'error',
            confirmButtonText: 'Ok'
          });
        }
      }
    });
    return "PENDING_MANIFEST";
  } else {
    const response = await axios.post(
      '/api/delhivery-create-order',
      { data: payload },
      {
        headers: {
          'Content-Type': 'application/json'
        }
      }
    );
    console.log("Delhivery Standard API Response:", response.data);

    const packages = response.data.packages || [];
    const waybillNumbers = packages.map(pkg => pkg.waybill);

    if (waybillNumbers.length > 0 && waybillNumbers[0] !== '' && clientpaymentMode !== 'postpaid') {
      try {
        const updateWalletResponse = await axios.post('/update-wallet', {
          clientId: specificOrder.client_id,
          totalRate: Number(rate.rate),
          po_no: specificOrder.po_no,
          order_id: specificOrder.order_id,
          lr_no: waybillNumbers[0],
          description: "Delhivery",
        });
        console.log("Wallet Update Response:", updateWalletResponse.data);
      } catch (error) {
        console.error("Error updating wallet:", error);
      }
    }

    return waybillNumbers.join(', ') || null;
  }
}

async function handleExpressbeesAWB(specificOrder, rate) {

    document.getElementById("lrNo").value = manifestResponse.data.data.lrnum;
    ltlChildLr = manifestResponse.data.data.waybills;
    docWaybills = manifestResponse.data.data.doc_waybill;
    masterWaybills = manifestResponse.data.data.master_waybill;

    // Update the wallet only if lrnum exists and is not empty
    if (manifestResponse.data.data.lrnum && manifestResponse.data.data.lrnum.length > 0) {
      // Check if client is not postpaid before updating wallet  
      if (clientpaymentMode !== 'postpaid') {

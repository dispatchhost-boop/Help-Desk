  // 1. Call the LR assignment function (create LR)
  const form = document.getElementById('lrDocketForm');
  const formData = new FormData(form); // Get all form data
 
  // Log form data for debugging
  for (const [key, value] of formData.entries()) {
    if (value instanceof File) {
      console.log(`${key}: ${value.name}`); // Logs the file name
    } else {
      console.log(`${key}: ${value}`); // Logs the other form field values
    }
  }
  formData.append('allocationMethod', allocationMethod);
  console.log("formdata",formData)
  // 
  // console.log("shabh",jdkjckd)
 
  // 2. Send the form data to create LR using Axios
  axios.post('/create_lr', formData, {
    headers: {
      'Content-Type': 'multipart/form-data',
    },
  })
  .then(function (response) {
    console.log('LR creation successful:', response.data);
 
    Swal.fire({
      title: 'Success!',
      text: 'LR/Docket has been created successfully.',
      icon: 'success',
      confirmButtonText: 'OK',
    }).then(() => {
      // Close the offcanvas before redirecting
      const orderDetailsCanvas = document.getElementById('offcanvasRight');
      const bsOffcanvas = bootstrap.Offcanvas.getInstance(orderDetailsCanvas);
      if (bsOffcanvas) {
        bsOffcanvas.hide(); // Close the offcanvas
      }

      // Wait for the offcanvas animation to complete, then reload
      setTimeout(() => {
        window.location.href = '/unprocessed-orders'; // Redirect to /unprocessed
      }, 300); // Small delay to ensure offcanvas is hidden before reload
    });
  })
  .catch(function (error) {
    console.error('Error in LR creation:', error);
    
    let errorMessage = 'There was an issue creating the LR/Docket.';
    if (error.response) {
      errorMessage = error.response.data?.message || errorMessage;
    } else if (error.request) {
      errorMessage = 'No response received from the server.';
    } else {
      errorMessage = error.message;
    }
 
    Swal.fire({
      title: 'Error!',
      text: errorMessage,
      icon: 'error',
      confirmButtonText: 'Try Again',
    });
  });
}
 

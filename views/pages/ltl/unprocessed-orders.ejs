          </div>
        `);
        
        $('#clear-search').on('click', function() {
          $('#search-input').val('');
          handleSearch();
        });
      } else {
        $('#active-filters').hide();
      }
    };

    // Search events
    $('#search-input').on('keyup', function(e) {
      if (e.key === 'Enter' || !$(this).val()) {
        handleSearch();
      }
    });
    
    $('#button-addon2').on('click', handleSearch);
    
    // Populate client dropdown from table data (for admin users)
    function populateClientDropdown() {
      const table = $('#datatable_2').DataTable();
      const clientMap = new Map();
      
      // Collect unique clients from the table
      table.rows().every(function() {
        const row = this.node();
        const clientId = $(row).data('client-id');
        const clientName = $(row).data('client-name');
        
        if (clientId && clientName && !clientMap.has(clientId)) {
          clientMap.set(clientId, clientName);
        }
      });
      
      // Add options to the dropdown
      clientMap.forEach((name, id) => {
        $('#client_select').append(`<option value="${id}">${name}</option>`);
      });
    }
    
    // Call this function after DataTable is initialized
    populateClientDropdown();
  });
</script>

  <script>
  async function deleteOrder(poNo) {
      const result = await Swal.fire({
          title: 'Are you sure?',
          text: "You won't be able to recover this order!",
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: 'Yes, delete it!'
      });

      if (result.isConfirmed) {
          // Send a request to your server to delete the order
          try {
              const response = await axios.delete('/delete-order', {
                  data: { po_no: poNo }
              });

              if (response.status === 200) {
                  Swal.fire('Deleted!', 'Your order has been deleted.', 'success');
                  location.reload(); // Reloads the page
              } else {
                  Swal.fire('Error!', 'Failed to delete the order.', 'error');
              }
          } catch (error) {
              console.error('Error:', error);
              Swal.fire('Error!', 'An error occurred while deleting the order.', 'error');
          }
      }
  }
</script>
  <script>
  document.addEventListener('DOMContentLoaded', function() {
  const selectAllCheckbox = document.getElementById('select-all');
  if (selectAllCheckbox) {
    selectAllCheckbox.addEventListener('change', function() {
      const rowCheckboxes = document.querySelectorAll('.row-checkbox');
      
      // Select only the first 10 checkboxes when "select-all" is checked
      const checkboxesToSelect = Math.min(rowCheckboxes.length, 10);
      
      for (let i = 0; i < rowCheckboxes.length; i++) {
        // Check/uncheck only the first 10 checkboxes based on select-all state
        if (i < checkboxesToSelect) {
          rowCheckboxes[i].checked = selectAllCheckbox.checked;
        }
      }
      
      // Update the count display
      updateSelectedOrder();
    });
  }
});
function updateSelectedOrder() {
  // Get all checkboxes with class 'row-checkbox'
  const checkboxes = document.querySelectorAll('.row-checkbox');
  
  // Count the number of checked checkboxes
  let selectedCount = 0;
  checkboxes.forEach(checkbox => {
    if (checkbox.checked) {
      selectedCount++;
    }
  });
  
  // Update the inner HTML of the #selectcheckcount element with the count
  const countElement = document.getElementById('selectcheckcount');
  
  if (selectedCount > 0) {
    countElement.innerHTML = `  <span style="text-transform:uppercase;">Orders Selected: &nbsp;<span style="font-size:18px;font-weight:500;color:blue;box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;padding: 5px 15px 5px 15px;border-radius: 15px;">${selectedCount}</span></span>`;
  } else {

async function manualLR(aggid, clientId, manualLrForwarder,category) {
  try {
    console.log("Fetching manual LR with params:", aggid, clientId, manualLrForwarder);
    const taggedApiResponse = await axios.get(`/getTaggedApi`, { params: { aggid } });
    
    taggedApi = taggedApiResponse.data.Tagged_api
    aggForVolumetricId = aggid;
    const poNo = document.getElementById('PONO').value;
    const url2 = `/fetch-volumetric-data?aggid=${aggid}&poNo=${poNo}`;
    const responseUrl2 = await axios.get(url2);
    console.log("responseurl2", responseUrl2)
    console.log("resposne from the volumetric weight", responseUrl2.data.totalVolumetricWeight)
    document.getElementById('volumetriciweight').value = responseUrl2.data.totalVolumetricWeight
    const volumetrcicW = responseUrl2.data.totalVolumetricWeight
    const actual = document.getElementById('totalWeight').value
    const chargeableWeight = Math.max(actual, volumetrcicW);
    console.log("chargable",chargeableWeight);
    // document.getElementById('ChargeableWeight').value =chargeableWeight
    // const { volumetricFactor, boxData } = response.data;

    // Construct the URL
    const url = `/get-manual-lr?aggid=${aggid}&clientId=${clientId}&taggedApi=${taggedApi}&category=${category}`;

    // Fetch the data
    const response = await axios.get(url);
    const data = response.data;
    document.getElementById("lrNo").value = data[0].Lr_Awb_no

    if (data && data.length > 0) {
      const { fod, billclient, owner_risk, carrier_risk } = data[0];

      // Freight section logic
      const billToClientOption = document.getElementById("billToClientOption");
      const fodOption = document.getElementById("fodOption");
      if (billclient === 1) {
        billToClientOption.style.display = "block";
        document.getElementById("billToClient").checked = true;
      } else {
        billToClientOption.style.display = "none";
      }
      if (fod === 1) {
        fodOption.style.display = "block";
        document.getElementById("FOD").checked = true;
      } else {
        fodOption.style.display = "none";
      }

      // Insurance section logic
      const ownerRiskOption = document.getElementById("ownerRiskOption");
      const carrierRiskOption = document.getElementById("carrierRiskOption");
      if (owner_risk === 1) {
        ownerRiskOption.style.display = "block";
        document.getElementById("ownerRisk").checked = true;
      } else {
        ownerRiskOption.style.display = "none";
      }
      if (carrier_risk === 1) {
        carrierRiskOption.style.display = "block";
        document.getElementById("carrierRisk").checked = true;
      } else {
        carrierRiskOption.style.display = "none";
      }
      document.getElementById("FrInsurance").style.display = "flex";
    } else {
      console.warn("No data returned for manual LR.");
    }
  } catch (error) {
    console.error("Error fetching manual LR data:", error);
    alert("Error fetching manual LR data. Please try again later.");
  }
}

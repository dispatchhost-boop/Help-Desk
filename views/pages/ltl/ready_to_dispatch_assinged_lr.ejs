      }

      .steps .step .step-icon-wrap {
        display: block;
        position: relative;
        width: 100%;
        height: 80px;
        text-align: center
      }

      .steps .step .step-icon-wrap::before,
      .steps .step .step-icon-wrap::after {
        display: block;
        position: absolute;
        top: 50%;
        width: 50%;
        height: 3px;
        margin-top: -1px;
        background-color: #e1e7ec;
        content: '';
        z-index: 1
      }

      .steps .step .step-icon-wrap::before {
        left: 0
      }

      .steps .step .step-icon-wrap::after {
        right: 0

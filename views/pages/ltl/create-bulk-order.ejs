                            <script>
                                document.getElementById('excelFile').addEventListener('change', function (event) {
                                    const uploadBtn = document.getElementById('uploadBtn');
                                    const file = event.target.files[0];
                                    if (file && (file.type === 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' || file.type === 'application/vnd.ms-excel')) {
                                        uploadBtn.disabled = false;
                                    } else {
                                        uploadBtn.disabled = true;
                                    }
                                });

                                document.getElementById('uploadBtn').addEventListener('click', function () {
                                    const fileInput = document.getElementById('excelFile');
                                    const file = fileInput.files[0];
                                    const pickupLocation = document.getElementById('pickupLocation').value;

                                    if (!file) {
                                        alert("Please select an Excel file first.");
                                        return;
                                    }

                                    if (!pickupLocation) {
                                        Swal.fire('Error!', 'Please select a pickup location first.', 'error');
                                        return;
                                    }

                                    // Show confirmation dialog before proceeding
                                    Swal.fire({
                                        title: 'Confirm Upload',
                                        text: 'Are you sure you want to upload this bulk order?',
                                        icon: 'question',
                                        showCancelButton: true,
                                        confirmButtonText: 'Yes, upload it!',
                                        cancelButtonText: 'No, cancel'
                                    }).then((result) => {
                                        if (result.isConfirmed) {
                                            const formData = new FormData();
                                            formData.append('excelFile', file);

                                            const chosenWarehouse = document.getElementById('pickupLocation').value;

                                            // Get client ID either from select dropdown or from route
                                            let clientID;
                                            const clientSelect = document.getElementById('client_select');
                                            const initialClientId = '<%= clientId %>';

                                            if (clientSelect && clientSelect.value) {
                                                clientID = clientSelect.value; // Use selected value if dropdown exists and has selection
                                            } else if (initialClientId) {
                                                clientID = initialClientId; // Fallback to route clientId
                                            }

                                            formData.append('choosenWarehouse', chosenWarehouse);
                                            formData.append('clientID', clientID);

                                            // Send the file to the server using Axios
                                            axios
                                                .post('/upload-excel-create-bulk-order', formData, {
                                                    headers: { 'Content-Type': 'multipart/form-data' },
                                                })
                                                .then((response) => {
                                                    console.log('Form submitted successfully:', response.data);
                                                    if (response.data.success) {
                                                        Swal.fire('Success!', 'Excel file uploaded and processed successfully!', 'success');
                                                        window.location.href = '/unprocessed-orders';
                                                    } else {
                                                        // Display the error message from the backend response
                                                        Swal.fire('Error!', response.data.message || 'There was an issue processing the file. Please try again.', 'error');
                                                    }
                                                })
                                                .catch((error) => {
                                                    console.error('Error submitting the form:', error);
                                                    const errorMessage = error.response?.data?.message || 'There was an error submitting your form.';
                                                    Swal.fire('Error!', errorMessage, 'error');
                                                });
                                        }
                                    });
                                });
                            </script>
                            <script>
                                // Function to fetch warehouses for a client ID
                                async function fetchWarehousesForClient(clientId) {
                                    if (clientId) {
                                        try {
                                            const response = await fetch(`/get-warehouses-by-client?client_id=${clientId}`);
                                            const data = await response.json();

                                            const pickupLocationDropdown = document.getElementById('pickupLocation');
                                            pickupLocationDropdown.innerHTML = '<option value="">Select Pickup Location</option>';

                                            data.warehouses.forEach(warehouse => {
                                                const option = document.createElement('option');
                                                option.value = warehouse.serial;
                                                option.textContent = `${warehouse.warehouse_name}`;
                                                pickupLocationDropdown.appendChild(option);
                                            });
                                        } catch (error) {
                                            console.error('Error fetching warehouses:', error);
                                        }
                                    } else {
                                        document.getElementById('pickupLocation').innerHTML = '<option value="">Select Pickup Location</option>';
                                    }
                                }

                                // Get initial client ID from server-side render
                                const initialClientId = '<%= clientId %>';
                                console.log("initialClientId", initialClientId);

                                // If client ID was provided from route, fetch warehouses immediately
                                if (initialClientId) {
                                    fetchWarehousesForClient(initialClientId);
                                }

                                // For role 1, handle client select changes
                                const clientSelect = document.getElementById('client_select');
                                if (clientSelect) {
                                    clientSelect.addEventListener('change', function () {
                                        fetchWarehousesForClient(this.value);
                                    });
                                }
                            </script>
                            <!-- Add this script at the bottom of the file, before the closing body tag -->
                            <script>
                                // Event listener for LR Data file input change
                                document.getElementById('lrDataFile').addEventListener('change', function (event) {
                                    const createLrDataBtn = document.getElementById('createLrDataBtn');
                                    const file = event.target.files[0];
                                    if (file && (file.type === 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' || file.type === 'application/vnd.ms-excel')) {
                                        createLrDataBtn.disabled = false;
                                    } else {
                                        createLrDataBtn.disabled = true;
                                    }
                                });

                                // Event listener for Create LR Data button click
                                document.getElementById('createLrDataBtn').addEventListener('click', function () {
                                    const fileInput = document.getElementById('lrDataFile');
                                    const file = fileInput.files[0];
                                    const statusElement = document.getElementById('lrDataUploadStatus');

                                    if (!file) {
                                        Swal.fire('Error!', 'Please select an Excel file first.', 'error');
                                        return;
                                    }

                                    // Show confirmation dialog before proceeding
                                    Swal.fire({
                                        title: 'Confirm LR Data Creation',
                                        text: 'Are you sure you want to upload this file and create LR data?',
                                        icon: 'question',
                                        showCancelButton: true,
                                        confirmButtonText: 'Yes, create it!',
                                        cancelButtonText: 'No, cancel'
                                    }).then((result) => {
                                        if (result.isConfirmed) {
                                            const formData = new FormData();
                                            formData.append('lrDataFile', file);

                                            // Show loading state
                                            statusElement.textContent = 'Uploading and processing file...';

                                            // Send the file to the server using Axios
                                            axios
                                                .post('/upload-lr-data', formData, {
                                                    headers: { 'Content-Type': 'multipart/form-data' },
                                                })
                                                .then((response) => {
                                                    console.log('LR Data submitted successfully:', response.data);
                                                    if (response.data.success) {
                                                        Swal.fire('Success!', 'LR Data file uploaded and processed successfully!', 'success');
                                                        statusElement.textContent = 'File processed successfully!';
                                                    } else {
                                                        Swal.fire('Error!', response.data.message || 'There was an issue processing the file. Please try again.', 'error');
                                                        statusElement.textContent = 'Error: ' + (response.data.message || 'Processing failed');
                                                    }
                                                })
                                                .catch((error) => {
                                                    console.error('Error submitting the LR data:', error);
                                                    const errorMessage = error.response?.data?.message || 'There was an error submitting your LR data.';
                                                    Swal.fire('Error!', errorMessage, 'error');
                                                    statusElement.textContent = 'Error: ' + errorMessage;
                                                });
                                        }
                                    });
                                });
                            </script>
                            <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
                            <script
                                src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.3/dist/sweetalert2.min.js"></script>
                            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>



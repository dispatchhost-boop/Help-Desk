<script>
document.getElementById("kycForm").addEventListener("submit", async (e) => {
  e.preventDefault();

  // 🔍 Step 1: Check if GST and PAN are verified
  const gstSuccess = document.getElementById("gstSuccess");
  const panHolderName = document.getElementById("hidden_pan_holder_name").value;

  const gstVerified = gstSuccess && !gstSuccess.classList.contains("hidden");
  const panVerified = panHolderName !== "";

  // if (!gstVerified || !panVerified) {
  //   alert("❌ Please verify both GST and PAN before submitting.");
  //   return;
  // }

  // 📦 Step 2: Prepare FormData
  const form = document.getElementById("kycForm");
  const formData = new FormData();

  // 👤 Client Details
  formData.append("clientName", document.getElementById("clientName")?.value);
  formData.append("clientEmail", document.getElementById("clientEmail")?.value);
  formData.append("clientPhone", document.getElementById("clientPhone")?.value);

  // 📷 Selfie Capture
  const canvas = document.getElementById("canvas");
  if (canvas && !canvas.classList.contains("hidden")) {
    canvas.toBlob((blob) => {
      formData.append("selfie", blob, "selfie.png");
      proceedUpload(); // Continue with rest of form upload after selfie blob is ready
    }, "image/png");
  } else {
    proceedUpload(); // If no canvas/selfie, proceed directly
  }

  // 📤 Function to handle form upload
  function proceedUpload() {
    // 🏢 Company Branding
    formData.append("registeredCompanyName", document.getElementById("registeredCompanyName")?.value);
    formData.append("brandName", document.getElementById("brandName")?.value);
    formData.append("companyEmail", document.getElementById("companyEmail")?.value);
    formData.append("website", document.getElementById("website")?.value);

    // 🏢 Company Type
    const companyType = document.querySelector('input[name="companyType"]:checked')?.value;
    formData.append("companyType", companyType);

    // 📄 Aadhaar
    formData.append("aadhaarNumber", document.getElementById("aadhaarNumber")?.value);
    if (document.getElementById("aadhaarUpload")?.files[0])
      formData.append("aadhaarUpload", document.getElementById("aadhaarUpload").files[0]);

    // 💳 PAN
    formData.append("company_pan", document.getElementById("company_pan")?.value);
    formData.append("pan_holder_name", panHolderName);
    if (document.getElementById("pandoc")?.files[0])
      formData.append("pandoc", document.getElementById("pandoc").files[0]);

    // 🧾 GST
    formData.append("gstNo", document.getElementById("gstNo")?.value);
    formData.append("trade_name", document.getElementById("hidden_trade_name").value);
    formData.append("constitution_of_business", document.getElementById("hidden_constitution").value);
    formData.append("nature_of_business", document.getElementById("hidden_nature").value);
    if (document.getElementById("gstdoc")?.files[0])
      formData.append("gstdoc", document.getElementById("gstdoc").files[0]);

    // 🧾 Company Registration
    formData.append("companyRegNumber", document.getElementById("companyRegNumber")?.value);
    if (document.getElementById("companyRegUpload")?.files[0])
      formData.append("companyRegUpload", document.getElementById("companyRegUpload").files[0]);

    // 🏦 Cancelled Check
    formData.append("cancelledCheckNumber", document.getElementById("cancelledCheckNumber")?.value);
    if (document.getElementById("cancelledCheckUpload")?.files[0])
      formData.append("cancelledCheckUpload", document.getElementById("cancelledCheckUpload").files[0]);

    // 📎 Client Logo
    if (document.getElementById("clientLogo")?.files[0])
      formData.append("clientLogo", document.getElementById("clientLogo").files[0]);

    // ✅ Submit via Axios
    axios.post("/submit-kyc", formData, {
      headers: { "Content-Type": "multipart/form-data" },
    })
    .then((response) => {
      if (response.data.success) {
        alert("✅ KYC submitted successfully!");
        location.reload();
      } else {
        alert("❌ Submission failed: " + (response.data.message || "Unknown error"));
      }
    })
    .catch((err) => {
      console.error("Error:", err);
      alert("❌ Error submitting KYC. Please try again.");
    });
  }
});
</script>


    <script>
            // ========================= PAN VERIFICATION =========================
      const panInput = document.getElementById('company_pan');
      const panError = document.getElementById('pan_error');
      const panResponse = document.getElementById('pan_response');
      const panFileInput = document.getElementById('pandoc');

      panInput?.addEventListener('blur', async () => {
        const pan = panInput.value.trim().toUpperCase();

        // Reset UI
        panError.style.display = 'none';
        panError.innerText = '';
        panResponse.innerHTML = '';
        panFileInput.disabled = true;

        // Format validation
        const panRegex = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;
        if (!panRegex.test(pan)) {
          panError.innerText = "❌ Invalid PAN format";
          panError.style.display = 'block';
          return;
        }

        try {
          const res = await axios.post('/client-kyc-verification', { docNumber: pan });
          const msg = res?.data?.data?.msg;
          const status = res?.data?.data?.status;

          if (status === 1 && msg?.STATUS === "Active") {
            // PAN is valid and active
            panError.style.display = 'none';
            panError.innerText = '';

            panResponse.innerHTML = `
              <div class="alert alert-success p-2 mb-2">
                ✅ PAN is <strong>Active</strong> and <strong>Verified</strong><br>
                Name on Card: <strong>${msg.NameOnTheCard}</strong><br>
                Status: ${msg.StatusDescription}
              </div>
            `;

            panFileInput.disabled = false;
            // Save PAN name to hidden input
            const hiddenField = document.getElementById('hidden_pan_holder_name');
            if (hiddenField) hiddenField.value = msg.NameOnTheCard || '';
          } else {
            // PAN inactive or not found
            panError.innerText = "❌ PAN not active or not valid";
            panError.style.display = 'block';
          }
        } catch (err) {
          panError.innerText = "❌ Failed to verify PAN. Please try again.";
          panError.style.display = 'block';
        }
      });
      // ========================= GSTIN VERIFICATION =========================
      const gstInput = document.getElementById('gstNo');
      const gstError = document.getElementById('gstError');
      const gstResponse = document.getElementById('gstResponse');
      const gstSuccess = document.getElementById('gstSuccess');
      const gstFileInput = document.getElementById('gstdoc');

      gstInput?.addEventListener('blur', async () => {
        const gstNumber = gstInput.value.trim();
        gstError.style.display = 'none';
        gstResponse.innerHTML = '';
        gstSuccess.style.display = 'none';
        if (gstFileInput) gstFileInput.disabled = true;

        if (gstNumber.length !== 15) {
          gstError.textContent = 'Please enter a valid 15-digit GST number.';
          gstError.style.display = 'block';
          return;
        }

        try {
          const res = await axios.post('/client-gstin-verification', { gstNumber });
          if (res.data.success) {
            const { gstin, tradeName, constitutionOfBusiness, natureOfBusinessActivities } = res.data;

            gstResponse.innerHTML = `
            <div class="alert alert-success p-2 mb-2">
            ✅ <strong>GSTIN:</strong> ${gstin}<br>
            <strong>Trade Name:</strong> ${tradeName}<br>
            <strong>Constitution of Business:</strong> ${constitutionOfBusiness}<br>
            <strong>Nature of Business Activities:</strong> ${natureOfBusinessActivities}
            </div>
            `;
            // Set hidden input fields
            document.getElementById('hidden_trade_name').value = tradeName || '';
            document.getElementById('hidden_constitution').value = constitutionOfBusiness || '';
            document.getElementById('hidden_nature').value = natureOfBusinessActivities || '';

            // Enable GST document upload
            if (gstFileInput) gstFileInput.disabled = false;
          } else {
            gstError.textContent = res.data.message || 'Invalid GST number.';
            gstError.style.display = 'block';
            if (gstFileInput) gstFileInput.disabled = true;
          }
        } catch (error) {
          gstError.textContent = error?.response?.data?.message || 'Something went wrong!';
          gstError.style.display = 'block';
          if (gstFileInput) gstFileInput.disabled = true;
        }
      });

    </script>


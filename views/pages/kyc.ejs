                </div>
                <div class="flex flex-col gap-2 sm:col-span-2">
                  <label for="companyRegUpload" class="text-xs font-semibold text-gray-600">Upload Company Registration Document</label>
                  <input type="file" id="companyRegUpload" name="companyRegUpload" accept="image/*,application/pdf" aria-describedby="companyRegUploadError" class="border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-600 focus:outline-none" />
                  <p id="companyRegUploadError" class="text-red-600 text-xs mt-1 hidden">Please upload company registration document.</p>
                </div>

                <div class="flex flex-col gap-2 sm:col-span-2">
                  <label for="cancelledCheckUpload" class="text-xs font-semibold text-gray-600">Upload Cancelled Check Document</label>
                  <input type="file" id="cancelledCheckUpload" name="cancelledCheckUpload" accept="image/*,application/pdf" aria-describedby="cancelledCheckUploadError" class="border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-600 focus:outline-none" />

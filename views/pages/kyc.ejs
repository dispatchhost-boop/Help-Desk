<!DOCTYPE html>
<html lang="hi">

<head>
  <%- include('../partials/head') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Company Setup - ShipRocket</title>
     <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
  />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    video, canvas {
      border-radius: 0.375rem; /* rounded-md */
      border: 1px solid #d1d5db; /* border-gray-300 */
      max-width: 100%;
      height: auto;
    }
  </style>
  
</head>

<body data-theme="light" class="font-nunito">
  <div id="wrapper" class="theme-cyan">
    <!-- HEADER SECTION -->
    <%- include('../partials/header') %>

      <!-- SIDEBAR SECTIONS -->
      <%- include('../partials/left-sidebar') %>
        <%- include('../partials/right-iconbar') %>

          <!-- MAIN CONTENT AREA -->
          <div id="main-content">
            <div class="container-fluid">
                    <div class="flex flex-1 flex-col md:flex-row p-6 md:p-10 lg:p-14 xl:p-16 max-w-[1280px] mx-auto w-full">
    <!-- Sidebar -->
    <aside class="w-full md:w-[220px] border border-gray-200 rounded-xl p-6 mb-8 md:mb-0 flex flex-col">
      <h2 class="text-xs font-semibold text-gray-400 mb-6 tracking-widest">CLIENT ONBOARDING</h2>
      <nav class="flex flex-col gap-2" role="tablist" aria-orientation="vertical">
        <button id="tab-client-details" role="tab" aria-selected="true" aria-controls="panel-client-details" tabindex="0" class="text-purple-600 bg-purple-100 rounded-lg px-5 py-3 text-sm font-semibold flex items-center gap-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-purple-600">
          <i class="fas fa-user-circle"></i> Client Details
        </button>
        <button id="tab-kyc-documents" role="tab" aria-selected="false" aria-controls="panel-kyc-documents" tabindex="-1" class="text-gray-800 hover:bg-gray-50 rounded-lg px-5 py-3 text-sm font-medium flex items-center gap-2 transition-colors focus:outline-none focus:ring-2 focus:ring-purple-600">
          <i class="fas fa-file-alt"></i> KYC Documents
        </button>
        <button id="tab-subscription-plan" role="tab" aria-selected="false" aria-controls="panel-subscription-plan" tabindex="-1" class="text-gray-800 hover:bg-gray-50 rounded-lg px-5 py-3 text-sm font-medium flex items-center gap-2 transition-colors focus:outline-none focus:ring-2 focus:ring-purple-600">
          <i class="fas fa-clipboard-list"></i> Subscription Plan
        </button>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-0 md:ml-10">
      <section class="max-w-4xl mx-auto" tabindex="0">
        <!-- Client Details Panel -->
        <div id="panel-client-details" role="tabpanel" aria-labelledby="tab-client-details" tabindex="0" class="tab-panel">
          <h3 class="text-lg font-semibold mb-2 text-gray-900">Client Details</h3>
          <p class="text-sm text-gray-600 mb-8">Fill and submit all the required information to onboard the client.</p>

          <!-- <form id="clientForm" class="border border-gray-200 rounded-xl p-8 space-y-12" action="#" method="POST" novalidate> -->
            <!-- Section 1: Client Details -->
          <form id="kycForm" class="border border-gray-200 rounded-xl p-6 space-y-10" action="#" method="POST" enctype="multipart/form-data" novalidate>
            <section>
              <h4 class="text-base font-semibold mb-6 text-gray-900 border-b border-gray-300 pb-3">Client Details</h4>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="flex flex-col gap-6 md:col-span-2">
                  <div>
                    <label for="clientName" class="block text-xs font-semibold text-gray-600 mb-1">Client Name <span class="text-red-500">*</span></label>
                    <input id="clientName" disabled name="clientName" type="text" value="<%= userData.first_name %>" required aria-required="true" aria-describedby="clientNameError" class="w-full border border-gray-300 rounded-md px-4 py-3 text-sm focus:ring-2 focus:ring-purple-600 focus:outline-none invalid:ring-red-500" />
                    <p id="clientNameError" class="text-red-600 text-xs mt-1 hidden"><%= userData.first_name %></p>
                  </div>
                  <div>
                    <label for="clientEmail" class="block text-xs font-semibold text-gray-600 mb-1">Email Address <span class="text-red-500">*</span></label>
                    <input id="clientEmail" disabled name="clientEmail" type="email" value="<%= userData.email %>" required aria-required="true" aria-describedby="clientEmailError" class="w-full border border-gray-300 rounded-md px-4 py-3 text-sm focus:ring-2 focus:ring-purple-600 focus:outline-none invalid:ring-red-500" />
                    <p id="clientEmailError" class="text-red-600 text-xs mt-1 hidden"><%= userData.email %></p>
                  </div>
                  <div>
                    <label for="clientPhone" class="block text-xs font-semibold text-gray-600 mb-1">Phone Number <span class="text-red-500">*</span></label>
                    <input id="clientPhone" disabled value="<%= userData.phone_no%>" name="clientPhone" type="tel" placeholder="<%= userData.phone_no %>" pattern="^\d{10}$" required aria-required="true" aria-describedby="clientPhoneError" class="w-full border border-gray-300 rounded-md px-4 py-3 text-sm focus:ring-2 focus:ring-purple-600 focus:outline-none invalid:ring-red-500" />
                    <p id="clientPhoneError" class="text-red-600 text-xs mt-1 hidden">Please enter a valid 10-digit phone number.</p>
                  </div>
                </div>

                <!-- Upload Section -->
                <div class="flex flex-col items-center gap-3 border border-dashed border-purple-600 rounded-md p-4 w-28 h-28 justify-center self-start relative">
                  <label for="clientLogo" class="flex flex-col items-center gap-1 cursor-pointer text-purple-600 text-xs select-none" aria-label="Upload client logo">
                    <i class="fas fa-upload text-lg"></i> Upload
                  </label>
                  <input type="file" id="clientLogo" name="clientLogo" accept="image/*" aria-describedby="clientLogoHelp" class="hidden" />
                  <p id="clientLogoHelp" class="text-[9px] text-gray-400 text-center leading-tight pointer-events-none select-none">Max 1 MB<br /><span class="text-[8px]">(250×150px)</span></p>
                  <img id="previewLogo" alt="Preview of uploaded client logo" class="absolute inset-0 object-contain w-full h-full rounded-md hidden" />
                </div>
              </div>

              <!-- Camera Capture -->
              <div class="mt-8">
                <label class="block text-xs font-semibold text-gray-600 mb-2">Capture Profile Photo</label>
                <div class="flex flex-col md:flex-row gap-6 items-center">
                  <div class="flex flex-col items-center gap-2">
                    <video id="video" autoplay playsinline class="w-48 h-36 bg-gray-100"></video>
                    <button type="button" id="startCameraBtn" class="bg-purple-600 text-white text-xs font-semibold rounded-md px-6 py-2 hover:bg-purple-700 transition-colors focus:outline-none focus:ring-2 focus:ring-purple-600">Start Camera</button>
                    <button type="button" id="captureBtn" class="bg-green-600 text-white text-xs font-semibold rounded-md px-6 py-2 hover:bg-green-700 transition-colors focus:outline-none focus:ring-2 focus:ring-green-600 hidden">Capture</button>
                    <button type="button" id="retakeBtn" class="bg-yellow-600 text-white text-xs font-semibold rounded-md px-6 py-2 hover:bg-yellow-700 transition-colors focus:outline-none focus:ring-2 focus:ring-yellow-600 hidden">Retake</button>
                  </div>

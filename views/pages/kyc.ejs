                    <input type="hidden" id="hidden_nature" name="nature_of_business">
                    <div id="gstError" class="text-red-600 text-xs mt-1 hidden"></div>
                    <div id="gstResponse" class="text-xs text-gray-500 mt-1"></div>
                    <span id="gstSuccess" class="text-green-600 text-sm font-medium hidden">✔</span>
                  </div>
                  <div class="flex flex-col gap-2 sm:col-span-2">
                    <label for="gstdoc" class="text-xs font-semibold text-gray-600">Upload GST Document</label>
                    <input type="file" id="gstdoc" name="gstdoc" accept="image/*" required disabled

                  <input type="text" id="cancelledCheckNumber" name="cancelledCheckNumber" placeholder="Enter Cancelled Check Number" aria-describedby="cancelledCheckNumberError" class="border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-purple-600 focus:outline-none" />

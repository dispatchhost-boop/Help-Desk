            <!-- Save Button -->
            <!-- <div class="flex justify-end">
              <button id="saveBtn" type="submit" class="bg-purple-600 text-white text-sm font-semibold rounded-md px-10 py-3 hover:bg-purple-700 transition-colors focus:outline-none focus:ring-2 focus:ring-purple-600 focus:ring-offset-1">Save & Continue</button>
            </div>
        -->
        </div>

        <!-- KYC Documents Panel -->

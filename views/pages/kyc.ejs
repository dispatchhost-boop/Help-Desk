                <span id="kycStatus" class="inline-block bg-yellow-100 text-yellow-700 text-xs font-medium px-3 py-1 rounded">Pending</span>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 mb-2">Documents Uploaded</p>

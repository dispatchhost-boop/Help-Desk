                async function delayWithCountdown(milliseconds) {
                  return new Promise(resolve => {
                    let secondsLeft = milliseconds / 1000; // Convert milliseconds to seconds

                    Swal.fire({
                      title: 'Please wait...',
                      html: `Fetching manifest in <strong>${secondsLeft}</strong> seconds.`,
                      timerProgressBar: true,
                      didOpen: () => {
                        Swal.showLoading(); // Show loading spinner
                        const content = Swal.getHtmlContainer(); // Get the Swal content container

                        const interval = setInterval(() => {
                          secondsLeft -= 1;

                          if (content) {
                            content.querySelector('strong').textContent = secondsLeft; // Update countdown
                          }

                          if (secondsLeft <= 0) {
                            clearInterval(interval); // Clear the interval when time runs out
                            Swal.close(); // Close the SweetAlert
                            resolve(); // Resolve the promise
                          }
                        }, 1000); // Update every second
                      }
                    });
                  });
                }
                async function fetchManifestWithDelay() {

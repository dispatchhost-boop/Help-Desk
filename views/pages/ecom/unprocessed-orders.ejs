            .shipping-option.active { border: 2px solid #198754; background: #ffffff; } */
      .order-section {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.25rem;
        background-color: #fff;
      }

      .order-section h6 {
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 1rem;
      }


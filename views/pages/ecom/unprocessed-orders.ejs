      }

      .input-group input {
        max-width: 80px;
      }

      .card {
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
      }

      .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: #343a40;
      }

      .form-label {
        font-weight: 500;
        font-size: 0.875rem;

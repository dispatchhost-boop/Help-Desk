                            <i class="fas fa-tasks me-1"></i>Bulk Actions
                          </button>
                          <ul class="dropdown-menu shadow-sm">
                            <li>
                              <h6 class="dropdown-header">Print Labels</h6>
                            </li>
                            <li><a class="dropdown-item bulk-print-label" href="#" data-size="4X6"><i
                                  class="fas fa-print me-2"></i>4X6 Labels</a></li>
                            <li><a class="dropdown-item bulk-print-label" href="#" data-size="A4"><i
                                  class="fas fa-print me-2"></i>A4 Labels</a></li>
                            <li><a class="dropdown-item bulk-print-label" href="#" data-size="4X4"><i
                                  class="fas fa-print me-2"></i>4X4 Labels</a></li>
                            <li><a class="dropdown-item bulk-print-label" href="#" data-size="4X2"><i
                                  class="fas fa-print me-2"></i>4X2 Labels</a></li>
                          </ul>
                        </div>
                      </div>

                    </div>
                  </div>
                </div>

                <div class="container-fluid">
                  <div class="card-body p-2"></div>
                  
                  <!-- Card-based layout instead of table -->
                  <div id="ordersContainer">
                    <% result.forEach(function(order) { %>
                      <div class="order-card" data-client="<%= order.client_id %>" data-company-name="<%= order.company_name %>">
                        <div class="row "style="display: flex;flex-direction: row;flex-wrap: nowrap;align-items: center;justify-content: center;">
                          <div class="col-md-1">
                            <input class="form-check-input rowCheckbox" type="checkbox" data-id="<%= order.lr_no %>"style="box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;">
                          </div>
                          <div class="col-md-2">
                            <% 
                              const lrDateObj = new Date(order.created_at);
                              const orderDateObj = new Date(order.order_date);
                          
                              const formatDate = (date) =>
                                date.toLocaleDateString('en-IN', { 
                                  weekday: 'short', 
                                  year: 'numeric', 
                                  month: 'short', 
                                  day: 'numeric',
                                  timeZone: 'Asia/Kolkata' 
                                });
                            %>
                          
                            <!-- LR No and LR Date -->
                            <div class="order-id lrNo" 
                                 data-bs-toggle="offcanvas"
                                 data-bs-target="#orderDetailsCanvas" 
                                 aria-controls="orderDetailsCanvas"
                                 data-lrno="<%= order.lr_no %>"
                                 data-vendor-type="<%= order.tagged_api %>" 
                                 data-orderid="<%= order.order_id %>">
                              <%= order.lr_no %>
                            </div>
                            <small class="text-muted d-block">LR Date: <%= formatDate(lrDateObj) %></small>
                          
                            <!-- Order No and Order Date -->
                            <div class="order-id mt-2">Order: <%= order.orderid %></div>
                            <small class="text-muted d-block">Order Date: <%= formatDate(orderDateObj) %></small>
                          
                            <!-- Button -->
                            <button class="btn btn-outline-success btn-sm mt-2">Track Order</button>
                          </div>
                          
                          
                          <div class="col-md-3">
                            <div class="d-flex flex-column align-items-start position-relative timeline-section ps-4">
                              <div class="position-absolute timeline-line"></div>
                              <div class="d-flex align-items-center mb-2" style="z-index: 1;">
                                <div class="text-black d-flex align-items-center justify-content-center me-3 timeline-icon">
                                  <i class="fa fa-building"></i>
                                </div>
                                <div>
                                  <div class="fw-semibold">Company</div>
                                  <div class="text-muted text-small">
                                    <%= order.company_name || 'N/A' %>
                                  </div>
                                  <div class="text-muted text-small">
                                    Pincode: <%= order.warehouse_pincode || 'N/A' %>
                                  </div>
                                </div>
                              </div>
                              <div class="d-flex align-items-center" style="z-index: 1;">
                                <div class="text-black d-flex align-items-center justify-content-center me-3 timeline-icon">
                                  <i class="fa fa-user"></i>
                                </div>
                                <div>
                                  <div class="fw-semibold">Consignee</div>
                                  <div class="text-muted text-small">
                                    <%= order.consignee_first_name || 'N/A' %> <%= order.consignee_last_name || 'N/A' %>
                                    (<%= order.consignee_city || 'N/A' %>)
                                  </div>
                                  <div class="text-muted text-small">
                                    Phone: <%= order.consignee_phone || 'N/A' %>
                                    
                                  </div>
                                  <div class="text-muted text-small">
                                    Alternate Phone: <%= order.consignee_alternate_mobile || 'N/A' %>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-2 text-small">
                            <strong>Weight Details</strong><br>
                            Chargeable: <%= order.chargable_weight || 'N/A' %><br>
                            Volumetric: <%= order.volumetric_weight || 'N/A' %><br>
                            <div class="mt-2">
                              <strong>Rate Details</strong><br>
                              Base: ₹<%= order.base_rate || 'N/A' %><br>
                              Total: ₹<%= order.total_lr_charges || 'N/A' %>
                            </div>
                          </div>
                          <div class="col-md-1 text-small">
                           
                            <% 
                              const courierName = (order.tagged_api || '').toLowerCase();
                              let logoPath = '/assets/images/logos/logo-dark.png';
                              
                              if (courierName.includes('delhivery')) {
                                logoPath = '/assets/images/logos/delhivery.png';
                              } else if (courierName.includes('express') || courierName.includes('expressbees')) {
                                logoPath = '/assets/images/logos/expressbees.png'; 
                              } else if (courierName.includes('dtdc')) {
                                logoPath = '/assets/images/logos/dtdc.png';
                              } else if (courierName.includes('bluedart')) {
                                logoPath = '/assets/images/BlueDart.png';
                              } else if (courierName.includes('fedex')) {
                                logoPath = '/assets/images/FedEx.png';
                              }
                            %>
                            <div class="d-flex align-items-center">
                              <img src="<%= logoPath %>" alt="<%= order.tagged_api || 'Courier' %>" 
                                   style="width: 67px;height: 76px;object-fit: contain;margin-right: 8px;">
                             
                              
                            </div>
                            <div class="text-muted text-small mt-1">
                              <% if (order.forwarder_product_type && order.forwarder_product_type.toLowerCase().includes('air')) { %>
                                <i class="fas fa-plane me-1 fs-10 text-primary" style="
                                font-size: x-large;
                            "></i>
                              <% } else { %>
                                <i class="fas fa-truck me-1 text-primary" style="
                                font-size: x-large;
                            "></i>
                              <% } %>
                            </div>
                          </div>
                          <div class="col-md-2 text-end text-small">
                            
                            <div class="mt-3 d-flex gap-2">
                              <% if (activeTopicIds.includes(2)) { %>
                                <!-- Pickup Request Button -->
                                <button class="btn pickup-request" 
                                        data-orderid="<%= order.order_id %>" 
                                        data-client-id="<%= order.client_id %>"
                                        data-courier="<%= order.tagged_api %>"
                                        data-awb-number="<%= order.lr_no %>">
                                  <i class="fas fa-person-walking-luggage me-1"></i>
                                </button>
                                
                                <!-- Cancel LR Button -->
                                <button class="btn  cancel-lr" 
                                        data-action="cancel-lr-awb"
                                        data-courier="<%= order.tagged_api %>" 
                                        data-awb-number="<%= order.lr_no %>"
                                        data-orderid="<%= order.order_id %>" 
                                        data-client-id="<%= order.client_id %>">
                                  <i class="fas fa-times-circle me-1"></i>
                                </button>
                                
                                <!-- Shipping Label Button -->
                                <div class="dropdown">
                                  <button class="btn dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-receipt me-1"></i>

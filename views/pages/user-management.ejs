    <div class="row p-2">
      <div class="d-flex justify-content-end align-items-center col-12">
        <div>
          <% if (activeTopicIds.includes(5)) { %>
            <button type="button" class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#Adduser">
              Add Users
            </button>
          <% } %>
        </div>
      </div>
    </div>
    <div class="w-full px-4">
      <div class="nav nav-tabs border-bottom">
        <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1Content">
          <i class="fas fa-check-circle"></i> Active
        </button>
        <button class="nav-link" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2Content">
          <i class="fas fa-times-circle"></i> Inactive
        </button>
      </div>
    
      <div class="tab-content">
        <!-- Active Tab Content -->
        <div id="tab1Content" class="tab-pane fade show active">
          <div class="container-fluid mt-3">
            <div class="p-2">
              <div class="table-responsive card p-2">
                <table class="table my-table border-0 table-striped" id="datatable_2">
                  <thead>
                    <tr>
                      <th>Client Name</th>
                      <th>First Name</th>
                      <th>Last Name</th>
                      <th>Email ID</th>
                      <th>Phone Number</th>
                      <th>Reporting</th>
                      <th>Role</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <!-- here i have changed -->
                  <tbody>
                    <% activeAdmins.forEach(admin => { %>
                    <tr>
                      <td><%= admin.company_name %></td>
                      <td><%= admin.first_name %></td>
                      <td><%= admin.last_name %></td>
                      <td><%= admin.email %></td>
                      <td><%= admin.phone_no ? 'XXXXXX' + admin.phone_no.slice(-4) : '' %></td>
                      <td><%= admin.is_active == 1 ? 'Active' : 'Inactive' %></td>
                      <td><%= admin.role_name %></td>
                      <td>
                       
                        <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#ViewUserModal"
                          data-user-id="<%= admin.id %>" onclick="viewUser(this.getAttribute('data-user-id'))">
                          <i class="fas fa-eye"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#EditUserModal"
                          data-user-id="<%= admin.id %>" onclick="editUser(this.getAttribute('data-user-id'))">
                          <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm" data-user-id="<%= admin.id %>" onclick="deactivateOrActive(this.getAttribute('data-user-id'))">
                          <i class="fas fa-user-slash"></i>
                          Deactivate
                        </button>
                        
                      </td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
    
        <!-- Inactive Tab Content -->
        <div id="tab2Content" class="tab-pane fade">
          <div class=" container-fluid mt-3" style="background: linear-gradient(135deg, #fdfcfb 0%, #fbffdc 100%);">
            <div class="p-2">
              <div class="table-responsive">
                <table class="table my-table border-0" id="datatable_3">
                  <thead>
                    <tr>
                      <th>Client Name</th>
                      <th>First Name</th>
                      <th>Last Name</th>
                      <th>Email ID</th>
                      <th>Phone Number</th>
                      <th>Reporting</th>
                      <th>Role</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% inactiveAdmins.forEach(admin => { %>
                    <tr>
                      <td><%= admin.company_name %></td>
                      <td><%= admin.first_name %></td>
                      <td><%= admin.last_name %></td>
                      <td><%= admin.email %></td>
                      <td><%= admin.phone_no ? 'XXXXXX' + admin.phone_no.slice(-4) : '' %></td>
                      <td><%= admin.is_active == 1 ? 'Active' : 'Inactive' %></td>
                      <td><%= admin.role_name %></td>
                      <td>
                        <% if (admin.role_name !== 'super Admin') { %>
                        <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#ViewUserModal"
                          data-user-id="<%= admin.id %>" onclick="viewUser(this.getAttribute('data-user-id'))">
                          <i class="fas fa-eye"></i>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#EditUserModal"
                          data-user-id="<%= admin.id %>" onclick="editUser(this.getAttribute('data-user-id'))">
                          <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-outline-success btn-sm" data-user-id="<%= admin.id %>" onclick="deactivateOrActive(this.getAttribute('data-user-id'))">
                          <i class="fas fa-user-check"></i>
                          Activate
                        </button>
                        <% } %>
                      </td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
    
      </div>
    </div>
    
  </div>
<!-- modal satart  -->
    <div class="row">
      <div class="col-12">
        <div class="card-body">
          <!-- Modal body starts for users -->
          <div class="modal fade bd-example-modal-lg" id="Adduser" tabindex="-1" role="dialog"
            aria-labelledby="myLargeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
              <div class="modal-content">
                <div class="modal-header"style="background: linear-gradient(135deg, #fdfcfb 0%, #fbffdc 100%);">
                  <h6 class="modal-title m-0 text-dark" id="myLargeModalLabel">
                    Add New User
                  </h6>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <!--end modal-header-->
                <div class="modal-body">
                  <form id="user_form">
                    <div class="row">
                      <div class="col-md-6 card p-4">
                        <!-- First Name and Last Name in one row -->
                        <div class="row mb-2">
                          <div class="col-md-6">
                            <label class="form-label" for="fname">First Name</label>
                            <input type="text" class="form-control" id="fname" name="firstName"
                              placeholder="Enter first name" style="box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;" />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="lname">Last Name</label>
                            <input type="text" class="form-control" id="lname" name="lastName"
                              placeholder="Enter last name" style="box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;" />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="userPhoto">upload photo</label>
                            <input type="file" id="userPhoto" accept="image/*" />
                             
                          </div>
                        </div>
                      
                        <!-- Email in one row -->
                        <div class="row mb-2">
                          <div class="col-12">
                            <label class="form-label" for="useremail">Email</label>
                            <input type="email" class="form-control" id="useremail" name="email"
                              placeholder="Enter email" style="box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;" />
                          </div>
                        </div>
                      
                        <!-- Password and Confirm Password in one row -->
                        <div class="row mb-2">
                          <div class="col-md-6">
                            <label class="form-label" for="userpassword">Password</label>
                            <input type="password" class="form-control" name="password" id="userpassword"
                              placeholder="Enter password" style="box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;" />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="Confirmpassword">Confirm Password</label>
                            <input type="password" class="form-control" name="confirmpassword" id="Confirmpassword"
                              placeholder="Enter confirm password" required style="box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;" />
                            <span id="passwordMismatchError" style="color: red; display: none;">Passwords do not match.</span>
                          </div>
                        </div>
                      </div>
                <div class="mb-3">
                  <label class="form-label d-block">User Type:</label>

                  <!-- Client option disabled -->
                  <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="userType" id="client" value="client" disabled>
                    <label class="form-check-label" for="client">Client</label>
                  </div>

                  <!-- User option selected by default -->
                  <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="userType" id="user" value="user" checked>
                    <label class="form-check-label" for="user">User</label>
                  </div>
                </div>

                      <select name="roleId" class="form-control">
                        <% roles.forEach(role => { %>
                          <option value="<%= role.id %>"><%= role.name %></option>
                        <% }) %>
                      </select>
                        <!-- Second Row: Mobile Number -->
                        <div class="mb-3">
                          <label class="form-label" for="mobileNo">Mobile Number</label>
                          <input type="text" class="form-control" id="mobileNo" maxlength="10" name="mobileNo" placeholder="Enter 10-digit phone number" style="box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;" />
                        </div>
                      
                    

                        <div class="mt-2 text-end">
                          <button type="button" class="btn btn-primary btn-sm" id="submit_users">
                            Submit
                          </button>
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                            Close
                          </button>
                        </div>
                      </div>
                      
                    </div>

                    
                  </form>


                  <!--end form-->
                </div>
                <!--end modal-body-->
              </div>
              <!--end modal-content-->
            </div>
            <!--end modal-dialog-->
          </div>

          <!--end modal-->
        </div>
        <!--end card-body-->
      </div>
      <div class="col-12">
        <div class="card-body">
          <div class="modal bd-example-modal-lg" id="ViewUserModal" tabindex="-1" role="dialog"
            aria-labelledby="myLargeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
              <div class="modal-content">
                <div class="modal-header"  style="background-color: #9acbff24;">
                  <h6 class="modal-title m-0" id="myLargeModalLabel" style="color: #000;">
                    View User
                  </h6>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <!--end modal-header-->
                <div class="modal-body">
                  <form id="view_form">
                    <div class="row">
                      <!-- First Column - 6 units wide for inputs -->
                      <div class="col-md-6 card p-4">
                        <!-- First Name and Last Name in one row -->
                        <div class="row mb-2">
                          <div class="col-md-6">
                            <label class="form-label" for="fname">First Name</label>
                            <input type="text" class="form-control" id="fnameview" name="firstname" placeholder="Enter first name" readonly />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="lname">Last Name</label>
                            <input type="text" class="form-control" id="lnameview" name="lastname" placeholder="Enter last name" readonly />
                          </div>
                        </div>
                
                        <!-- Email -->
                        <div class="row mb-2">
                          <div class="col-12">
                            <label class="form-label" for="useremail">Email</label>
                            <input type="email" class="form-control" id="useremailview" name="useremail" placeholder="superadmin@dispatch.co.in" readonly />
                          </div>
                        </div>
                
                        <!-- Password -->
                        <div class="row mb-2">
                          <div class="col-md-6">
                            <label class="form-label" for="userpassword">Password</label>
                            <input type="text" class="form-control" id="userpasswordview" name="password" placeholder="••••••" readonly />
                          </div>
                        </div>
                      </div>
                      <!-- End of First Column -->
                
                      <!-- Second Column - 6 units wide for inputs -->
                      <div class="col-md-6 card p-4">
                        <!-- Choose User Type and Select Client in one row -->
                        <div class="row mb-2">
                          <div class="col-md-6">
                            <label class="form-label" for="userType">User  Type</label>
                            <div>
                              <span id="userTypeDisplay"></span>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="clientSelect">Selected Client</label>
                            <input type="text" class="form-control" id="clientSelect" name="client" placeholder="Choose Client Name" readonly />
                          </div>
                        </div>
                
                        <!-- Mobile Number in one row (spanning full width) -->
                        <div class="row mb-2">
                          <div class="col-12">
                            <label class="form-label" for="viewmobileNo">Mobile Number</label>
                            <input type="text" class="form-control" id="viewmobileNo" name="viewmobileNo" placeholder="Enter 10-digit phone number" maxlength="10" readonly />
                          </div>
                        </div>
                        <!-- Select Role and Select Reporting User in one row -->
                        <div class="row mb-2">
                          <div class="col-md-6">
                            <label class="form-label" for="viewroleSelect">Selected Role</label>
                            <input type="text" class="form-control" id="viewroleSelect" name="role" placeholder="Choose a role" readonly />
                          </div>
                          <div class="col-md-6">
                            <label class="form-label" for="viewreportingUserSelect">Selected Reporting User</label>
                            <input type="text" class="form-control" id="viewreportingUserSelect" name="reportingUser " placeholder="Choose Reporting User" readonly />
                          </div>
                        </div>
                      </div>
                      <!-- End of Second Column -->
                
                      <!-- Close button -->
                      <div class="mt-2 text-end">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                          Close
                        </button>
                      </div>
                    </div>
                  </form>
                </div>
                <!--end modal-body-->
              </div>
              <!--end modal-content-->
            </div>
            <!--end modal-dialog-->
          </div>
        </div>
      </div>


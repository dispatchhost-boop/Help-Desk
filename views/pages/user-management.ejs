    /* Style the active pagination button */
    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
      background-color: rgb(246, 246, 253) !important; /* Set background color to blue */
      color: white !important;          /* Set text color to white */
      border: none !important;          /* Remove border */
      border-radius: 4px;               /* Add slight rounding */
    }
  
    /* Hover effect for pagination buttons */
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
      background-color: lightblue !important; /* Light blue on hover */
      color: white !important;                /* Ensure text is white */
    }
  
   
  
    /* Add spacing between the filter/search bar and the table */
    .dataTables_wrapper .dataTables_filter {
      margin-bottom: 16px; /* Add gap below the filter */
    }
  
    /* Optional: Search input box custom styling */
    .dataTables_wrapper .dataTables_filter input {
      border: 1px solid lightgray;       /* Add a border to the search input */
      border-radius: 4px;                /* Slight rounding */
      padding: 4px 8px;                  /* Add some padding */
    }
  </style>
  
</head>
 

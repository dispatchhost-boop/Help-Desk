}

function saveEditUser () {
  const updatedData = new FormData(); // Use FormData to handle file uploads
  updatedData.append('id', userId); // Use the stored userId

  // Check if elements exist before accessing their values
  const firstNameInput = document.getElementById('fnameedit');
  const lastNameInput = document.getElementById('lnameedit');
  const emailInput = document.getElementById('useremailedit');
  const mobileNoInput = document.getElementById('EditmobileNo');
  const reportingUserSelect = document.getElementById('EditreportingUserSelect');
  const roleSelect = document.getElementById('roleSelectInEdit');
  const newPasswordInput = document.getElementById('NewUserPassword');
  const confirmPasswordInput = document.getElementById('ConfirmNewpassword');

  if (firstNameInput) updatedData.append('first_name', firstNameInput.value);
  if (lastNameInput) updatedData.append('last_name', lastNameInput.value);
  if (emailInput) updatedData.append('email', emailInput.value);
  if (mobileNoInput) updatedData.append('mobile_no', mobileNoInput.value);
  if (reportingUserSelect) updatedData.append('reporting_user_id', reportingUserSelect.value);
  if (roleSelect) updatedData.append('role_id', roleSelect.value);

  // Get the new password
  const newPassword = newPasswordInput ? newPasswordInput.value : '';
  const confirmPassword = confirmPasswordInput ? confirmPasswordInput.value : '';

  // Only include the password in the updatedData if it's provided
  if (newPassword) {
    if (newPassword === confirmPassword) {
      updatedData.append('password', newPassword); // Add password to the data to be sent
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Passwords do not match!',
      });
      return; // Exit the function if passwords do not match
    }
  }

  // Handle file upload
  const userPhotoEdit = document.getElementById('userPhotoedit').files[0]; // Get the selected file
  if (userPhotoEdit) {
    updatedData.append('photo', userPhotoEdit); // Append the file to FormData
  }

  // Send the updated data to the backend for saving
  axios.post(`/admin/edit`, updatedData, {
    headers: {
      'Content-Type': 'multipart/form-data' // Set the content type for file upload
    }
  })
  .then(response => {
    if (response.data.success) {
      // Handle success
      Swal.fire({
        icon: 'success',
        title: 'Success',
        text: response.data.message || 'User  data updated successfully',
      }).then(() => {
        // Redirect to user management page after closing the alert
        window.location.href = '/user-management';
      });
      // Close modal
      var editUserModal = bootstrap.Modal.getInstance(document.getElementById('EditUserModal'));
      editUserModal.hide();
    } else {
      // Handle failure
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: response.data.message || 'Failed to update user data',
      });
    }
  })
  .catch(error => {
    // Check if the error response exists and has a message
    if (error.response && error.response.data) {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: error.response.data.message || 'An error occurred while updating user data. Please try again.',
      });
    } else {
      // Handle generic error
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'An unexpected error occurred. Please try again later.',
      });
    }
    console.error('Error updating user data:', error);
  });
}

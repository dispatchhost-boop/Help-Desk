      <script>
        // Function to fetch client data and populate the first dropdown
        async function fetchClientData(userType) {
          try {
            // Clear the user select dropdown
            const companySelect = document.getElementById('companySelect');
            companySelect.innerHTML = '<option selected disabled>Choose Client Name</option>';

            // Make an Axios GET request to the /client-management route
            const response = await axios.get(`/client-management?user_type=${userType}`);
            console.log("Full response:", response);

            if (response.data && Array.isArray(response.data.adminData)) {
              // Loop through the array of company names
              response.data.adminData.forEach(company => {
                const option = document.createElement('option');
                option.value = company.id; // Use company id as the value
                option.textContent = company.company_name; // Display company_name in the dropdown
                companySelect.appendChild(option); // Append the option to the dropdown
              });
            } else {
              console.warn('Invalid data format or empty adminData:', response.data);
            }
          } catch (error) {
            console.error('Error fetching client data:', error);
          }
        }

        // Function to fetch user names (admins) based on the selected company
        async function fetchAndPopulateUsers(companyName) {
          try {
            // Make a POST request to fetch user data based on companyId
            const response = await fetch(`/choose-user?company_name=${encodeURIComponent(companyName)}`, {
              method: 'GET',
              headers: {
                'Content-Type': 'application/json',
              },
            });

            // Check if the response was successful
            const data = await response.json();

            if (response.ok && Array.isArray(data)) {  // Check if data is an array of users
              const userSelect = document.getElementById('userSelect');

              // Clear previous options
              userSelect.innerHTML = '<option selected disabled>Choose a user</option>';

              // Add user options dynamically
              data.forEach(user => {
                const option = document.createElement('option');
                option.value = user.id;  // Set the value to the user id
                option.textContent = `${user.first_name} ${user.last_name}`;  // Display full name in the dropdown
                userSelect.appendChild(option); // Append the option to the dropdown
              });
            } else {
              console.error('Error or invalid data format:', data.message || 'No users found');
            }
          } catch (error) {
            console.error('Error fetching user data:', error);
          }
        }

        


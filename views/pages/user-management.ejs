        function previewImage(event) {
  const file = event.target.files[0];
  const photoPreview = document.getElementById('photoPreview');

  if (file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      photoPreview.src = e.target.result; // Set the src of the image to the file's data URL
      photoPreview.style.display = 'block'; // Show the image
    };
    reader.readAsDataURL(file); // Read the file as a data URL
  } else {
    photoPreview.src = ''; // Clear the image preview if no file is selected
    photoPreview.style.display = 'none'; // Hide the image
  }
}

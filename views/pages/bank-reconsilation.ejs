        <script>
        $(document).ready(function () {
          // Ensure DataTable is initialized only once
          if (!$.fn.DataTable.isDataTable('#datatable_2')) {
            var table = $('#datatable_2').DataTable({
              "ordering": false,
              "searching": true,
              "lengthChange": true,
              "info": false,
              "paging": false,
              "pageLength": 10,
              "pagingType": "full_numbers",
              "dom": '<"d-flex align-items-center gap-3"<"flex-grow-1">>lrtip',
              "language": {
                "lengthMenu": "Show _MENU_ entries",
                "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                "infoEmpty": "Showing 0 to 0 of 0 entries",
                "emptyTable": "No data available in table", 
                "zeroRecords": "No matching records found",
                "paginate": {
                  "first": "<i class='fas fa-angle-double-left'></i>",
                  "previous": "<i class='fas fa-angle-left'></i>",
                  "next": "<i class='fas fa-angle-right'></i>",
                  "last": "<i class='fas fa-angle-double-right'></i>"
                }
              },
              "drawCallback": function () {
                $('.paginate_button').addClass('btn btn-sm').css({
                  'background-color': '#e3f2fd',
                  'border-color': '#90caf9',
                  'color': '#1976d2',
                  'margin': '0 2px',
                  'border-radius': '4px'
                });
      
                $('.paginate_button.current').css({
                  'background-color': '#1976d2',
                  'color': '#fff',
                  'border-color': '#1976d2'
                });
      
                $('.paginate_button.disabled').css({
                  'opacity': '0.5',
                  'cursor': 'not-allowed'
                });
              }
            });
      
            // Custom search functionality
            $('#search-input').on('keyup', function () {
              table.search($(this).val()).draw();
            });
      
            // Search button functionality
            $('#button-addon2').on('click', function () {
              table.search($('#search-input').val()).draw();
            });
          }
        });
      </script>

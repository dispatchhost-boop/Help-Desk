                table-layout: fixed;
              }
              .scrollable-tbody tbody {
                display: block;
                width: 100%;
              }
              .scrollable-tbody tr {
                display: table;
                width: 100%;
                table-layout: fixed;
              }
              @media (max-width: 768px) {

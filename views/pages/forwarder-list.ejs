                      <form id="zone_form_Express">
                        <div class="container mt-4 p-3">
                          <div id="zones-container">
                            <!-- Initial Zone Row -->
                            <div class="row mb-3 zone-row">
                              <div class="col-md-2">
                                <label for="zone" class="form-label text-black">Zones</label>
                                <input type="text" class="form-control zone-name" value="A" readonly
                                  style="padding: 11px;">
                              </div>
                              <div class="col-md-3">
                                <label for="select-rule" class="form-label text-black">Select Rules</label>
                                <div class="d-flex">
                                  <select class="form-select select-rule">
                                    <option value="WITHIN-NCR">WITHIN NCR</option>
                                    <option value="WITHIN-CITY">WITHIN CITY</option>
                                    <option value="WITHIN-STATE">WITHIN STATE</option>
                                    <option value="WITHIN-ZONE">WITHIN-ZONE</option>
                                    <option value="WITHIN-METRO">WITHIN-METRO</option>
                                    <option value="WITHIN-SPECIAL ZONE">WITHIN-SPECIAL ZONE</option>
                                    <option value="WITHIN-ROI">ROI</option>


                                  </select>
                                  <button type="button" class="btn btn-sm btn-primary ms-2"
                                    onclick="addNewOption(this)">+
                                    Rule</button>
                                  <button type="button" class="btn btn-sm btn-danger ms-2" onclick="removeRule(this)">-
                                    Rule</button>
                                </div>
                              </div>
                              <div class="col-md-2">
                                <label for="state_select_for_city" class="form-label text-black">Filter City By
                                  State</label>
                                <select class="form-select state-select" name="state_select[]" id="state-select"
                                  multiple>
                                  <% states.forEach(state=> { %>
                                    <option value="<%= state %>">
                                      <%= state %>
                                    </option>
                                    <% }) %>
                                </select>
                              </div>
                              <div class="col-md-2">
                                <label for="city_select" class="form-label text-black">Cities</label>
                                <select class="form-select city-select" id="city-select" multiple>
                                  <option value="">Select a city</option>
                                </select>
                              </div>
                              <div class="col-md-2">
                                <label for="state" class="form-label text-black">Select State</label>
                                <select class="form-select state select2" name="state_select[]" id="state" multiple>
                                  <% states.forEach(state=> { %>
                                    <option value="<%= state %>">
                                      <%= state %>
                                    </option>
                                    <% }) %>
                                </select>
                              </div>
                            </div>
                          </div>
                          <button type="button" class="btn btn-primary" id="add-zone">Add More Zones</button>
                        </div>
                      </form>


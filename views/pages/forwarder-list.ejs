                async function saveExpressRateList() {
                  try {
                    // Get vendor ID from modal
                    const modalElement = document.getElementById('ExpressRateListModal');
                    const vendorId = modalElement.getAttribute('data-vendor-id');

                    if (!vendorId) {
                      throw new Error('Vendor ID not found');
                    }

                    const form = document.getElementById('std_courier_rate_list');
                    const slabs = document.querySelectorAll('#second-row-container .card');
                    const formData = [];

                    // Collect data from each slab
                    slabs.forEach((slab, slabIndex) => {
                      // Get weight slab data
                      const weightSlabData = {
                        min: slab.querySelector(`[name="weightSlabs[${slabIndex}][min]"]`).value,
                        max: slab.querySelector(`[name="weightSlabs[${slabIndex}][max]"]`).value,
                        unit: slab.querySelector(`[name="weightSlabs[${slabIndex}][unit]"]`).value
                      };

                      // Get zone values
                      const zoneData = {};
                      ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'].forEach(zone => {
                        const zoneInput = slab.querySelector(`[name="zones[${slabIndex}][${zone}]"]`);
                        if (zoneInput && zoneInput.value) {
                          zoneData[zone] = zoneInput.value;
                        }
                      });

                      // Get additional charges
                      const additionalCharges = [];
                      const chargeInputs = slab.querySelectorAll(`[name^="additionalCharges[${slabIndex}]"]`);
                      const chargeGroups = {};

                      chargeInputs.forEach(input => {
                        const match = input.name.match(/additionalCharges\[(\d+)\]\[(\d+)\]\[(\w+)\]/);
                        if (match) {
                          const [_, slabIdx, chargeIdx, field] = match;
                          if (!chargeGroups[chargeIdx]) {
                            chargeGroups[chargeIdx] = {};
                          }
                          chargeGroups[chargeIdx][field] = input.value;
                        }
                      });

                      // Get additional amounts for each charge
                      Object.keys(chargeGroups).forEach(chargeIdx => {
                        const amountData = {};
                        ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'].forEach(zone => {
                          const amountInput = slab.querySelector(`[name="additionalAmount[${slabIndex}][${chargeIdx}][${zone}]"]`);
                          if (amountInput && amountInput.value) {
                            amountData[zone] = amountInput.value;
                          }
                        });

                        if (Object.keys(chargeGroups[chargeIdx]).length > 0) {
                          additionalCharges.push({
                            ...chargeGroups[chargeIdx],
                            amounts: amountData
                          });
                        }
                      });

                      // Only add slab if it has data
                      if (weightSlabData.min || weightSlabData.max || Object.keys(zoneData).length > 0) {
                        formData.push({
                          weightSlab: weightSlabData,
                          zones: zoneData,
                          additionalCharges: additionalCharges
                        });
                      }
                    });

                    console.log('Saving data:', formData);

                    // Send data to server
                    const response = await axios.put(`/api/express-rate-list/${vendorId}`, {
                      slabs: formData
                    });

                    if (response.data.success) {
                      Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: 'Express rate list saved successfully'
                      }).then(() => {
                        $('#ExpressRateListModal').modal('hide');
                        window.location.reload();
                      });
                    } else {
                      throw new Error(response.data.message || 'Failed to save rate list');
                    }

                  } catch (error) {
                    console.error('Error saving Express rate list:', error);
                    Swal.fire({
                      icon: 'error',
                      title: 'Error',
                      text: error.message || 'Failed to save Express rate list'
                    });
                  }
                }

                async function saveExpressZoneMapping() {
                  try {
                    // Show loading
                    Swal.fire({
                      title: 'Saving...',
                      allowOutsideClick: false,
                      didOpen: () => {
                        Swal.showLoading();
                      }
                    });

                    // Get vendor ID from modal
                    const vendorId = document.getElementById('ExpressZoneMappingModal').getAttribute('data-vendor-id');

                    // Get all zone rows
                    const zoneRows = document.querySelectorAll('.zone-row');
                    const zones = [];

                    // Process each zone row
                    for (const row of zoneRows) {
                      const zoneName = row.querySelector('.zone-name').value;
                      const rule = row.querySelector('.select-rule').value;

                      // Get cities and states using Select2
                      const cities = $(row.querySelector('.city-select')).select2('data').map(item => item.id);
                      const states = $(row.querySelector('.state')).select2('data').map(item => item.id);

                      // Only add if we have a zone name and rule
                      if (zoneName && rule) {
                        zones.push({
                          zoneName,
                          rule,
                          cities: cities || [],
                          states: states || []
                        });
                      }
                    }

                    // Validate if we have any zones
                    if (zones.length === 0) {
                      throw new Error('Please add at least one zone with data');
                    }

                    // Send data to server
                    const response = await axios.post('/api/Express-zone-mapping/save', {
                      vendor_id: vendorId,
                      zones: zones
                    });

                    if (response.data.success) {
                      Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: 'Zone mapping saved successfully'
                      }).then(() => {
                        // Close modal
                        const modal = bootstrap.Modal.getInstance(document.getElementById('ExpressZoneMappingModal'));
                        if (modal) {
                          modal.hide();
                          window.location.reload();
                        }
                      });
                    } else {
                      throw new Error(response.data.error || 'Failed to save zone mapping');
                    }

                  } catch (error) {
                    console.error('Error saving zone mapping:', error);
                    Swal.fire({
                      icon: 'error',
                      title: 'Error',
                      text: error.message || 'Failed to save zone mapping'
                    });
                  }
                }



                async function saveExpressTAT() {
                  try {
                    const form = document.getElementById('std_tat_mapping');
                    const formData = new FormData(form);
                    const vendor_id = formData.get('vendor_id');

                    // Convert FormData to object
                    const zones = {};
                    formData.forEach((value, key) => {
                      if (key.startsWith('zones[')) {
                        const zone = key.match(/\[(.*?)\]/)[1];
                        zones[zone] = value;
                      }
                    });

                    const response = await axios.post('/api/Express-tat/save', {
                      vendor_id,
                      zones
                    });

                    if (response.data.success) {
                      Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: 'Express TAT saved successfully'
                      }).then(() => {
                        const modal = bootstrap.Modal.getInstance(document.getElementById('ExpressTATModal'));
                        modal.hide();
                        window.location.reload();
                      });
                    }
                  } catch (error) {
                    console.error('Error:', error);
                    Swal.fire({
                      icon: 'error',
                      title: 'Error',
                      text: 'Failed to save Express TAT'
                    });
                  }
                }

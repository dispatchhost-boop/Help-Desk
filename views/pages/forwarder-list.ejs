              <!-- Add necessary styles -->

              <script>
                document.addEventListener('DOMContentLoaded', function () {
                  const chargeSelects = document.querySelectorAll('.charge_select');
                  const conditionSelects = document.querySelectorAll('.condition_select');
                  const criteriaSelects = document.querySelectorAll('.charge_select[id$="_criteria_charge"]');

                  // Create a map to store the disabled options for each criteria dropdown
                  const disabledOptions = new Map();

                  function toggleChargeSelection() {
                    const charge = this.value;
                    const condition = this.closest('.row').querySelector('.condition_select').value;
                    const chargeSelectionDiv = this.closest('.row').querySelector('.chargeSelection');

                    if (chargeSelectionDiv) {
                      // Only toggle visibility for conditions where the value is 'or'
                      if (condition === 'or') {
                        chargeSelectionDiv.style.setProperty('display', 'block', 'important');
                      } else {
                        chargeSelectionDiv.style.setProperty('display', 'none', 'important');
                      }
                    }
                  }
                  function updateCriteriaOptions() {
                    const charge = this.value;
                    const criteriaSelect = this.closest('.row').querySelector('.charge_select[id$="_criteria_charge"]');
                    const minCriteriaSelect = this.closest('.row').querySelector('.charge_select:not([id$="_criteria_charge"])');

                    if (criteriaSelect && minCriteriaSelect) {
                      const options = criteriaSelect.options;
                      const minOptions = minCriteriaSelect.options;
                      const key = criteriaSelect.id;

                      // Store current selection
                      const currentSelection = criteriaSelect.value;

                      // Re-enable all options first
                      Array.from(options).forEach(option => {
                        option.disabled = false;
                      });

                      // Disable the selected charge in both dropdowns
                      if (charge) {
                        Array.from(options).forEach(option => {
                          if (option.value === charge) {
                            option.disabled = true;
                          }
                        });
                      }

                      // Restore previous selection if it's still valid
                      if (currentSelection && !criteriaSelect.querySelector(`option[value="${currentSelection}"]`).disabled) {
                        criteriaSelect.value = currentSelection;
                      }

                      // Update disabled options map
                      if (!disabledOptions.has(key)) {
                        disabledOptions.set(key, []);
                      }
                      disabledOptions.set(key, Array.from(options).filter(opt => opt.disabled));
                    }
                  }

                  chargeSelects.forEach((select) => {
                    select.addEventListener('change', toggleChargeSelection);
                    select.addEventListener('change', updateCriteriaOptions);
                  });

                  conditionSelects.forEach((select) => {
                    select.addEventListener('change', toggleChargeSelection);
                  });
                });
              </script>



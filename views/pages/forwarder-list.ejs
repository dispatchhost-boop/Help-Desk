<!DOCTYPE html>
<html lang="hi">

<head>
  <%- include('../partials/head') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="assets/libs/mobius1-selectr/selectr.min.css" rel="stylesheet" type="text/css" />
    <link href="assets/libs/huebee/huebee.min.css" rel="stylesheet" type="text/css" />
    <link href="assets/libs/vanillajs-datepicker/css/datepicker.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.1/css/dataTables.bootstrap4.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
      table.dataTable.no-footer {
        border-bottom: 1px solid #e9e9e9 !important;
      }

      table.dataTable thead th,
      table.dataTable thead td {
        padding: 10px 18px;
        border-bottom: 1px solid #f0eded !important;
      }

      table.dataTable tbody tr {
        background: linear-gradient(135deg, #fdfcfb 0%, #fbffdc 100%);
        ;
      }

      .select2 {
        overflow-y: auto;
        /* max-height: 80px; */
        /* adjust this value to your desired height */
      }

      .select2-search__field {
        width: 200px !important;
      }


      .form-label {
        font-weight: 500;
        margin-bottom: 0.5rem;
      }

      .form-control {
        font-size: 10px;
      }



      .btn-close:focus {
        box-shadow: none;
      }


      .charges-section {
        display: flex;
        justify-content: space-between;
        text-align: center;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 10px;
      }

      h5 {

        color: #5a99fc !important;
        text-transform: uppercase;

        font-weight: 700;

      }

      .modal-content .modal-header {
        background-color: #f0ffff !important;
      }

      .modal-title,
      h5 {
        color: #303e67 !important;
      }

      .form-section {
        background-color: #f0ffff;
        padding: 1rem;
        /* margin-bottom: 1rem; */
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
        font-size: 14px;
      }

      @media (min-width: 992px) {

        .modal-lg,
        .modal-xl {
          --bs-modal-width: 1061px;
        }

        .alert-info {
          background-color: #ecf1ff;
          font-size: 14px;
        }
      }
    </style>
</head>

<body data-theme="light" class="font-nunito">
  <div id="wrapper" class="theme-cyan">

    <!-- HEADER -->
    <%- include('../partials/header') %>

      <!-- SIDEBAR -->
      <%- include('../partials/left-sidebar') %>
        <%- include('../partials/right-iconbar') %>

          <!-- MAIN CONTENT -->
          <div id="main-content">
            <div class="container-fluid">
              <div class="block-header">
                <div class="row">
                  <div class="col-lg-6 col-md-6 col-sm-12">
                    <h2>Configuration</h2>
                    <ul class="breadcrumb">
                      <li class="breadcrumb-item">
                        <a href="/"><i class="fa fa-dashboard"></i></a>
                      </li>
                      <li class="breadcrumb-item">Configuration</li>
                      <li class="breadcrumb-item active">courier List</li>
                    </ul>
                  </div>
                  <!-- <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="d-flex flex-row-reverse">
                  <div class="page_action">
                    <button type="button" class="btn btn-primary">
                      <i class="fa fa-download"></i> Download report
                    </button>
                    <button type="button" class="btn btn-secondary">
                      <i class="fa fa-plus"></i> Add new
                    </button>
                  </div>
                  <div class="p-2 d-flex"></div>
                </div>
              </div> -->
                </div>
              </div>

              <!-- Add your page-specific content here -->

              <div class="row mb-5">


                <div class="col-md-3">
                  <form class="d-flex">
                    <div class="input-group">
                      <input type="text" class="form-control" id="search-input" placeholder="Search" aria-label="Search"
                        aria-describedby="basic-addon2">
                      <button class="btn btn-soft-secondary" type="button" id="button-addon2">
                        <i class="fas fa-search"></i>
                      </button>
                    </div>

                  </form>
                </div>

                <table class="table" id="courier_details">
                  <thead>
                    <tr>
                      <th>S.No</th>
                      <th>courier Name</th>
                      <th>Service Type</th>
                      <th>Category</th>
                      <th>Variant</th>
                      <th>Volume/shipment</th>
                      <th>Action</th>
                      
                      <!-- Action column -->
                    </tr>
                  </thead>
                  <tbody>
                    <% if (result && result.length> 0) { %>
                      <% let serialNumber=1; %>
                        <% result.forEach((vendor)=> { %>
                          <%
                              // Use only Tagged_api for logo path logic
                              const taggedApi = (vendor.Tagged_api || '').toLowerCase();
                              let logoPath = '/assets/images/logos/logo-dark.png';
                              
                              if (taggedApi.includes('delhivery')) {
                                logoPath = '/assets/images/logos/delhivery.png';
                              } else if (taggedApi.includes('xpress') || taggedApi.includes('xpressbees')) {
                                logoPath = '/assets/images/logos/expressbees.png'; 
                              } else if (taggedApi.includes('dtdc')) {
                                logoPath = '/assets/images/logos/dtdc.png';
                              } else if (taggedApi.includes('bluedart')) {
                                logoPath = '/assets/images/BlueDart.png';
                              } else if (taggedApi.includes('fedex')) {
                                logoPath = '/assets/images/FedEx.png';
                              } else if (vendor.logo_path) {
                                logoPath = vendor.logo_path;
                              }
                            %>
                          <tr>
                            <td>
                              <%= serialNumber++ %>
                            </td>
                            <td>
                              <div class="d-flex align-items-center">
                                <img src="<%= logoPath %>" 
                                     alt="<%= vendor.company_name %>"
                                     class="rounded border me-2"
                                     style="width: 75px;height: 60px;object-fit: contain;padding: 5px;">
                                <span><%= vendor.company_name %></span>
                              </div>
                            </td>
                            <td>
                              <%= vendor.service_type %>
                            </td>
                            <td>
                              <%= vendor.courier_type %>
                            </td>
                             <td>
                            <% if (vendor.delhivery_api_variant == 1) { %>
                              <span class="badge bg-info">Dispatch</span>
                            <% } else if (vendor.delhivery_api_variant == 2) { %>
                              <span class="badge bg-success">QuickNFly</span>
                            <% } else { %>
                              <span class="badge bg-secondary">Normal</span>
                            <% } %>
                            </td>
                            <td>
                              <% if (vendor.packet_shipment == 0) { %>
                                <% if (vendor.business_volume == 1) { %>
                                  <span class="badge badge-info">Basic</span><br><small>(0 - 25,000)</small>
                                <% } else if (vendor.business_volume == 2) { %>
                                  <span class="badge badge-info">Lite</span><br><small>(25,001 - 50,000)</small>
                                <% } else if (vendor.business_volume == 3) { %>
                                  <span class="badge badge-info">LitePro</span><br><small>(50,001 - 100,000)</small>
                                <% } else if (vendor.business_volume == 4) { %>
                                  <span class="badge badge-info">Premium</span><br><small>(100,001 - 250,000)</small>
                                <% } else if (vendor.business_volume == 5) { %>
                                  <span class="badge badge-info">Advance</span><br><small>(250,001 - 500,000)</small>
                                <% } else if (vendor.business_volume == 6) { %>
                                  <span class="badge badge-info">AdvancedPro</span><br><small>(500,001+)</small>
                                <% } else if (vendor.business_volume == 7) { %>
                                  <span class="badge badge-info">Enterprise</span>
                                <% } %>
                              <% } else { %>
                                <% if (vendor.packet_shipment == 1) { %>
                                  <span>0-500(PKT)</span>
                                <% } else if (vendor.packet_shipment == 2) { %>
                                  <span>500-1000(PKT)</span>
                                <% } else if (vendor.packet_shipment == 3) { %>
                                  <span>1000-1500(PKT)</span>
                                <% } else if (vendor.packet_shipment == 4) { %>
                                  <span>1500-2000(PKT)</span>
                                <% } else if (vendor.packet_shipment == 5) { %>
                                  <span>2000-2500(PKT)</span>
                                <% } else if (vendor.packet_shipment == 6) { %>
                                  <span>2500-3000(PKT)</span>
                                <% } else if (vendor.packet_shipment == 7) { %>
                                  <span>3000-3500(PKT)</span>
                                <% } else if (vendor.packet_shipment == 8) { %>
                                  <span>3500-4000(PKT)</span>
                                <% } else if (vendor.packet_shipment == 9) { %>
                                  <span>4000+</span>
                                <% } %>
                              <% } %>
                            </td>

                            <td>
                              <div style="display: flex; gap: 2px;"> <!-- Added flex container for buttons -->
                                <!-- Edit Dropdown -->
                                <div class="dropdown">
                                  <button class="btn  btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">

                                    <i class="fas fa-edit" style="color:#5a99fc"></i>
                                  </button>
                                  <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#"
                                        onclick="editParentalDetails('<%= vendor.id %>')">Parental Details</a></li>
                                    <!-- <li><a class="dropdown-item" href="#" onclick="editDepartmentalInfo('<%= vendor.id %>')">Departmental Information</a></li> -->
                                    <li><a class="dropdown-item" href="#"
                                        onclick="editAdditionalCharges('<%= vendor.id %>','<%= vendor.courier_type%>')">Additional
                                        Charges</a></li>
                                    <% if (vendor.courier_type.toLowerCase()==='ltl' ) { %>
                                      <li>
                                        <hr class="dropdown-divider">
                                      </li>
                                      <li><a class="dropdown-item" href="#"
                                          onclick="editLTLRateList('<%= vendor.id %>')">LTL Rate
                                          List</a></li>
                                      <li><a class="dropdown-item" href="#"
                                          onclick="editLTLZoneMapping('<%= vendor.id %>')">LTL
                                          Zone Mapping</a></li>
                                      <li><a class="dropdown-item" href="#" onclick="editLTLTAT('<%= vendor.id %>')">LTL
                                          TAT</a>
                                      </li>
                                      <% } else if (vendor.courier_type.toLowerCase()==='express' ) { %>
                                        <li>
                                          <hr class="dropdown-divider">
                                        </li>
                                        <li><a class="dropdown-item" href="#"
                                            onclick="editExpressRateList('<%= vendor.id %>')">Express Rate List</a>
                                        </li>
                                        <!-- <li><a class="dropdown-item" href="#"
                                            onclick="editExpressZoneMapping('<%= vendor.id %>')">Express Zone
                                            Mapping</a></li>
                                        <li><a class="dropdown-item" href="#"
                                            onclick="editExpressTAT('<%= vendor.id %>')">Express TAT</a></li> -->
                                        <% } %>
                                  </ul>
                                </div>

                                <!-- Delete Button -->
                                <button class="btn  btn-sm" onclick="deletecourier('<%= vendor.id %>')">
                                  <i class="fas fa-trash" style="color:rgb(255, 159, 159)"></i>
                                </button>
                              </div>
                            </td>
                          </tr>
                          <% }) %>
                            <% } else { %>
                              <tr>
                                <td colspan="5">No couriers found.</td>
                                <!-- Updated colspan to match number of columns -->
                              </tr>
                              <% } %>
                  </tbody>
                </table>

                <!-- Add this after your table -->


              </div>
              <div class="modal" id="editcourierModal" tabindex="-1" aria-labelledby="editcourierModalLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="editcourierModalLabel">Edit courier</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body"
                      style="max-height: 73vh;overflow-y: auto;overflow-y: scroll;scrollbar-color: #cae5ff #ffffff;scrollbar-width: thin;background-color: #f6fcff;border-radius: 16px;">
                      <form id="basicInfo">
                        <div class="p-2">
                          <!-- Basic Details Section -->
                          <div class="row mb-3 form-section">
                            <div class="col-md-6 ">
                              <div class="row p-1" style="display: flex;align-items: center;">
                                <div class="col-2">
                                  <i class="bi bi-send"></i>
                                </div>
                                <div class="col-10">
                                  <h5 class="text-uppercase mb-0">courier Basic Details</h5>
                                </div>
                              </div>
                              <div class="row p-3">
                                <div class="col-12 mb-3">
                                  <label for="companyName">courier Display Name</label>
                                  <input id="companyName" name="companyName" type="text" class="form-control"
                                    placeholder="Enter courier name" required>
                                </div>
                                <!-- <div class="col-12 mb-3">
                                  <label for="courierName">courier Name</label>
                                  <input id="courierName" name="courierName" type="text" class="form-control"
                                    placeholder="Enter courier contact name">
                                </div> -->
                                <div class="col-md-6 mb-3">
                                  <label for="courier_mobile">Mobile No.</label>
                                  <input id="courier_mobile" maxlength="10" name="courier_mobile" type="tel"
                                    class="form-control" placeholder="Enter 10-digit mobile number">
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="courier_Email">Email Address</label>
                                  <input id="courier_Email" name="courier_Email" type="email" class="form-control"
                                    placeholder="Enter email address">
                                </div>
                                <div class="col-12 mb-3">
                                  <label for="website">Website</label>
                                  <input id="website" name="website" type="url" class="form-control"
                                    placeholder="Enter courier website URL">
                                </div>
                              </div>
                            </div>

                            <!-- Other Basic Details Section -->
                            <div class="col-md-6">
                              <div class="row p-1" style="display: flex;align-items: center;">
                                <div class="col-2">
                                  <i class="bi bi-geo-alt"></i>
                                </div>
                                <div class="col-10">
                                  <h5 class="text-uppercase mb-0">Other Basic Details</h5>
                                </div>
                              </div>
                              <div class="row p-3">
                                <div class="col-12 mb-3">
                                  <label for="companyAddress">Address</label>
                                  <input id="companyAddress" name="companyAddress" class="form-control"
                                    placeholder="Enter complete address">
                                </div>
                                <div class="col-md-4 mb-3">
                                  <label for="companyCountry">Country</label>
                                  <input id="companyCountry" type="text" name="companyCountry" class="form-control"
                                    placeholder="Enter country" pattern="[A-Za-z ]+"
                                    title="Only letters and spaces allowed">
                                </div>
                                <div class="col-md-4 mb-3">
                                  <label for="companyState">State</label>
                                  <input id="companyState" name="companyState" class="form-control"
                                    placeholder="Enter state" pattern="[A-Za-z ]+"
                                    title="Only letters and spaces allowed">
                                </div>
                                <div class="col-md-4 mb-3">
                                  <label for="companyDistrict">City</label>
                                  <input id="companyDistrict" name="companyDistrict" class="form-control"
                                    placeholder="Enter city" pattern="[A-Za-z ]+"
                                    title="Only letters and spaces allowed">
                                </div>
                                <div class="col-12 mb-3">
                                  <label for="inputGroupFile02">Upload Logo</label>
                                  <input type="file" class="form-control" id="inputGroupFile02" name="logo">
                                  <!-- Add preview container -->
                                  <div class="mt-2" id="logoPreview">
                                    <!-- Preview will be shown here -->
                                  </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="fromDate">Contract From</label>
                                  <input class="form-control" type="date" id="fromDate" name="fromDate">
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="fromTo">Contract To</label>
                                  <input class="form-control" type="date" id="fromTo" name="fromTo">
                                </div>
                              </div>
                            </div>
                          </div>

                          <!-- KYC Details Section -->
                          <div class="row mb-3 form-section">
                            <div class="col-md-6">
                              <div class="row p-1" style="display: flex;align-items: center;">
                                <div class="col-2">
                                  <i class="bi bi-clipboard-data"></i>
                                </div>
                                <div class="col-10">
                                  <h5 class="text-uppercase mb-0">KYC Details</h5>
                                </div>
                              </div>
                              <div class="row p-3">
                                <div class="col-md-6 mb-3">
                                  <label for="company_pan">PAN Card</label>
                                  <input id="company_pan" name="company_pan" type="text" class="form-control"
                                    placeholder="Enter PAN number">
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="vat">VAT/TIN No.</label>
                                  <input id="vat" name="vat" type="text" class="form-control"
                                    placeholder="Enter VAT/TIN number">
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="gstNo">GST No.</label>
                                  <input id="gstNo" name="gstNo" type="text" class="form-control"
                                    placeholder="Enter GST number">
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="company_uin">Company UIN</label>
                                  <input id="company_uin" name="company_uin" type="text" class="form-control"
                                    placeholder="Enter UIN">
                                </div>
                              </div>
                            </div>

                            <!-- Banking Details Section -->
                            <div class="col-md-6 ">
                              <div class="row p-1" style="display: flex;align-items: center;">
                                <div class="col-2">
                                  <i class="bi bi-bank"></i>
                                </div>
                                <div class="col-10">
                                  <h5 class="text-uppercase mb-0">Banking Details</h5>
                                </div>
                              </div>
                              <div class="row p-3">
                                <div class="col-md-6 mb-3">
                                  <label for="Bank_account_name">Bank Account Name</label>
                                  <input id="Bank_account_name" name="Bank_account_name" type="text"
                                    class="form-control" placeholder="Enter account name">
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="billingCycle">Billing Cycle</label>
                                  <select id="billingCycle" name="billingCycle" class="form-select">
                                    <option value="">Select cycle</option>
                                    <option value="weekly">Weekly</option>
                                    <option value="fortnight">Fortnight</option>
                                    <option value="monthly">Monthly</option>
                                  </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="accountNumber">Account Number</label>
                                  <input id="accountNumber" name="accountNumber" type="text" class="form-control"
                                    placeholder="Enter account number">
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="account_type">Account Type</label>
                                  <select id="account_type" name="account_type" class="form-select">
                                    <option value="">Select type</option>
                                    <option value="savings">Savings</option>
                                    <option value="current">Current</option>
                                  </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="chooseBank">Bank Name</label>
                                  <select id="chooseBank" name="chooseBank" class="form-select">
                                    <option value="">Select bank</option>
                                    <option value="State Bank Of India">State Bank Of India</option>
                                    <option value="Kotak Mahindra Bank">Kotak Mahindra Bank</option>
                                    <option value="HDFC Bank LTD">HDFC Bank LTD</option>
                                  </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="ifscCode">IFSC Code</label>
                                  <input id="ifscCode" name="ifscCode" type="text" class="form-control"
                                    placeholder="Enter IFSC code">
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </form>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                      <button type="button" class="btn btn-primary" onclick="updatecourier()">Save</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Add new modal for Departmental Information -->
              <div class="modal fade" id="departmentalInfoModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Departmental Information</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body"
                      style="max-height: 73vh;overflow-y: auto;overflow-y: scroll;scrollbar-color: #cae5ff #ffffff;scrollbar-width: thin;background-color: #f6fcff;border-radius: 16px;">
                      <form id="contact_tables_data">
                        <div class="row">
                          <div class="p-1">
                            <div class="card-body">
                              <div class="row">
                                <!-- Sales Section -->
                                <div class="col-md-3 card">
                                  <div id="sales-section">
                                    <div class="row p-1 mb-2" style="background-color: #8fb9ff26">
                                      <div class="col-2">
                                        <i class="fa-solid fa-file-signature p-2"
                                          style="font-size: 22px; color: #5a99f7; border-radius: 5px;"></i>
                                      </div>
                                      <div class="col-10 text-end">
                                        <h5 class="text-uppercase mb-0" style="font-size: small;">Sales Department
                                        </h5>
                                      </div>
                                    </div>
                                    <div class="row p-2">
                                      <div class="col-md-6 mb-2">
                                        <label for="sales_name">Name</label>
                                        <input name="sales_name[]" type="text" class="form-control"
                                          placeholder="Enter Name">
                                      </div>
                                      <div class="col-md-6 mb-2">
                                        <label for="sales_phone">Mobile No.</label>
                                        <input type="text" class="form-control" name="sales_phone[]"
                                          placeholder="Enter Phone Number">
                                      </div>
                                      <div class="col-md-6 mb-2">
                                        <label for="sales_designation">Designation</label>
                                        <input name="sales_designation[]" type="text" placeholder="Enter Designation"
                                          class="form-control">
                                      </div>
                                      <div class="col-md-6 mb-2">
                                        <label for="sales_email">Email Address</label>
                                        <input type="email" class="form-control" name="sales_email[]"
                                          placeholder="Enter Email Address">
                                      </div>
                                      <div class="col-12">
                                        <button type="button" class="btn text-start w-100"
                                          style="color: rgb(93, 5, 93); font-weight: 600;"
                                          onclick="addContact('sales')">
                                          + More Contacts <i class="fa-regular fa-hand-point-right"></i>
                                        </button>
                                      </div>
                                    </div>
                                    <div id="sales-inputs" class="mt-2"></div>
                                  </div>
                                </div>

                                <!-- Operations Section -->
                                <div class="col-md-3 card">
                                  <div id="ops-section">
                                    <div class="row p-1 mb-2" style="background-color: #8fb9ff26">
                                      <div class="col-2">
                                        <i class="fa-solid fa-file-signature p-2"
                                          style="font-size: 22px; color: #5a99f7; border-radius: 5px;"></i>
                                      </div>
                                      <div class="col-10 text-end">
                                        <h5 class="text-uppercase mb-0" style="font-size: small;">Operations
                                          Department</h5>
                                      </div>
                                    </div>
                                    <div class="row p-2">
                                      <div class="col-md-6 mb-2">

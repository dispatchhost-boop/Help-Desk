                // Max limit of zones per row
                const NEW_MAX_ZONES = 11;

                // Function to initialize zone adding functionality
                function initializeNewZoneAdding(row) {
                  let zoneCount = row.querySelectorAll('.new-zone').length;

                  // Add default zone (Zone A) if not already present
                  if (zoneCount === 0) {
                    addNewZone(row);
                    zoneCount++;
                  }

                  // Add new zone on button click
                  row.querySelector('#new-add-zone-btn').addEventListener('click', function () {
                    if (zoneCount < NEW_MAX_ZONES) {
                      addNewZone(row);
                      zoneCount++;
                    } else {
                      alert('Maximum number of zones reached.');
                    }
                  });

                  // Function to add a new zone
                  function addNewZone(row, zoneLabel = null, initialValue = '') {
                    const zoneCount = row.querySelectorAll('.new-zone').length;
                    const zone = document.createElement('div');
                    zone.classList.add('col-1', 'new-zone');
                    zone.style.margin = '25px 0px 0px 10px';

                    // Use provided zoneLabel or generate new one
                    const label = zoneLabel || String.fromCharCode(65 + zoneCount);

                    zone.innerHTML = `
                  <label class="form-label" style="font-weight: bold;">Zone ${label}</label>
                  <div class="d-flex">
                      <input type="text" name="zones[${label}]" class="form-control currency-input" 
                             placeholder="Days" value="${initialValue}">
                  </div>
              `;

                    row.querySelector('#new-zone-container').appendChild(zone);
                    relabelZones(row);
                  }

                  // Relabel zones after any addition
                  function relabelZones(parentRow) {
                    const zones = parentRow.querySelectorAll('.new-zone');
                    zones.forEach((zone, index) => {
                      let label = zone.querySelector('.form-label');
                      let input = zone.querySelector('input');

                      const zoneLabel = String.fromCharCode(65 + index); // A, B, C...

                      // Update label and input name dynamically
                      if (label) label.textContent = `Zone ${zoneLabel}`;
                      if (input) input.name = `zones[${zoneLabel}]`;
                    });
                  }
                }

                // Initialize the default row
                document.querySelectorAll('.new-weight-slab-row').forEach(row => initializeNewZoneAdding(row));


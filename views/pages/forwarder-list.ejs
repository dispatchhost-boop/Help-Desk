                document.addEventListener('DOMContentLoaded', function () {
                  const zoneFileInput = document.getElementById('zoneExcelFile');
                  if (zoneFileInput) {
                    zoneFileInput.addEventListener('change', handleZoneFileUpload);
                  }
                });

                // Global variable to store the processed zone data
                window.processedZoneData = {};

                // Function to handle zone file upload
                function handleZoneFileUpload(e) {
                  const file = e.target.files[0];
                  if (!file) return;

                  const uploadStatus = document.getElementById('zoneUploadStatus');
                  const uploadSuccess = document.getElementById('zoneUploadSuccess');
                  const uploadError = document.getElementById('zoneUploadError');
                  const errorMessage = document.getElementById('zoneErrorMessage');
                  const previewSection = document.getElementById('previewSection');
                  const previewContainer = document.getElementById('zoneMappingPreview');

                  // Show loading status
                  uploadStatus.style.display = 'block';
                  uploadSuccess.style.display = 'none';
                  uploadError.style.display = 'none';
                  previewSection.style.display = 'none';

                  // Use FileReader to read the file
                  const reader = new FileReader();

                  reader.onload = function (e) {
                    try {
                      // Parse the Excel file data
                      const data = new Uint8Array(e.target.result);
                      const workbook = XLSX.read(data, { type: 'array' });

                      // Get the first sheet
                      const firstSheetName = workbook.SheetNames[0];
                      const worksheet = workbook.Sheets[firstSheetName];

                      // Convert to JSON
                      const jsonData = XLSX.utils.sheet_to_json(worksheet);

                      if (jsonData.length === 0) {
                        throw new Error('No data found in the Excel file');
                      }

                      // Process the data
                      processZoneData(jsonData, previewContainer);

                      // Show success and preview
                      uploadStatus.style.display = 'none';
                      uploadSuccess.style.display = 'block';
                      previewSection.style.display = 'block';

                    } catch (error) {
                      console.error('Error processing Excel file:', error);
                      uploadStatus.style.display = 'none';
                      errorMessage.textContent = error.message || 'Failed to process the Excel file';
                      uploadError.style.display = 'block';
                    }
                  };

                  reader.onerror = function () {
                    uploadStatus.style.display = 'none';
                    errorMessage.textContent = 'Failed to read the file';
                    uploadError.style.display = 'block';
                  };

                  reader.readAsArrayBuffer(file);
                }

                function processZoneData(jsonData, previewContainer) {
                  // Reset the processed data
                  window.processedZoneData = {};

                  // Process the data - expecting columns: Zone, City, State
                  jsonData.forEach(row => {
                    const zone = row.Zone || row.zone;
                    const city = row.City || row.city || '';
                    const state = row.State || row.state || '';

                    if (!zone) {
                      console.warn('Row missing zone information:', row);
                      return;
                    }

                    // Process for form update and preview
                    if (!window.processedZoneData[zone]) {
                      window.processedZoneData[zone] = {
                        cities: [],
                        states: []
                      };
                    }

                    if (city && !window.processedZoneData[zone].cities.includes(city)) {
                      window.processedZoneData[zone].cities.push(city);
                    }

                    if (state && !window.processedZoneData[zone].states.includes(state)) {
                      window.processedZoneData[zone].states.push(state);
                    }
                  });

                  // Generate preview HTML in tabular format with grouped zones
                  generateGroupedPreview(window.processedZoneData, previewContainer);

                  // Update the form with the new data
                  updateZoneForm(window.processedZoneData);
                }

                function generateGroupedPreview(processedData, previewContainer) {
                  const zones = Object.keys(processedData);

                  if (zones.length === 0) {
                    previewContainer.innerHTML = '<div class="alert alert-warning">No valid zone data found in the uploaded file.</div>';
                    return;
                  }

                  // Sort zones for better readability
                  zones.sort();

                  // Generate HTML for preview in tabular format with grouped zones
                  let previewHTML = `
              <div class="table-responsive">
                <table class="table table-bordered table-sm">
                  <thead class="table-light">
                    <tr>
                      <th>Zone</th>
                      <th>City</th>
                      <th>State</th>
                    </tr>
                  </thead>
                  <tbody>
            `;

                  // Add rows for each zone with all its cities and states
                  zones.forEach(zone => {
                    const zoneInfo = processedData[zone];
                    const cities = zoneInfo.cities.join(', ');
                    const states = zoneInfo.states.join(', ');

                    previewHTML += `
                <tr>
                  <td>${zone}</td>
                  <td>${cities || '-'}</td>
                  <td>${states || '-'}</td>
                </tr>
              `;
                  });

                  previewHTML += `
                  </tbody>
                </table>
              </div>
            `;

                  previewContainer.innerHTML = previewHTML;
                } // Function to update the zone form with the processed data
                function updateZoneForm(processedData) {
                  const form = document.getElementById('zone_form');
                  if (!form) return;

                  const zones = ['N1', 'N2', 'N3', 'E1', 'E2', 'E3', 'W1', 'W2', 'W3', 'S1', 'S2', 'S3'];

                  zones.forEach(zone => {
                    const citySelect = form.querySelector(`#citySelect${zone}`);
                    const stateSelect = form.querySelector(`#stateSelect${zone}Secondary`);

                    // Clear existing selections
                    if (citySelect) $(citySelect).empty();
                    if (stateSelect) $(stateSelect).empty();

                    if (processedData[zone]) {
                      // Set cities
                      if (citySelect && processedData[zone].cities.length) {
                        processedData[zone].cities.forEach(city => {
                          $(citySelect).append(new Option(city, city, true, true));
                        });
                        $(citySelect).trigger('change');
                      }

                      // Set states
                      if (stateSelect && processedData[zone].states.length) {
                        processedData[zone].states.forEach(state => {
                          $(stateSelect).append(new Option(state, state, true, true));
                        });
                        $(stateSelect).trigger('change');
                      }
                    }
                  });
                }


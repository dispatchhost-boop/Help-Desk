                              <!-- Button to Add Another Slab (Fixed at the Bottom) -->
                              <script>
                                let slabCounter = 1; // Initialize slab count for incremental IDs

                                document.getElementById('duplicateSlab').addEventListener('click', function () {
                                  // Clone the existing slab
                                  let newSlab = document.getElementById('slab-0').cloneNode(true);

                                  // Update the ID of the new slab
                                  newSlab.id = 'slab-' + slabCounter;

                                  // Update the name attributes for inputs to avoid conflicts
                                  const inputs = newSlab.querySelectorAll('input, select');
                                  inputs.forEach(input => {
                                    input.value = ''; // Clear the value of each input field
                                    const name = input.name;
                                    if (name) {
                                      input.name = name.replace(/\[0\]/, `[${slabCounter}]`);
                                    }
                                  });

                                  // Create a container for the delete icon and new slab
                                  let slabWrapper = document.createElement('div');
                                  slabWrapper.style.position = 'relative'; // Relative positioning for icon placement
                                  slabWrapper.classList.add('mb-4', 'mt-5'); // Add margin between slabs

                                  // Create the delete icon
                                  let deleteButton = document.createElement('button');
                                  deleteButton.type = 'button';
                                  deleteButton.style.background = 'none'; // Remove background
                                  deleteButton.style.border = 'none'; // Remove border
                                  deleteButton.style.position = 'absolute';
                                  deleteButton.style.top = '-30px'; // Position above the slab
                                  deleteButton.style.right = '10px'; // Align to the right
                                  deleteButton.style.cursor = 'pointer'; // Show pointer cursor on hover

                                  // Add the dustbin icon
                                  let dustbinIcon = document.createElement('i');
                                  dustbinIcon.classList.add('fa-solid', 'fa-trash'); // Font Awesome trash icon
                                  dustbinIcon.style.color = 'red'; // Set icon color to red
                                  dustbinIcon.style.fontSize = '20px'; // Adjust icon size
                                  deleteButton.appendChild(dustbinIcon);

                                  // Add event listener to delete the slab
                                  deleteButton.addEventListener('click', function (e) {
                                    e.stopPropagation(); // Prevent event bubbling
                                    slabWrapper.remove(); // Remove the slab and button wrapper
                                    resetSlabIds(); // Reset IDs and names of remaining slabs
                                  });

                                  // Append the delete icon and slab to the wrapper
                                  slabWrapper.appendChild(deleteButton);
                                  slabWrapper.appendChild(newSlab);

                                  // Append the wrapper to the #second-row-container
                                  document.getElementById('second-row-container').appendChild(slabWrapper);

                                  // Increment the slab counter
                                  slabCounter++;
                                });

                                // Function to reset slab IDs and names after deletion
                                function resetSlabIds() {
                                  const slabs = document.querySelectorAll('#second-row-container > div');
                                  slabCounter = 0; // Reset slab counter
                                  slabs.forEach((slabWrapper, index) => {
                                    slabCounter = index + 1; // Update slabCounter to match the new order
                                    const slab = slabWrapper.querySelector('.card'); // Find the slab inside the wrapper
                                    slab.id = 'slab-' + index;

                                    // Update the name attributes of inputs and selects
                                    const inputs = slab.querySelectorAll('input, select');
                                    inputs.forEach(input => {
                                      const name = input.name;
                                      if (name) {
                                        input.name = name.replace(/\[\d+\]/, `[${index}]`);
                                      }
                                    });

                                    // Update the delete button label or ID if necessary
                                    const deleteButton = slabWrapper.querySelector('button i');
                                    if (deleteButton) {
                                      deleteButton.parentElement.querySelector('i').textContent = ''; // Optionally update icon if needed
                                    }
                                  });
                                }
                              </script>





                    // Adjust the input names for the next set of charges (incrementing the index)
                    input.name = input.name.replace(/\[0\]/, `[${chargesRowCount}]`);
                    input.id = input.id.replace(/\-0\]/, `-${chargesRowCount}]`);
                    input.value = '';  // Clear the value of the new input fields
                  });

                  // Add the remove button to the new charges row

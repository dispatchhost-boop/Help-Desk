                }
                // Define zones globally
                const zones = [
                  'N1', 'N2', 'N3', 'S1', 'S2', 'S3',
                  'E1', 'E2', 'E3', 'W1', 'W2', 'C1',
                  'NE1', 'NE2', 'C2'

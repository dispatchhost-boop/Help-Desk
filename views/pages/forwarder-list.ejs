                  removeBtn.type = 'button';
                  removeBtn.classList.add('btn', 'btn-sm', 'btn-danger', 'mt-2', 'col-md-1', 'p-1');
                  removeBtn.textContent = 'Remove Row';
                  removeBtn.onclick = () => removeChargesRow(newChargesRow);

                  newChargesRow.appendChild(removeBtn); // Append the remove button to the row

                  // Add the new charges row below the original
                  document.getElementById('chargesRow').parentNode.appendChild(newChargesRow);
                }


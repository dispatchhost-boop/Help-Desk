                async function updateZoneRow(row, data) {
                  try {
                    // Update zone name
                    const zoneInput = row.querySelector('.zone-name');
                    if (zoneInput) zoneInput.value = data.zoneName;

                    // Update rule
                    const ruleSelect = row.querySelector('.select-rule');
                    if (ruleSelect) ruleSelect.value = data.rule;

                    // Get selects
                    const citySelect = row.querySelector('.city-select');
                    const stateSelect = row.querySelector('.state-select');
                    const filterStateSelect = row.querySelector('.state');

                    // Handle rule-specific logic first
                    if (data.rule === 'WITHIN-NCR') {
                      // Only use cities from data, no defaults
                      if (citySelect && data.cities.length > 0) {
                        $(citySelect).empty();
                        data.cities.forEach(city => {
                          $(citySelect).append(new Option(city, city, true, true));
                        });
                        $(citySelect).trigger('change');
                      }

                      // Update states if provided
                      if (stateSelect && data.states.length > 0) {
                        $(stateSelect).val(data.states).trigger('change');
                      }
                    } else {
                      // For other rules, handle states first
                      if (stateSelect && data.states.length > 0) {
                        $(stateSelect).val(data.states).trigger('change');

                        // Fetch cities for selected states
                        try {
                          const response = await axios.get('/getCities', {
                            params: { states: data.states }
                          });

                          if (citySelect) {
                            // Clear existing options
                            $(citySelect).empty();

                            // Add fetched cities and select those that match data
                            response.data.forEach(city => {
                              const isSelected = data.cities.includes(city.city);
                              $(citySelect).append(new Option(city.city, city.city, isSelected, isSelected));
                            });

                            // Trigger change to update Select2
                            $(citySelect).trigger('change');
                          }
                        } catch (error) {
                          console.error('Error fetching cities:', error);
                        }
                      }
                    }

                    // Update filter state select if it exists
                    if (filterStateSelect) {
                      $(filterStateSelect).val(data.states).trigger('change');
                    }

                  } catch (error) {
                    console.error('Error in updateZoneRow:', error);
                    throw error;
                  }
                }


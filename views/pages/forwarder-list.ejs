              <!-- Zone Mapping Modal for LTL -->
              <script>

                $(document).ready(function () {
                  // Initialize Select2 with proper configuration
                  $('.select2').select2({
                    placeholder: "Select states",
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#ltlZoneMappingModal'), // Attach dropdowns to modal
                    multiple: true,
                    closeOnSelect: false
                  });

                  const zones = [
                    'N1', 'N2', 'N3', 'S1', 'S2', 'S3',
                    'E1', 'E2', 'E3', 'W1', 'W2', 'C1',
                    'NE1', 'NE2', 'C2'
                  ];

                  const selectedStates = {};
                  const selectedCities = {};
                  const secondarySelections = {};

                  // Prevent modal from closing on select2 click
                  $(document).on('click', '.select2', function (e) {
                    e.stopPropagation();
                  });

                  function initializeSelect2(skipFetch = false) {
                    $('.select2').each(function () {
                      if ($(this).data('select2')) {
                        $(this).select2('destroy');
                      }
                      $(this).select2({
                        placeholder: "Select states",
                        allowClear: false, // Prevent clearing
                        width: '100%',
                        dropdownParent: $('#ltlZoneMappingModal'),
                        multiple: true,
                        closeOnSelect: false
                      });
                    });

                    if (!skipFetch) {
                      fetchAndPopulateStates();
                    }
                  }

                  function fetchAndPopulateStates() {
                    axios.post('/predispatch/getStatesBasedOnCities', {})
                      .then((response) => {
                        const states = response.data.states;
                        zones.forEach((zone) => {
                          populateStateDropdowns(zone, states);
                        });
                      })
                      .catch((error) => {
                        console.error('Error fetching states:', error);
                      });
                  }

                  function populateStateDropdowns(zone, states) {
                    const $primarySelect = $(`#stateSelect${zone}`);
                    const $secondarySelect = $(`#stateSelect${zone}Secondary`);

                    // Only update if no options exist
                    if (!$primarySelect.find('option').length) {
                      updateDropdown($primarySelect, states, 'Select State');
                    }
                    if (!$secondarySelect.find('option').length) {
                      updateDropdown($secondarySelect, states, 'Select Secondary State');
                    }
                  }

                  function updateDropdown($selector, options, defaultText) {
                    // Don't destroy if it has selected values
                    const currentVal = $selector.val();
                    if (!currentVal || !currentVal.length) {
                      if ($selector.data('select2')) {
                        $selector.select2('destroy');
                      }

                      $selector.empty();

                      options.forEach((option) => {
                        $selector.append(`<option value="${option}">${option}</option>`);
                      });

                      $selector.select2({
                        placeholder: defaultText,
                        allowClear: false,
                        width: '100%',
                        dropdownParent: $('#ltlZoneMappingModal'),
                        multiple: true,
                        closeOnSelect: false
                      });
                    }
                  }

                  // Event handlers for state and city selection
                  zones.forEach((zone) => {
                    $(`#stateSelect${zone}`).on('select2:select select2:unselect', function (e) {
                      e.stopPropagation();
                      selectedStates[zone] = $(this).val() || [];
                      fetchCitiesForZone(zone);
                    });

                    $(`#citySelect${zone}`).on('select2:select select2:unselect', function (e) {
                      e.stopPropagation();
                      selectedCities[zone] = $(this).val() || [];
                    });

                    $(`#stateSelect${zone}Secondary`).on('select2:select select2:unselect', function (e) {
                      e.stopPropagation();
                      secondarySelections[zone] = $(this).val() || [];
                    });
                  });

                  // Initialize when modal is shown
                  $('#ltlZoneMappingModal').on('shown.bs.modal', function () {
                    // Only initialize Select2, don't fetch states
                    initializeSelect2(true);
                  });

                  // Clean up when modal is hidden
                  $('#ltlZoneMappingModal').on('hidden.bs.modal', function () {
                    $('.select2').each(function () {
                      if ($(this).data('select2')) {
                        $(this).select2('destroy');
                      }
                    });
                  });
                });
              </script>

                function addNewOption(button) {
                  const newRule = prompt("Enter the new rule:");

                  if (newRule) {
                    const selectElement = $(button).closest('.d-flex').find('.select-rule');
                    const existingOptions = selectElement.find('option').map((_, option) => $(option).val()).get();

                    if (existingOptions.includes(newRule)) {
                      alert("This rule already exists!");
                    } else {
                      selectElement.append(new Option(newRule, newRule));
                    }
                  }
                }

                function removeRule(button) {
                  const ruleToRemove = prompt("Enter the rule to remove:").trim();

                  if (ruleToRemove) {
                    const selectElement = $(button).closest('.d-flex').find('.select-rule');
                    let ruleFound = false;

                    selectElement.find('option').each(function () {
                      if ($(this).val().trim().toLowerCase() === ruleToRemove.toLowerCase()) {
                        $(this).remove();
                        ruleFound = true;
                        alert(`Rule "${ruleToRemove}" removed successfully.`);
                        return false;
                      }
                    });

                    if (!ruleFound) {
                      alert(`Rule "${ruleToRemove}" not found!`);
                    }
                  } else {
                    alert("No rule entered to remove!");
                  }
                }

                // Function to fetch cities based on selected states
                function fetchCitiesForZone(zone, selectedStates) {
                  // Don't make the request if no states are selected
                  if (!selectedStates || !selectedStates.length) {
                    const citySelect = document.querySelector(`#citySelect${zone}`);
                    if (citySelect) {
                      $(citySelect).empty().trigger('change');
                    }
                    return;
                  }

                  axios.post('/predispatch/getCitiesAndUpdateStates', {
                    selectedState: selectedStates,  // Keep as array
                    excludedCities: [],
                    zone: zone
                  })
                    .then(response => {
                      if (response.data && response.data.cities) {
                        const cities = response.data.cities;
                        const citySelect = document.querySelector(`#citySelect${zone}`);

                        if (citySelect) {
                          // Keep existing selected cities
                          const currentlySelected = $(citySelect).val() || [];

                          $(citySelect).empty();

                          // Add new cities
                          cities.forEach(city => {
                            const isSelected = currentlySelected.includes(city);
                            $(citySelect).append(new Option(city, city, isSelected, isSelected));
                          });

                          $(citySelect).trigger('change');
                        }
                      }
                    })
                    .catch(error => {
                      console.error('Error fetching cities:', error);
                      const citySelect = document.querySelector(`#citySelect${zone}`);
                      if (citySelect) {
                        $(citySelect).empty()
                          .append(new Option('Error loading cities', '', true, true))
                          .trigger('change');
                      }
                    });
                }

                // Event handler for state selection
                zones.forEach((zone) => {
                  $(`#stateSelect${zone}`).on('select2:select select2:unselect', function (e) {
                    e.stopPropagation();
                    const selectedStates = $(this).val();
                    if (selectedStates && selectedStates.length > 0) {
                      fetchCitiesForZone(zone, selectedStates);
                    } else {
                      // Clear cities if no states selected
                      const citySelect = document.querySelector(`#citySelect${zone}`);
                      if (citySelect) {
                        $(citySelect).empty().trigger('change');
                      }
                    }
                  });
                });


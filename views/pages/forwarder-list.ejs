              <script>
                function deletecourier(id) {
                  // First confirmation using SweetAlert2
                  Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'Cancel'
                  }).then((result) => {
                    if (result.isConfirmed) {
                      // User confirmed, proceed with deletion
                      axios.delete(`/courier/delete/${id}`)
                        .then((response) => {
                          Swal.fire({
                            title: 'Deleted!',
                            text: response.data.message || 'courier has been deleted successfully.',
                            icon: 'success',
                            confirmButtonText: 'OK'
                          }).then(() => {
                            window.location.reload(); // Reload page after confirmation
                          });
                        })
                        .catch((error) => {
                          console.error('Error:', error);
                          Swal.fire({
                            title: 'Error!',
                            text: error.response?.data?.message || 'An error occurred while trying to delete the courier.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                          });
                        });
                    }
                  });
                }
                $(document).ready(function () {
                  // Check if DataTable is already initialized
                  if (!$.fn.dataTable.isDataTable('#courier_details')) {
                    // Initialize DataTable only if it's not already initialized
                    var table = $('#courier_details').DataTable({
                      "ordering": false,
                      "searching": true,
                      "lengthChange": false,
                      "info": true,
                      "paging": true,
                      "dom": '<"d-flex align-items-center gap-3"<"flex-grow-1">>lrtip',
                      "language": {
                        "lengthMenu": `<div style="float: right">Showing <select class='form-select' style='background-color: #e3f2fd; border-color: #90caf9; color: #1976d2; display: inline-block; width:80px; text-align-last: center; padding-right: 25px;'><option value='10'>10</option><option value='25'>25</option><option value='50'>50</option><option value='100'>100</option></select> of Total Entries</div>`,
                        "info": "<div style='float: right'>Showing _START_ to _END_ of _TOTAL_ entries</div>"
                      },
                      "pagingType": "full_numbers",
                      "pageLength": 10,
                      "drawCallback": function () {
                        $('.paginate_button').addClass('btn btn-sm').css({
                          'background-color': '#e3f2fd',
                          'border-color': '#90caf9',
                          'color': '#1976d2',
                          'margin': '0 2px',
                          'border-radius': '4px'
                        });

                        $('.paginate_button.current').css({
                          'background-color': '#1976d2',
                          'color': '#fff',
                          'border-color': '#1976d2'
                        });

                        $('.paginate_button.disabled').css({
                          'opacity': '0.5',
                          'cursor': 'not-allowed'
                        });
                      }
                    });
                  }

                  // Custom search functionality when user types in the search input
                  $('#search-input').on('keyup', function () {
                    var searchValue = $(this).val();
                    $('#courier_details').DataTable().search(searchValue).draw();
                  });

                  // Optional: Search when the search button is clicked 
                  $('#button-addon2').on('click', function () {
                    var searchValue = $('#search-input').val();
                    $('#courier_details').DataTable().search(searchValue).draw();
                  });
                });

                // Initialize modals
                let editModal, departmentalModal, additionalChargesModal;

                document.addEventListener('DOMContentLoaded', function () {
                  // Initialize all modals
                  editModal = new bootstrap.Modal(document.getElementById('editcourierModal'));
                  departmentalModal = new bootstrap.Modal(document.getElementById('departmentalInfoModal'));
                  additionalChargesModal = new bootstrap.Modal(document.getElementById('additionalChargesModal'));
                });

                // Function to edit parental details
                async function editParentalDetails(id) {
                  try {
                    // Show loading state
                    Swal.fire({
                      title: 'Loading...',
                      allowOutsideClick: false,
                      didOpen: () => {
                        Swal.showLoading();
                      }
                    });

                    // Fetch courier data
                    const response = await axios.get(`/api/courier/${id}`);
                    const courier = response.data;

                    // Get form reference first
                    const form = document.getElementById('basicInfo');
                    if (!form) {
                      throw new Error('Form not found');
                    }

                    console.log('courier data:', courier);

                    // Fill the form fields
                    document.getElementById('companyName').value = courier.company_name || '';
                    // document.getElementById('courierName').value = courier.courier_name || '';
                    document.getElementById('website').value = courier.website || '';
                    document.getElementById('companyAddress').value = courier.company_address || '';
                    document.getElementById('companyCountry').value = courier.company_country || '';
                    document.getElementById('companyState').value = courier.company_state || '';
                    document.getElementById('companyDistrict').value = courier.company_district || '';
                    document.getElementById('courier_Email').value = courier.email_id || '';
                    document.getElementById('courier_mobile').value = courier.phone || '';

                    // Handle dates
                    if (courier.from_date) {
                      document.getElementById('fromDate').value = courier.from_date.split('T')[0];
                    }
                    if (courier.from_to) {
                      document.getElementById('fromTo').value = courier.from_to.split('T')[0];
                    }

                    // KYC Details Section
                    document.getElementById('company_pan').value = courier.company_pan_code || '';
                    document.getElementById('vat').value = courier.company_vat || '';
                    document.getElementById('gstNo').value = courier.gst_no || '';
                    document.getElementById('company_uin').value = courier.company_uin || '';

                    // Banking Details Section
                    document.getElementById('Bank_account_name').value = courier.company_bank_account || '';
                    document.getElementById('accountNumber').value = courier.account_number || '';
                    document.getElementById('ifscCode').value = courier.ifsc_code || '';

                    // Handle Select Elements
                    const billingCycle = document.getElementById('billingCycle');
                    if (billingCycle && courier.billing_cycle) {
                      billingCycle.value = courier.billing_cycle.toLowerCase();
                    }

                    const chooseBank = document.getElementById('chooseBank');
                    if (chooseBank && courier.choose_bank) {
                      chooseBank.value = courier.choose_bank;
                    }

                    // Handle Logo Preview
                    const logoPreview = document.getElementById('logoPreview');
                    if (courier.logo_path && logoPreview) {
                      // Create hidden input for existing logo path
                      let hiddenLogoPath = document.getElementById('existingLogoPath');
                      if (!hiddenLogoPath) {
                        hiddenLogoPath = document.createElement('input');
                        hiddenLogoPath.type = 'hidden';
                        hiddenLogoPath.id = 'existingLogoPath';
                        hiddenLogoPath.name = 'existingLogoPath';
                        form.appendChild(hiddenLogoPath);
                      }
                      hiddenLogoPath.value = courier.logo_path;

                      // Show logo preview
                      logoPreview.innerHTML = `
                            <img src="/${courier.logo_path}" alt="Company Logo" 
                                 style="max-width: 200px; max-height: 100px; object-fit: contain;">
                            <p class="mt-1 text-muted small">Current logo</p>
                        `;
                    } else if (logoPreview) {
                      logoPreview.innerHTML = '<p class="text-muted small">No logo uploaded</p>';
                    }

                    // Add hidden field for ID
                    let hiddenField = document.getElementById('courierId');
                    if (!hiddenField) {
                      hiddenField = document.createElement('input');
                      hiddenField.type = 'hidden';
                      hiddenField.id = 'courierId';
                      hiddenField.name = 'id';
                      form.appendChild(hiddenField);
                    }
                    hiddenField.value = id;

                    // Close loading and show modal
                    Swal.close();
                    if (editModal) {
                      editModal.show();
                    } else {
                      console.error('Modal not initialized');
                    }

                  } catch (error) {
                    console.error('Error:', error);
                    Swal.fire({
                      icon: 'error',
                      title: 'Error',
                      text: 'Failed to load parental details'
                    });
                  }
                }

                // New function to edit departmental information
                async function editDepartmentalInfo(id) {
                  try {
                    Swal.fire({
                      title: 'Loading...',
                      allowOutsideClick: false,
                      didOpen: () => {
                        Swal.showLoading();
                      }
                    });

                    const response = await axios.get(`/api/courier/contacts/${id}`);
                    const contacts = response.data;

                    console.log('Contact data:', contacts);

                    // Clear any existing inputs first
                    document.getElementById('sales-inputs').innerHTML = '';
                    document.getElementById('ops-inputs').innerHTML = '';
                    document.getElementById('accounts-inputs').innerHTML = '';
                    document.getElementById('rvp-inputs').innerHTML = '';

                    // Group contacts by department
                    const groupedContacts = contacts.reduce((acc, contact) => {
                      const dept = contact.department.toLowerCase();
                      if (!acc[dept]) acc[dept] = [];
                      acc[dept].push(contact);
                      return acc;
                    }, {});

                    // Fill each department's contacts
                    for (const [dept, deptContacts] of Object.entries(groupedContacts)) {
                      let mappedDept;
                      switch (dept) {
                        case 'sales': mappedDept = 'sales'; break;
                        case 'operations': mappedDept = 'ops'; break;
                        case 'finance': mappedDept = 'accounts'; break;
                        case 'support': mappedDept = 'rvp'; break;
                        default: continue;
                      }

                      // Fill first contact in the default fields
                      if (deptContacts.length > 0) {
                        fillDepartmentInputs(mappedDept, deptContacts[0]);
                      }

                      // Add additional contacts starting from index 1
                      for (let i = 1; i < deptContacts.length; i++) {
                        addContact(mappedDept, deptContacts[i]);
                      }
                    }

                    // Add hidden field for vendor_id
                    const form = document.getElementById('contact_tables_data');
                    let hiddenField = document.createElement('input');
                    hiddenField.type = 'hidden';
                    hiddenField.name = 'vendor_id';
                    hiddenField.value = id;
                    form.appendChild(hiddenField);

                    Swal.close();
                    departmentalModal.show();

                  } catch (error) {
                    console.error('Error:', error);
                    Swal.fire({
                      icon: 'error',
                      title: 'Error',
                      text: 'Failed to load departmental information'
                    });
                  }
                }

                // Helper function to fill department inputs (for first contact)
                function fillDepartmentInputs(department, contact) {
                  const prefix = department;

                  // Get the first set of inputs for this department
                  const nameInput = document.querySelector(`input[name="${prefix}_name[]"]`);
                  const phoneInput = document.querySelector(`input[name="${prefix}_phone[]"]`);
                  const emailInput = document.querySelector(`input[name="${prefix}_email[]"]`);

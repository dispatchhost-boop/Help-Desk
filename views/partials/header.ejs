        <div class="modal" id="trackShipmentModal" tabindex="-1" aria-labelledby="trackShipmentModalLabel"
            aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="trackShipmentModalLabel">Track Your Shipment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" id="trackingNumber"
                                placeholder="Enter tracking number" aria-label="Tracking number">
                            <button class="btn btn-primary" type="button" id="trackButton">Track</button>
                        </div>
                        <div id="trackingResult" class="mt-3" style="display: none;">
                            <!-- Results will be displayed here -->
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const amountInput = document.getElementById("amount");
                const amountButtons = document.querySelectorAll(".amount-btn");
                let selectedAmount = "";

                amountButtons.forEach(button => {
                    button.addEventListener("click", function () {
                        amountInput.value = this.dataset.value;
                        selectedAmount = this.dataset.value;
                    });
                });

                document.getElementById("proceedBtn").addEventListener("click", async function () {
                    const amount = parseInt(amountInput.value.replace(/[^0-9]/g, ''));

                    try {
                        const response = await axios.post('/api/phonepay/initiate-payment', {
                            amount: amount,
                            merchantTransactionId: 'MTDS' + Date.now(),
                            merchantUserId: 'MUIDDS' + Date.now()
                        }, {
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });

                        if (response.data.success) {
                            // window.location.href = response.data.data.data.instrumentResponse.redirectInfo.url;
                            window.location.href = response.data.data.redirectUrl;
                        } else {
                            alert('Payment initiation failed');
                        }
                    } catch (error) {
                        console.error('Payment error:', error);
                        alert('Payment initiation failed: ' + error.message);
                    }
                });
                // / Fix for track shipment modal fade issue
                const trackShipmentModal = document.getElementById('trackShipmentModal');
                console.log("tarck shipment m,doal", trackShipmentModal); // Check if the element is nul

                // Remove fade class when modal is hidden
                trackShipmentModal.addEventListener('hidden.bs.modal', function () {
                    console.log("clicked in close button of the modal");
                    // Clear tracking input and result when modal is closed
                    document.getElementById('trackingNumber').value = '';
                    document.getElementById('trackingResult').style.display = 'none';
                    document.getElementById('trackingResult').innerHTML = '';
                    trackShipmentModal.classList.remove('fade');
                });

                // Ensure fade class is removed when modal is about to be shown
                trackShipmentModal.addEventListener('show.bs.modal', function () {
                    trackShipmentModal.classList.remove('fade');
                });
            });
        </script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const trackButton = document.getElementById('trackButton');
                const trackingInput = document.getElementById('trackingNumber');
                const trackingResult = document.getElementById('trackingResult');

                trackButton.addEventListener('click', async function () {
                    const trackingNumber = trackingInput.value.trim();

                    if (!trackingNumber) {
                        trackingResult.style.display = 'block';
                        trackingResult.innerHTML = `
                          <div class="alert alert-warning">
                              Please enter a tracking number
                          </div>
                      `;
                        return;
                    }

                    try {
                        trackButton.disabled = true;
                        trackButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Tracking...';

                        const response = await axios.post('/api/track-shipment', {
                            trackingNumber: trackingNumber
                        });

                        trackingResult.style.display = 'block';

                        if (response.data.success) {
                            const shipmentData = response.data.shipmentDetails;
                            const currentStatus = response.data.currentStatus;
                            const timeline = response.data.timeline;

                            trackingResult.innerHTML = `
                              <div class="card">
                                  <div class="card-body">
                                      <h6 class="card-title">Shipment Details</h6>
                                      <div class="row">
                                          <div class="col-md-6">
                                              <p><strong>Tracking Number:</strong> ${shipmentData.trackingNumber}</p>
                                              <p><strong>Order Date:</strong> ${shipmentData.orderDate}</p>
                                              <p><strong>Status:</strong> ${shipmentData.status}</p>
                                              <p><strong>Consignee:</strong> ${shipmentData.consigneeName}</p>
                                          </div>
                                          <div class="col-md-6">
                                              <p><strong>Destination:</strong> ${shipmentData.destinationAddress}</p>
                                              <p><strong>Pincode:</strong> ${shipmentData.destinationPincode}</p>
                                              <p><strong>Payment Mode:</strong> ${shipmentData.paymentMode}</p>
                                              <p><strong>Weight/Boxes:</strong> ${shipmentData.weight}${shipmentData.weightUnit} / ${shipmentData.boxes} boxes</p>
                                          </div>
                                      </div>
          
                                      <h6 class="mt-4">Current Status</h6>
                                      <div class="alert alert-info">
                                          <p class="mb-1"><strong>${currentStatus.status}</strong></p>
                                          <p class="mb-1">Location: ${currentStatus.location}</p>
                                          <small>Last Updated: ${currentStatus.lastUpdated}</small>
                                      </div>
          
                                      <h6 class="mt-3">Tracking History</h6>
                                      <div class="timeline">
                                          ${timeline.map(detail => `
                                              <div class="timeline-item border-bottom py-2">
                                                  <p class="mb-1"><strong>${detail.date}</strong></p>
                                                  <p class="mb-1">${detail.status}</p>
                                                  <p class="mb-1"><small class="text-muted">Location: ${detail.location}</small></p>
                                                  ${detail.details ? `<small class="text-muted d-block">${detail.details}</small>` : ''}
                                              </div>
                                          `).join('')}
                                      </div>
                                  </div>
                              </div>
                          `;
                        } else {
                            trackingResult.innerHTML = `
                              <div class="alert alert-warning">
                                  ${response.data.message}
                              </div>
                          `;
                        }
                    } catch (error) {
                        trackingResult.style.display = 'block';
                        trackingResult.innerHTML = `
                          <div class="alert alert-danger">
                              ${error.response?.data?.message || 'Error tracking shipment. Please try again later.'}
                          </div>
                      `;
                    } finally {
                        trackButton.disabled = false;
                        trackButton.innerHTML = 'Track';
                    }
                });
            });
        </script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Find the logout button (adjust selector if needed)
                const logoutBtn = document.querySelector('a[href="/logout"]');
                if (logoutBtn) {
                    logoutBtn.addEventListener('click', function () {
                        localStorage.removeItem('selectedSlug');
                    });
                }

                // Fix dropdown functionality
                const quickActionsBtn = document.getElementById('quickActionsBtn');
                const tenantDropdownBtn = document.getElementById('tenantDropdownBtn');
                const quickDropdownMenu = document.getElementById('quickDropdownMenu');
                const tenantDropdown = document.getElementById('tenantDropdown');

                // Quick Actions dropdown
                if (quickActionsBtn && quickDropdownMenu) {
                    quickActionsBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        // Toggle dropdown
                        const isVisible = quickDropdownMenu.style.display === 'block';
                        quickDropdownMenu.style.display = isVisible ? 'none' : 'block';
                        
                        // Update aria-expanded
                        quickActionsBtn.setAttribute('aria-expanded', !isVisible);
                    });
                }

                // Tenant Selector dropdown
                if (tenantDropdownBtn && tenantDropdown) {
                    tenantDropdownBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        // Toggle dropdown
                        const isVisible = tenantDropdown.style.display === 'block';
                        tenantDropdown.style.display = isVisible ? 'none' : 'block';
                        
                        // Update aria-expanded
                        tenantDropdownBtn.setAttribute('aria-expanded', !isVisible);
                    });
                }

                // Close dropdowns when clicking outside
                document.addEventListener('click', function(e) {
                    if (!quickActionsBtn?.contains(e.target) && !quickDropdownMenu?.contains(e.target)) {
                        if (quickDropdownMenu) {
                            quickDropdownMenu.style.display = 'none';
                            quickActionsBtn?.setAttribute('aria-expanded', 'false');
                        }
                    }
                    
                    if (!tenantDropdownBtn?.contains(e.target) && !tenantDropdown?.contains(e.target)) {
                        if (tenantDropdown) {
                            tenantDropdown.style.display = 'none';
                            tenantDropdownBtn?.setAttribute('aria-expanded', 'false');
                        }
                    }
                });

                // Handle tenant item clicks
                const tenantItems = document.querySelectorAll('.tenant-item');
                tenantItems.forEach(item => {
                    item.addEventListener('click', function(e) {
                        const slug = this.getAttribute('data-slug');
                        const tenant = this.getAttribute('data-tenant');
                        const type = this.getAttribute('data-type');
                        
                        // Store selected tenant info
                        localStorage.setItem('selectedSlug', slug);
                        localStorage.setItem('selectedTenant', tenant);
                        localStorage.setItem('selectedType', type);
                        
                        // Update button text
                        const tenantName = document.querySelector('.tenant-name');
                        const tenantType = document.querySelector('.tenant-type');
                        if (tenantName) tenantName.textContent = tenant;
                        if (tenantType) tenantType.textContent = type;
                        
                        // Close dropdown
                        tenantDropdown.style.display = 'none';
                        tenantDropdownBtn.setAttribute('aria-expanded', 'false');
                    });
                });
            });
        </script>




    </div>

</body>
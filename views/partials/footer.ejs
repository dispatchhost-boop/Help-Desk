  #currentDateTime{ display:none !important; }

  @media (max-width:575.98px){
    #helpCenterModal .modal-dialog{ max-width:100%; }
    #helpCenterModal .modal-content{ border-radius:0; }
    .hc-action{ flex:1 1 100%; }
    #submitTicketBtn{ width:100%; }

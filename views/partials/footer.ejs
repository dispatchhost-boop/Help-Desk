<!-- ===== Footer & floating Help Center button ===== -->
<style>
  footer { padding: 0 30px; position: absolute; right: 0; }
  .footer-fixed-bottom {
    position: fixed; bottom: 0; left: 280px; width: calc(100% - 330px);
    background: #ffffff; transition: all 0.3s ease-in-out; z-index: 99;
  }
  .footer-fixed-bottom .container-fluid { max-width: 1140px; margin: 0 auto; }
  .layout-fullwidth .footer-fixed-bottom { left: 0; width: calc(100% - 50px); }
  .right_icon_toggle.layout-fullwidth .footer-fixed-bottom { width: 100%; }

  /* Floating button */
  .help-center-btn {
    position: fixed; bottom: 20px; right: 20px;
    display: flex; align-items: center; gap: 8px;
    padding: 8px 16px; font-size: 14px; cursor: pointer;
    border-radius: 50px; background-color: #333; color: #fff;
    border: 2px solid #e74c3c; box-shadow: 0 2px 10px rgba(0,0,0,.1);
    z-index: 100;
  }
  .help-center-btn i { color: #e74c3c; }
  @media (max-width: 991px){ .footer-fixed-bottom{ left:0; width:100%; } .help-center-btn{ bottom:70px; } }
</style>

<footer class="footer-fixed-bottom">
  <div class="container-fluid px-4">
    <div class="row align-items-center" style="min-height:48px;">
      <div class="col-md-6 col-12 text-md-start text-center mb-2 mb-md-0">
        <span>© 2025 Ashrey Logistic Solutions LLP.</span>
      </div>
      <div class="col-md-6 col-12 text-md-end text-center">
        <span>Crafted with</span> <i class="fas fa-heart text-danger"></i>
        <span class="ms-2">by Team Dispatch Solutions</span>
      </div>
    </div>
  </div>
</footer>

<button id="helpCenterBtn" class="help-center-btn">
  <i class="fas fa-circle-question"></i><span>Help Center</span>
</button>

<!-- ===== Help Center Modal (Right-side sheet) ===== -->
<div id="helpCenterModal" class="modal fade" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Help Center</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <!-- Top actions -->
      <div class="hc-actions mb-3">
  <a class="hc-action" id="hcGoKB" href="/knowledge-base">
    <i class="fas fa-book-open"></i><span>View knowledge base</span>
  </a>

  <a class="hc-action" id="hcGoTickets" href="/view-support-tickets">
    <i class="fas fa-ticket-alt"></i><span>View support tickets</span>
  </a>
</div>


        <!-- HOME -->
        <div id="hcHome">
          <div class="hc-card hc-card-support mb-3">
            <div class="hc-card-title">Need more support?</div>
            <div class="hc-card-sub">Get quick help by raising a ticket</div>
            <button type="button" class="btn btn-light hc-cta" id="hcGoRaise">Raise a ticket</button>
          </div>

          <div class="hc-card">
            <div class="hc-card-title d-flex align-items-center gap-2">
              <i class="far fa-calendar"></i> Schedule a training session
            </div>
            <div class="hc-card-sub">
              Get a personalized walkthrough to learn how to create orders, manage pickups,
              resolve exceptions, and more on Delhivery One
            </div>
            <a href="#" class="hc-link">Schedule now</a>
          </div>
        </div>

        <!-- Raise Ticket view (injected) -->
        <div id="raise-ticket" class="d-none"></div>

        <!-- View Tickets placeholder -->
        <div id="view-tickets" class="d-none">
          <div class="text-center py-5">
            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
            <p class="text-muted">No support tickets found</p>
            <p>You can raise a new ticket using the “Raise a ticket” button above</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===== Visual polish for the right-side modal & landing ===== -->
<style>
  :root{
    --hc-primary:#e74c3c; --hc-primary-600:#d74435; --hc-primary-50:#fdecea;
    --hc-text:#1f2937; --hc-muted:#64748b; --hc-border:#e6e8ee; --hc-bg:#f7f8fb;
  }
  #helpCenterModal .modal-dialog{ margin:0 0 0 auto; max-width:560px; height:100vh; }
  #helpCenterModal .modal-content{ height:100%; border:0; border-radius:16px 0 0 16px; box-shadow:0 10px 30px rgba(2,6,23,.15); }
  #helpCenterModal .modal-header{ position:sticky; top:0; z-index:3; background:#fff; border-bottom:1px solid #eef0f3; }
  #helpCenterModal .modal-title{ font-weight:700; color:#111827; }
  #helpCenterModal .modal-body{ background:#f7f8fb; padding:16px; overflow:auto; }

  .hc-actions{ display:flex; gap:12px; flex-wrap:wrap; }
  .hc-action{
    display:flex; align-items:center; gap:10px; flex:1 1 240px;
    background:#111827; color:#fff; padding:12px 14px; border:none; border-radius:12px; font-weight:600;
    transition:transform .15s ease, opacity .15s ease;
  }
  .hc-action i{ font-size:16px; opacity:.9; }
  .hc-action:hover{ transform:translateY(-1px); opacity:.95; }

  .hc-card{ background:#fff; border:1px solid var(--hc-border); border-radius:12px; padding:14px 16px; }
  .hc-card-support{ background:#eef2ff; border-color:#e0e7ff; }
  .hc-card-title{ font-weight:700; color:#111827; }
  .hc-card-sub{ color:#6b7280; margin-top:4px; }
  .hc-cta{ margin-top:12px; border-radius:10px; font-weight:600; border:1px solid #d1d5db; background:#fff; }
  .hc-link{ display:inline-block; margin-top:10px; font-weight:600; color:#3b82f6; text-decoration:none; }
  .hc-link:hover{ text-decoration:underline; }

  #raise-ticket, #view-tickets{
    background:#fff; border:1px solid var(--hc-border); border-radius:12px; padding:16px; margin-top:12px;
  }

  /* Pills */
  .list-group{ display:block; }
  .list-group-item{ padding:0; border:0; background:transparent; }
  .hc-pill-check{ display:block; margin:10px 0; }
  .hc-pill-check .form-check-input{ position:absolute; opacity:0; pointer-events:none; }
  .hc-pill-check .form-check-label{
    display:block; width:100%; max-width:360px;
    padding:14px 16px; background:#fff; color:#374151;
    border:1px solid var(--hc-border); border-radius:22px; line-height:1.25; font-weight:600; font-size:0.94rem;
    box-shadow:0 1px 2px rgba(16,24,40,.05); transition: border-color .15s, background .15s, transform .15s;
    word-wrap:break-word;
  }
  .hc-pill-check .form-check-label:hover{ border-color:#dcdfe6; transform:translateY(-1px); }

  }

  /* LR calendar */
  .lr-tools { display: grid; grid-template-columns: 1fr; gap: 12px; }
  .lr-quick { display:flex; gap:8px; flex-wrap:wrap; }
  .lr-quick .btn { border-radius: 999px; padding:6px 12px; }
  .lr-range { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .lr-select { min-height: 140px; }
  .small-muted { font-size:.825rem; color:#6b7280; }

  /* Count badges */
  .lr-counts{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
  .lr-badge{
    display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:999px;
    border:1px solid var(--hc-border); background:#fff; font-weight:600; font-size:.82rem; color:#374151;
  }

  /* CC chips */
  .cc-chip{ display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:999px;
    border:1px solid var(--hc-border); background:#f8fafc; margin:4px 6px 0 0; font-size:.85rem; }
  .cc-chip button{ border:none; background:transparent; cursor:pointer; font-weight:700; }

    background: rgba(231,76,60,.06); border-color: var(--hc-primary); color: var(--hc-primary-600);
  }

  .hc-chip-check{ display:inline-block; margin:6px 8px 6px 0; }
  .hc-chip-check .form-check-input{ position:absolute; opacity:0; pointer-events:none; }
  .hc-chip-check .form-check-label{
    display:inline-flex; align-items:center; gap:8px; padding:8px 12px;
    border:1px solid var(--hc-border); border-radius:999px; background:#fff; color:#1f2937;
    font-weight:600; font-size:.85rem; transition:all .15s ease-in-out; cursor:pointer; user-select:none;
    box-shadow:0 1px 0 rgba(2,6,23,.02);
  }
  .hc-chip-check .form-check-input:checked + .form-check-label{
    background:var(--hc-primary-50); border-color:var(--hc-primary); color:var(--hc-primary-600);
  }

  #subCategoriesContainer, #dynamicFieldsContainer{
    background:#fff; border:1px solid var(--hc-border); border-radius:12px; padding:12px; margin-top:12px;
  }
  .form-control{ border-radius:10px; border-color:#dfe3ea; }
  .form-control:focus{ border-color:var(--hc-primary); box-shadow:0 0 0 .2rem rgba(231,76,60,.15); }

  .ticket-actionbar{
    position:sticky; bottom:0; z-index:2; background:#fff;
    padding-top:10px; margin-top:10px; border-top:1px solid var(--hc-border);
    display:flex; justify-content:end; align-items:center; gap:8px;
  }
  #submitTicketBtn{
    background:var(--hc-primary); border-color:var(--hc-primary);
    border-radius:10px; padding:10px 16px; font-weight:600;

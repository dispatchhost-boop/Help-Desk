                    { text: 'Request Support', icon: 'fa fa-headset', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/support' },
                    { text: 'Create Appointment', icon: 'fa fa-calendar-plus', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/appointments/create' },
                    { text: 'Shipment Tracking', icon: 'fa-solid fa-truck', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '../../shipment-tracking' },
                    { text: 'Create Appointment', icon: 'fa fa-calendar-plus', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/package' },
                ],
                express: [
                    { text: 'Create Express Order', icon: 'fa fa-rocket', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/create-order' },
                    { text: 'Bulk Upload Express', icon: 'fa fa-cloud-upload-alt', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/bulk-upload' },
                    { text: 'Schedule Delivery', icon: 'fa fa-calendar-check', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/schedule-delivery' },
                    { text: 'Shipment Tracking', icon: 'fa-solid fa-truck', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/shipment-tracking' },
                    { text: 'Create Appointment', icon: 'fa fa-calendar-plus', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/package' },
                ],
                ecom: [
                    { text: 'Create ecom Order', icon: 'fa fa-shopping-cart', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/create-order' },
                    { text: 'Bulk Product Upload', icon: 'fa fa-boxes', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/bulk-upload' },
                    { text: 'Ecom Pickup Request', icon: 'fa fa-truck', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/create-pickup' },
                    { text: 'Shipment Tracking', icon: 'fa-solid fa-truck', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/shipment-tracking' },
                    { text: 'Create Appointment', icon: 'fa fa-calendar-plus', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/package' },
                ]
            };

            const tenantLabels = {
                ltl: 'Quick (B2B)',
                express: 'Quick (Express)',
                ecom: 'Quick (Ecom)'
            };

            const validSlugs = ['ltl', 'express', 'ecom'];

            // --- Get tenant from localStorage or infer from URL ---
            let selectedSlug = localStorage.getItem('selectedSlug');
            if (!selectedSlug || !validSlugs.includes(selectedSlug)) {
                const urlSlug = window.location.pathname.split('/')[1];
                selectedSlug = validSlugs.includes(urlSlug) ? urlSlug : 'express';
                localStorage.setItem('selectedSlug', selectedSlug);
            }

            // --- Set cookie for backend access ---
            document.cookie = `tenant=${selectedSlug}; path=/; max-age=${60 * 60 * 24 * 7}`;

            // --- Update sidebar menu visibility ---
            filterAndHighlightMenu(selectedSlug);

            // --- Render quick actions ---
            renderQuickActions(selectedSlug);

            // --- Update quick label ---
            quickActionsLabel.textContent = tenantLabels[selectedSlug] || 'Quick';

            // --- Update tenant label in UI ---
            const activeTenantItem = document.querySelector(`.tenant-item[data-slug="${selectedSlug}"]`);
            if (activeTenantItem) {
                document.querySelector('.tenant-name').textContent = activeTenantItem.dataset.tenant || '';
                document.querySelector('.tenant-type').textContent = activeTenantItem.dataset.type || '';
            }

            // --- Update all dynamic hrefs for tenant ---
            updateTenantUrls(selectedSlug);

            // --- Handle ecom-only menu items on initial load ---
            const ecomOnlyItems = document.querySelectorAll('.ecom-only');
            ecomOnlyItems.forEach(item => {
                if (selectedSlug === 'ecom') {
                    item.style.display = "list-item";
                } else {
                    item.style.display = "none";
                }
            });

            // --- Handle tenant selection from dropdown ---
            document.querySelectorAll('.tenant-item').forEach(item => {
                item.addEventListener('click', function (e) {
                    const slug = this.dataset.slug;
                    const tenantName = this.dataset.tenant;
                    const tenantType = this.dataset.type;

                    if (slug === 'ltl') {
                        e.preventDefault();
                        alert('Coming Soon');
                        return;
                    }

                    // Check if user has access to this segment
                    <% if (typeof user !== 'undefined' && user) { %>
                    const isAdmin = <%= user.selectedClientId === 1 %>;
                    const segmentType = '<%= user.segmentType || "" %>';
                    
                    if (!isAdmin) {
                        if (slug === 'express' && segmentType !== 'express' && segmentType !== 'both') {
                            e.preventDefault();
                            alert('You do not have access to Express segment');
                            return;
                        }
                        if (slug === 'ecom' && segmentType !== 'ecom' && segmentType !== 'both') {
                            e.preventDefault();
                            alert('You do not have access to E-commerce segment');
                            return;
                        }
                    }
                    <% } %>

                    // Save and update
                    localStorage.setItem('selectedSlug', slug);
                    document.cookie = `tenant=${slug}; path=/; max-age=${60 * 60 * 24 * 7}`;

                    document.querySelector('.tenant-name').textContent = tenantName;
                    document.querySelector('.tenant-type').textContent = tenantType;
                    quickActionsLabel.textContent = tenantLabels[slug] || 'Quick';

                    renderQuickActions(slug);
                    updateTenantUrls(slug);
                    filterAndHighlightMenu(slug);

                    // Redirect to new slug path
                    window.location.href = `/${slug}`;
                });
            });

            function renderQuickActions(tenant) {
                const options = quickOptionsByTenant[tenant] || [];
                quickDropdownMenu.innerHTML = '';

                options.forEach(opt => {
                    const li = document.createElement('li');
                    li.innerHTML = `
            <a class="dropdown-item d-flex align-items-center gap-2" href="#" data-path="${opt.path}">
              <i class="fa ${opt.icon}" style="font-size:10px;color: #0e85ff;"></i>
              <span style="font-size:12px;">${opt.text}</span>
            </a>`;
                    quickDropdownMenu.appendChild(li);
                });

                quickDropdownMenu.querySelectorAll('a[data-path]').forEach(a => {
                    a.addEventListener('click', function (e) {
                        e.preventDefault();
                        const path = this.getAttribute('data-path');
                        window.location.href = `/${tenant}${path}`;
                    });
                });
            }

            function filterAndHighlightMenu(slug) {
                const menuItems = document.querySelectorAll('#sidebarMenu li');
                menuItems.forEach(li => {
                    const anchor = li.querySelector('a');
                    const href = anchor?.getAttribute('href') || "";

                    const isCommon = href.includes('/index') || href.includes('/cod-reports');
                    const isMatch = href.includes(`/${slug}/`) || href === `/${slug}` || href === `/${slug}/index`;

                    if (isCommon || isMatch) {
                        li.style.display = "list-item";
                        li.classList.toggle('active', isMatch);
                    } else {
                        li.style.display = "none";
                    }
                });

                // Handle ecom-only menu items
                const ecomOnlyItems = document.querySelectorAll('.ecom-only');
                ecomOnlyItems.forEach(item => {
                    if (slug === 'ecom') {
                        item.style.display = "list-item";
                    } else {
                        item.style.display = "none";
                    }
                });
            }

            function updateTenantUrls(slug) {
                const dynamicPaths = [
                    "/create-order",
                    "/create-order-new",
                    "/create-bulk-order",
                    "/unprocessed-orders",
                    "/ready_to_dispatch_assinged_lr",
                    "/order-In-transit",
                    "/out-for-delivery",
                    "/order-delivered",
                    "/order-return",
                    "/cancelled-orders",
                    "/package"
                ];

                dynamicPaths.forEach(path => {
                    const links = document.querySelectorAll(`a[href$="${path}"], a[href$="${slug}${path}"]`);
                    links.forEach(link => {
                        let currentHref = link.getAttribute("href");
                        if (!currentHref.startsWith(`/${slug}`)) {
                            const newHref = `/${slug}${path}`;
                            link.setAttribute("href", newHref);
                        }
                    });
                });
            }
        });
    </script>



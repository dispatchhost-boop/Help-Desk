(async function init() {
  const selectedClientId = await loadClients(); // this will force-select first + save cookie
  if (selectedClientId) {
    await loadUsers(selectedClientId);
  } else {
    userSelect.innerHTML = '<option value="">Self (No User)</option>';
    userSelect.disabled = true;
  }
})();
            /** -----------------------------
             *  Load Users for Client
             * ----------------------------- */
            async function loadUsers(clientId) {
                if (!clientId) return;

                try {
                    const res = await axios.get(`/api/clients/${clientId}/users`);
                    const users = res.data.users || [];

                    userSelect.innerHTML = '<option value="">Self (No User)</option>';
                    userSelect.disabled = false;

                    const selection = loadSelection();

                    users.forEach(user => {
                        const option = document.createElement('option');
                        option.value = user.id;
                        option.textContent = user.full_name;

                        // Restore saved selectedUserId if matches
                        if (selection.selectedUserId && selection.selectedUserId == user.id) {
                            option.selected = true;
                        }

                        userSelect.appendChild(option);
                    });
                } catch (err) {
                    console.error('Failed to fetch users:', err);
                }
            }

            /** -----------------------------
             *  Init Component
             * ----------------------------- */
            (async function init() {
                const selectedClientId = await loadClients();
                if (selectedClientId) {
                    await loadUsers(selectedClientId);
                }
            })();

            /** -----------------------------
             *  Handle client change
             * ----------------------------- */
            clientSelect.addEventListener('change', async function () {
                const clientId = this.value;
                saveSelection(clientId, null); // reset userId
                window.location.reload();
                userSelect.innerHTML = '<option value="">Self (No User)</option>';
                userSelect.disabled = true;

                if (!clientId) return;
                await loadUsers(clientId);
               
            });

            /** -----------------------------
             *  Handle user change
             * ----------------------------- */
            userSelect.addEventListener('change', function () {
                saveSelection(clientSelect.value, this.value || null);
                window.location.reload();
            });

            /** -----------------------------
             *  Fix User Dropdown Functionality
             * ----------------------------- */
            const userDropdownToggle = document.getElementById('userDropdownToggle');
            const userDropdownMenu = document.querySelector('.user-account .dropdown-menu');
            let isDropdownOpen = false;

            if (userDropdownToggle && userDropdownMenu) {
                userDropdownToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    if (isDropdownOpen) {
                        // Close dropdown
                        userDropdownMenu.style.display = 'none';
                        userDropdownMenu.classList.remove('show');
                        isDropdownOpen = false;
                    } else {
                        // Open dropdown
                        userDropdownMenu.style.display = 'block';
                        userDropdownMenu.classList.add('show');
                        isDropdownOpen = true;
                    }
                });

                // Close dropdown when clicking outside
                document.addEventListener('click', function (e) {
                    if (!userDropdownToggle.contains(e.target) && !userDropdownMenu.contains(e.target)) {
                        userDropdownMenu.style.display = 'none';
                        userDropdownMenu.classList.remove('show');
                        isDropdownOpen = false;
                    }
                });

                // Close dropdown when clicking on dropdown items
                const dropdownItems = userDropdownMenu.querySelectorAll('.dropdown-item');
                dropdownItems.forEach(item => {
                    item.addEventListener('click', function () {
                        // Don't close for the "Switch Client" item as it has sub-elements
                        if (!this.querySelector('.client-user-selector')) {
                            userDropdownMenu.style.display = 'none';
                            userDropdownMenu.classList.remove('show');
                            isDropdownOpen = false;
                        }
                    });
                });
            }
        });
    </script>

    <!-- JavaScript to prevent dropdown from closing -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Prevent dropdown from closing when clicking on selectors
        const clientSelect = document.querySelector('.clientSelect');
        const userSelect = document.querySelector('.userSelect');
        const clientUserSelector = document.querySelector('.client-user-selector');
        
        if (clientSelect) {
            clientSelect.addEventListener('click', function(e) {
                e.stopPropagation();
            });
            
            clientSelect.addEventListener('focus', function(e) {
                e.stopPropagation();
            });
            
            clientSelect.addEventListener('blur', function(e) {
                e.stopPropagation();
            });
        }
        
        if (userSelect) {
            userSelect.addEventListener('click', function(e) {
                e.stopPropagation();
            });
            
            userSelect.addEventListener('focus', function(e) {
                e.stopPropagation();
            });
            
            userSelect.addEventListener('blur', function(e) {
                e.stopPropagation();
            });
        }
        
        if (clientUserSelector) {
            clientUserSelector.addEventListener('click', function(e) {
                e.stopPropagation();
            });
        }
        
        // Prevent the parent dropdown from closing when interacting with selectors
        const accountDropdown = document.querySelector('.dropdown-menu.account');
        if (accountDropdown) {
            accountDropdown.addEventListener('click', function(e) {
                if (e.target.closest('.client-user-selector')) {
                    e.stopPropagation();
                }
            });
        }
    });
    </script>


    <style>
        /* Fix for dropdown selectors vanishing */
        .client-user-selector {
            position: relative;
            z-index: 9999;
        }

        .client-user-selector select {
            position: relative;
            z-index: 10000;
        }

        .client-user-selector select:focus {
            z-index: 10001;
            box-shadow: 0 0 0 0.2rem rgba(14, 133, 255, 0.25);
        }

        /* Prevent dropdown menu from closing when interacting with selectors */
        .dropdown-menu.account {
            z-index: 9998;
        }

        .dropdown-menu.account .client-user-selector {
            pointer-events: auto;
        }

        /* Ensure select dropdowns appear above other elements */
        .clientSelect, .userSelect {
            position: relative;
            z-index: 10002 !important;
        }

        /* Prevent event bubbling that closes the dropdown */
        .client-user-selector * {
            pointer-events: auto;
        }

        /* User Account Dropdown Styles */
        .user-account .dropdown-menu {
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .user-account .dropdown-item {
            position: relative;
            overflow: hidden;
        }

        .user-account .dropdown-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(14, 133, 255, 0.1), transparent);
            transition: left 0.3s;
        }

        .user-account .dropdown-item:hover::before {
            left: 100%;
        }

        .user-account .dropdown-item:hover {
            background: #f0f8ff;
            transform: translateX(4px);
            border-radius: 8px;
        }

        .user-account .dropdown-toggle:hover {
            color: #0d6efd !important;
        }

        .user-account .dropdown-toggle:hover i {
            transform: rotate(180deg);
            transition: transform 0.3s ease;
        }

        /* Stats hover effects */
        .user-account .list-unstyled li {
            transition: all 0.3s ease;
        }

        .user-account .list-unstyled li:hover {
            transform: translateY(-2px);
        }

        .user-account .list-unstyled li:hover div:last-child {
            color: #0d6efd !important;
        }

        /* Add these styles to your CSS */
        .sidebar-nav li.active>a {
            color: #959595;
            background: rgba(255, 255, 255, 0.1);
        }

        .sidebar-nav li.active>a.has-arrow::after {
            color: #727272;
        }

        .sidebar-nav li ul li.active>a {
            color: #585858;
            font-weight: bold;
        }

        .sidebar-nav li ul {
            display: none;
        }

        .sidebar-nav li.active>ul {
            display: block;
        }

        .role-allowed {
            display: none !important;
        }
    </style>
</head>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Tab switching logic: only show the selected tab-pane, hide others
            function showTab(tabId) {
                // Get all tab panes
                const tabPanes = document.querySelectorAll('.tab-content .tab-pane');
                tabPanes.forEach(function (pane) {
                    if (pane.id === tabId) {
                        pane.classList.add('show', 'active');
                    } else {
                        pane.classList.remove('show', 'active');
                    }
                });
            }

            // On page load, show the tab from hash or default to tab-menu
            var hash = window.location.hash && document.querySelector(window.location.hash) ? window.location.hash : '#tab-menu';
            var initialTabId = hash.replace('#', '');
            showTab(initialTabId);

            // Add click event to all tab links
            document.querySelectorAll('a[data-bs-toggle="tab"]').forEach(function (tabLink) {
                tabLink.addEventListener('click', function (e) {
                    e.preventDefault();
                    var href = this.getAttribute('href');
                    if (href && href.startsWith('#') && document.querySelector(href)) {
                        showTab(href.replace('#', ''));
                        // Update URL hash without scrolling
                        history.replaceState(null, '', href);
                    }
                });
            });

            // Role-based menu visibility
            function checkUserRoleAndShowMenu() {
                // Get user role from cookie
                const userRole = getCookie('userRole');
                console.log('User role from cookie:', userRole);
                
                // Show admin-only menu items only if user role is 1 (admin)
                const adminOnlyItems = document.querySelectorAll('.admin-only');
                adminOnlyItems.forEach(item => {
                    if (userRole === '1') {
                        item.style.display = 'list-item';
                    } else {
                        item.style.display = 'none';
                    }
                });
            }

            // Helper function to get cookie value
            function getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) return parts.pop().split(';').shift();
                return null;
            }

            // Check role and show/hide menu items on page load
            checkUserRoleAndShowMenu();
        });
    </script>


        document.querySelectorAll('.client-user-selector').forEach(container => {
            const clientSelect = container.querySelector('.clientSelect');
            const userSelect = container.querySelector('.userSelect');

            const COOKIE_KEY = 'selection'; // store { selectedClientId, selectedUserId }
            const levelMap = { 1: 'Super Admin', 2: 'Client', 3: 'Sub-Client' };

            /** -----------------------------
             *  Cookie Helpers
             * ----------------------------- */
            function setCookie(name, value, days) {
                const expires = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toUTCString();
                document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires}; path=/;`;
            }

            function getCookie(name) {
                const match = document.cookie.split('; ').find(row => row.startsWith(name + '='));
                return match ? decodeURIComponent(match.split('=')[1]) : '';
            }

            /** -----------------------------
             *  Save selection (selectedClientId + selectedUserId)
             * ----------------------------- */
            function saveSelection(clientId, userId) {
                const selection = {
                    selectedClientId: clientId || null,
                    selectedUserId: userId || null
                };
                setCookie(COOKIE_KEY, JSON.stringify(selection), 7); // store 7 days
            }

            /** -----------------------------
             *  Load selection from cookie
             * ----------------------------- */
            function loadSelection() {
                try {
                    return JSON.parse(getCookie(COOKIE_KEY) || '{}');
                } catch (e) {
                    return {};
                }
            }


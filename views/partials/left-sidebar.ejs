/** -----------------------------
 *  Load Clients (use cookie if exists, else pick first)
 * ----------------------------- */
 async function loadClients() {
  try {
    const res = await axios.get('/api/all-clients');
    const clients = res.data.clients || [];

    clientSelect.innerHTML = ''; // clear previous
    const selection = loadSelection(); // load from cookie
    let selectedId = selection.selectedClientId || null;

    clients.forEach((client, index) => {
      const option = document.createElement('option');
      option.value = client.id;
      
      // Display company name if available, otherwise fall back to full_name
      const displayName = client.company_name || client.full_name || `Client ${client.id}`;
      option.textContent = displayName;

      // Select saved client if found, otherwise select first
      if (selectedId) {
        if (String(client.id) === String(selectedId)) {
          option.selected = true;
        }
      } else if (index === 0) {
        option.selected = true;
        selectedId = client.id; // set fallback
      }

      clientSelect.appendChild(option);
    });

    // If no clients, clear cookie
    if (!clients.length) {
      saveSelection(null, null);
      return '';
    }

    // If cookie didn't exist, store the first client's ID
    if (!selection.selectedClientId && selectedId) {
      saveSelection(selectedId, null);
    }

    return selectedId || '';
  } catch (err) {
    console.error('Failed to fetch clients:', err);
    return '';
  }
}


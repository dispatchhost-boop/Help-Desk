    function showTag() {
        const Elements = document.getElementsByClassName('role-allowed');
        const OuterLi = document.getElementsByClassName('outer-nav-item');

        // Show allowed role-based elements
        Array.from(Elements).forEach((el) => {
            if (userId == 1 || assignedRoles.includes(el.dataset.roleName)) {
                el.classList.remove('role-allowed'); // becomes visible
            }
        });

        // Show parent <li>s if any children are visible
        Array.from(OuterLi).forEach((outer) => {
            const visibleLis = Array.from(outer.querySelectorAll('li')).filter(li => {
                const isVisible = window.getComputedStyle(li).display !== 'none';
                const isHiddenByRole = li.classList.contains('role-allowed');
                return isVisible && !isHiddenByRole;
            });

            outer.style.display = visibleLis.length > 0 ? 'block' : 'none';
        });
    }

    // Run once when DOM is loaded
    window.addEventListener('DOMContentLoaded', () => {
        showTag();
    });

    // 🧠 Auto-run showTag() if DOM changes (tabs loaded dynamically)
    const observer = new MutationObserver((mutationsList, observer) => {
        showTag();
    });

    observer.observe(document.body, {
        childList: true,
        subtree: true
    });

    // ✅ Optionally expose showTag() for manual triggering
    window.refreshRoleTabs = showTag;
</script>


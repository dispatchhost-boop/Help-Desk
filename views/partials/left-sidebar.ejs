    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Function to set active menu item
            function setActiveMenu() {
                // Get current URL path
                const path = window.location.pathname.split('/').pop() || 'index';

                // Remove all active classes first
                document.querySelectorAll('.sidebar-nav li').forEach(li => {
                    li.classList.remove('active');
                    li.querySelectorAll('a').forEach(a => a.classList.remove('active'));
                });

                // Special case for index page
                if (path === 'index' || path === '') {
                    const dashboardLink = document.querySelector('.sidebar-nav a[href="/index"]');
                    if (dashboardLink) {
                        dashboardLink.classList.add('active');
                        let parent = dashboardLink.closest('li');
                        while (parent) {
                            parent.classList.add('active');
                            if (parent.classList.contains('metismenu')) break;
                            parent = parent.parentElement.closest('li');
                        }
                    }
                    return;
                }

                // Find matching link and add active class
                let found = false;
                document.querySelectorAll('.sidebar-nav a').forEach(link => {
                    const href = link.getAttribute('href');
                    if (href && (href.endsWith(path) || href === path)) {
                        link.classList.add('active');
                        let parent = link.closest('li');
                        while (parent) {
                            parent.classList.add('active');
                            if (parent.classList.contains('metismenu')) break;
                            parent = parent.parentElement.closest('li');
                        }
                        found = true;
                    }
                });

                // If no direct match found, try partial matches
                if (!found) {
                    document.querySelectorAll('.sidebar-nav a').forEach(link => {
                        const href = link.getAttribute('href');
                        if (href && path.includes(href.split('/').pop())) {
                            link.classList.add('active');
                            let parent = link.closest('li');
                            while (parent) {
                                parent.classList.add('active');
                                if (parent.classList.contains('metismenu')) break;
                                parent = parent.parentElement.closest('li');
                            }
                        }
                    });
                }
            }

            // Set active menu on page load
            setActiveMenu();

            // Helper: Close all sibling submenus at the same level except the current one
            function closeSiblingSubmenus(currentLi) {
                if (!currentLi) return;
                const parentUl = currentLi.parentElement;
                if (!parentUl) return;
                Array.from(parentUl.children).forEach(sibling => {
                    if (sibling !== currentLi && sibling.tagName === 'LI') {
                        sibling.classList.remove('active');
                        // Also close all nested submenus
                        sibling.querySelectorAll('li.active').forEach(nested => nested.classList.remove('active'));
                    }
                });
            }

            // Handle click events on menu items
            document.querySelectorAll('.sidebar-nav a').forEach(link => {
                link.addEventListener('click', function (e) {
                    const href = this.getAttribute('href');
                    if (href && href.startsWith('#')) {
                        // For dropdown arrows, toggle only this submenu, close siblings
                        const parentLi = this.closest('li');
                        if (parentLi) {
                            const isActive = parentLi.classList.contains('active');
                            closeSiblingSubmenus(parentLi);
                            if (!isActive) {
                                parentLi.classList.add('active');
                            } else {
                                parentLi.classList.remove('active');
                                // Also close all nested submenus
                                parentLi.querySelectorAll('li.active').forEach(nested => nested.classList.remove('active'));
                            }
                        }
                        e.preventDefault();
                    } else {
                        // For actual links, set the active state
                        setActiveMenu();
                    }
                });
            });

            // Initialize submenus based on active state (show only the active path)
            function showActiveSubmenus() {
                // Hide all submenus
                document.querySelectorAll('.sidebar-nav li > ul').forEach(ul => {
                    ul.style.display = 'none';
                });
                // Show only the submenus of active li's
                document.querySelectorAll('.sidebar-nav li.active > ul').forEach(ul => {
                    ul.style.display = 'block';
                });
            }

            // Initial show of active submenus
            showActiveSubmenus();

            // Also update submenu visibility on any click
            document.querySelectorAll('.sidebar-nav a').forEach(link => {
                link.addEventListener('click', function (e) {
                    setTimeout(showActiveSubmenus, 0);
                });
            });
        });
    </script>


    <script>
        document.addEventListener("DOMContentLoaded", () => {
            console.log("Page Loaded");

            const quickActionsLabel = document.getElementById('quickActionsLabel');
            const quickDropdownMenu = document.getElementById('quickDropdownMenu');

            const quickOptionsByTenant = {
                ltl: [
                    { text: 'Create New Order', icon: 'fa fa-plus-square', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/create-order' },
                    { text: 'Upload Bulk Orders', icon: 'fa fa-upload', iconStyle: 'color: #0e85ff; font-size: 10px;', path: '/bulk-upload' },
